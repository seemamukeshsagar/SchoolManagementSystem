  <DTS:Property DTS:Name="UIName">EmpMaster Data Import</DTS:Property>
  <DTS:Property DTS:Name="UIComment">Imports employee data from Excel to EmpMaster table using stored procedure</DTS:Property>
  
  <!-- Connection Managers -->
  <DTS:ConnectionManagers>
    <!-- Excel Connection Manager -->
    <DTS:ConnectionManager>
      <DTS:Property DTS:Name="DelayValidation">0</DTS:Property>
