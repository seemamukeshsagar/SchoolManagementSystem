@model Schoolortal.Entities.Models.SectionMaster
@{
    ViewData["Title"] = "Section Details";
}
<h2>Section Details</h2>
<div>
    <dl class="row">
        <dt class="col-sm-2">Name</dt>
        <dd class="col-sm-10">@Model.Name</dd>
        <dt class="col-sm-2">Is Active</dt>
        <dd class="col-sm-10">@Model.IsActive</dd>
        <dt class="col-sm-2">School Id</dt>
        <dd class="col-sm-10">@Model.SchoolId</dd>
    </dl>
</div>
<p>
    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Edit</a>
    <a asp-action="Index" class="btn btn-secondary">Back to List</a>
</p>
