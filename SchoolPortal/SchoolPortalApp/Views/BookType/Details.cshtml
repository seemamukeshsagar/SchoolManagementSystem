@model SchoolPortalApp.Models.BookTypeDetailsViewModel
@{ 
	ViewData["Title"] = "Book Type Details";
}
<h2>Book Type Details</h2>
<div class="mb-3">
	<strong>Name:</strong> @Model.Name
</div>
<div class="mb-3">
	<strong>Description:</strong> @Model.Description
</div>
<div class="mb-3">
	<strong>Active:</strong> @Model.IsActive
</div>

<p>
	<a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model.Id">Edit</a>
	<a class="btn btn-secondary" asp-action="Index">Back</a>
</p>
