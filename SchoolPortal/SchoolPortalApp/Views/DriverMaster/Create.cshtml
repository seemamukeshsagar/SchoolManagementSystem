@model SchoolPortalApp.Models.DriverAggregateViewModel
@{
	ViewData["Title"] = "Create Driver";
}
<h2>Create Driver</h2>
<form asp-action="Create" method="post" enctype="multipart/form-data">
	<input type="hidden" asp-for="Master.SchoolId" />

	<ul class="nav nav-tabs" role="tablist">
		<li class="nav-item"><a class="nav-link active" data-bs-toggle="tab" href="#tab-master" role="tab">Driver Master</a></li>
		<li class="nav-item"><a class="nav-link" data-bs-toggle="tab" href="#tab-docs" role="tab">Documents</a></li>
		<li class="nav-item"><a class="nav-link" data-bs-toggle="tab" href="#tab-quals" role="tab">Qualifications</a></li>
	</ul>

	<div class="tab-content border p-3 border-top-0">
		<div class="tab-pane fade show active" id="tab-master" role="tabpanel">
			<div class="form-group">
				<label asp-for="Master.FirstName"></label>
				<input asp-for="Master.FirstName" class="form-control" />
				<span asp-validation-for="Master.FirstName" class="text-danger"></span>
			</div>
			<div class="form-group">
				<label asp-for="Master.LastName"></label>
				<input asp-for="Master.LastName" class="form-control" />
			</div>
			<div class="form-group">
				<label asp-for="Master.DateOfBirth"></label>
				<input asp-for="Master.DateOfBirth" class="form-control" />
			</div>
			<div class="form-group">
				<label asp-for="Master.FathersName"></label>
				<input asp-for="Master.FathersName" class="form-control" />
			</div>
			<div class="form-group">
				<label asp-for="Master.MothersName"></label>
				<input asp-for="Master.MothersName" class="form-control" />
			</div>
			<div class="form-group">
				<label asp-for="Master.QualificationId"></label>
				<select asp-for="Master.QualificationId" asp-items="Model.QualificationItems" class="form-control"></select>
				<span asp-validation-for="Master.QualificationId" class="text-danger"></span>
			</div>
			<div class="form-group">
				<label asp-for="Master.Address1"></label>
				<input asp-for="Master.Address1" class="form-control" />
			</div>
			<div class="form-group">
				<label asp-for="Master.Address2"></label>
				<input asp-for="Master.Address2" class="form-control" />
			</div>
			<div class="form-group">
				<label asp-for="Master.CountryId"></label>
				<select asp-for="Master.CountryId" asp-items="Model.Countries" class="form-control" id="Master_CountryId"></select>
				<span asp-validation-for="Master.CountryId" class="text-danger"></span>
			</div>
			<div class="form-group">
				<label asp-for="Master.StateId"></label>
				<select asp-for="Master.StateId" asp-items="Model.States" class="form-control" id="Master_StateId" disabled></select>
				<span asp-validation-for="Master.StateId" class="text-danger"></span>
			</div>
			<div class="form-group">
				<label asp-for="Master.CityId"></label>
				<select asp-for="Master.CityId" asp-items="Model.Cities" class="form-control" id="Master_CityId" disabled></select>
				<span asp-validation-for="Master.CityId" class="text-danger"></span>
			</div>
			<div class="form-group">
				<label asp-for="Master.ZipCode"></label>
				<input asp-for="Master.ZipCode" class="form-control" />
			</div>
			<div class="form-group">
				<label asp-for="Master.MobileNumber"></label>
				<input asp-for="Master.MobileNumber" class="form-control" />
			</div>
			<div class="form-group">
				<label asp-for="Master.PhoneNumber"></label>
				<input asp-for="Master.PhoneNumber" class="form-control" />
			</div>
			<div class="form-group">
				<label asp-for="Master.DriverImage"></label>
				<input asp-for="Master.DriverImage" class="form-control" />
			</div>
			<div class="form-group">
				<label asp-for="Master.LicenceNumber"></label>
				<input asp-for="Master.LicenceNumber" class="form-control" />
			</div>
			<div class="form-group">
				<label asp-for="Master.LicenceIssueDate"></label>
				<input asp-for="Master.LicenceIssueDate" class="form-control" />
			</div>
			<div class="form-group">
				<label asp-for="Master.LicenceValidUptoDate"></label>
				<input asp-for="Master.LicenceValidUptoDate" class="form-control" />
			</div>
			<div class="form-group">
				<label asp-for="Master.LicenceDescription"></label>
				<input asp-for="Master.LicenceDescription" class="form-control" />
			</div>
			<div class="form-group">
				<label asp-for="Master.LicenceImage"></label>
				<input asp-for="Master.LicenceImage" class="form-control" />
			</div>
			<div class="form-group">
				<label asp-for="Master.LicenceType"></label>
				<input asp-for="Master.LicenceType" class="form-control" />
			</div>
			<div class="form-group form-check">
				<input class="form-check-input" asp-for="Master.IsActive" />
				<label class="form-check-label" asp-for="Master.IsActive"></label>
			</div>
			<div class="form-group form-check">
				<input class="form-check-input" asp-for="Master.IsDeleted" />
				<label class="form-check-label" asp-for="Master.IsDeleted"></label>
			</div>
		</div>

		<div class="tab-pane fade" id="tab-docs" role="tabpanel">
			<div class="mb-2">
				<button type="button" class="btn btn-sm btn-outline-primary" id="btnAddDoc">Add Document</button>
			</div>
			<table class="table table-bordered" id="tblDocs">
				<thead>
					<tr>
						<th>Name</th>
						<th>Description</th>
						<th>File</th>
						<th>Active</th>
						<th></th>
					</tr>
				</thead>
				<tbody></tbody>
			</table>
		</div>

		<div class="tab-pane fade" id="tab-quals" role="tabpanel">
			<div class="mb-2">
				<button type="button" class="btn btn-sm btn-outline-primary" id="btnAddQual">Add Qualification</button>
			</div>
			<table class="table table-bordered" id="tblQuals">
				<thead>
					<tr>
						<th>Qualification</th>
						<th>Active</th>
						<th></th>
					</tr>
				</thead>
				<tbody></tbody>
			</table>
			<select id="_qualTemplate" class="d-none">
				<option value="">-- Select Qualification --</option>
				@foreach (var opt in Model.QualificationItems ?? Enumerable.Empty<SelectListItem>())
				{
					<option value="@opt.Value">@opt.Text</option>
				}
			</select>
		</div>
	</div>

	<div class="mt-3">
		<button type="submit" class="btn btn-primary">Save</button>
		<a class="btn btn-secondary" asp-action="Index">Cancel</a>
	</div>
</form>
@section Scripts{
	<partial name="_ValidationScriptsPartial" />
	<script>
		(function () {
			const countryEl = document.getElementById('Master_CountryId');
			const stateEl = document.getElementById('Master_StateId');
			const cityEl = document.getElementById('Master_CityId');

			const statesUrl = '@Url.Action("GetStates", "DriverMaster")';
			const citiesUrl = '@Url.Action("GetCities", "DriverMaster")';

			function clearAndSet(el, items, selected) {
				while (el.options.length > 0) el.remove(0);
				const d = document.createElement('option');
				d.value = '';
				d.text = '-- Select --';
				el.add(d);
				(items || []).forEach(i => {
					const o = document.createElement('option');
					o.value = i.id;
					o.text = i.name;
					if (selected && String(selected).toLowerCase() === String(i.id).toLowerCase()) o.selected = true;
					el.add(o);
				});
			}

			countryEl && countryEl.addEventListener('change', async function () {
				const cid = this.value;
				clearAndSet(stateEl, []);
				clearAndSet(cityEl, []);
				if (!cid) return;
				const res = await fetch(`${statesUrl}?countryId=${cid}`);
				const data = await res.json();
				clearAndSet(stateEl, data);
			});

			stateEl && stateEl.addEventListener('change', async function () {
				const sid = this.value;
				clearAndSet(cityEl, []);
				if (!sid) return;
				const res = await fetch(`${citiesUrl}?stateId=${sid}`);
				const data = await res.json();
				clearAndSet(cityEl, data);
			});

			// Dynamic rows: Documents
			const tblDocsBody = document.querySelector('#tblDocs tbody');
			const btnAddDoc = document.getElementById('btnAddDoc');
			let docIndex = 0;
			btnAddDoc && btnAddDoc.addEventListener('click', function(){
				const tr = document.createElement('tr');
				tr.innerHTML = `
					<td><input name="Documents[${docIndex}].Name" class="form-control" /></td>
					<td><input name="Documents[${docIndex}].Description" class="form-control" /></td>
					<td><input type="file" name="DocumentFiles[${docIndex}]" class="form-control" /></td>
					<td class="text-center"><input type="checkbox" name="Documents[${docIndex}].IsActive" /></td>
					<input type="hidden" name="Documents[${docIndex}].IsDeleted" value="false" />
					<td class="text-center"><button type="button" class="btn btn-sm btn-outline-danger btn-remove">Remove</button></td>`;
				tblDocsBody.appendChild(tr);
				docIndex++;
			});
			tblDocsBody && tblDocsBody.addEventListener('click', function(e){
				if(e.target && e.target.classList.contains('btn-remove')){
					const tr = e.target.closest('tr');
					if(!tr) return;
					const del = tr.querySelector('input[type="hidden"][name$=".IsDeleted"]');
					if(del){ del.value = 'true'; tr.classList.add('d-none'); }
					else { tr.remove(); }
				}
			});

			// Dynamic rows: Qualifications
			const tblQualsBody = document.querySelector('#tblQuals tbody');
			const btnAddQual = document.getElementById('btnAddQual');
			const qualTemplate = document.getElementById('_qualTemplate');
			let qualIndex = 0;
			btnAddQual && btnAddQual.addEventListener('click', function(){
				const tr = document.createElement('tr');
				const selectHtml = `<select name="Qualifications[${qualIndex}].QualificationId" class="form-select">${qualTemplate ? qualTemplate.innerHTML : '<option value="">-- Select Qualification --</option>'}</select>`;
				tr.innerHTML = `
					<td>${selectHtml}</td>
					<td class="text-center"><input type="checkbox" name="Qualifications[${qualIndex}].IsActive" /></td>
					<input type="hidden" name="Qualifications[${qualIndex}].IsDeleted" value="false" />
					<td class="text-center"><button type="button" class="btn btn-sm btn-outline-danger btn-remove">Remove</button></td>`;
				tblQualsBody.appendChild(tr);
				qualIndex++;
			});
			tblQualsBody && tblQualsBody.addEventListener('click', function(e){
				if(e.target && e.target.classList.contains('btn-remove')){
					const tr = e.target.closest('tr');
					if(!tr) return;
					const del = tr.querySelector('input[type="hidden"][name$=".IsDeleted"]');
					if(del){ del.value = 'true'; tr.classList.add('d-none'); }
					else { tr.remove(); }
				}
			});
		})();
	</script>
}
