@* SchoolPortalApp/Views/NonTeaching/Delete.cshtml *@
@model SchoolPortal.Entities.Models.NonTeachingMaster

@{
    ViewData["Title"] = "Delete Non-Teaching Staff";
}

<div class="card">
    <div class="card-header bg-danger text-white">
        <h3 class="card-title">@ViewData["Title"]</h3>
    </div>
    <div class="card-body">
        <h4>Are you sure you want to delete this record?</h4>
        
        <div class="alert alert-warning">
            <h5>Warning!</h5>
            <p>Deleting this record will permanently remove all associated data. This action cannot be undone.</p>
        </div>

        <div class="row">
            <div class="col-md-6">
                <dl class="row">
                    <dt class="col-sm-4">Name</dt>
                    <dd class="col-sm-8">@($"{Model.FirstName} {Model.MiddleName} {Model.LastName}".Trim())</dd>

                    <dt class="col-sm-4">Employee Code</dt>
                    <dd class="col-sm-8">@Model.EmployeeCode</dd>

                    <dt class="col-sm-4">Designation</dt>
                    <dd class="col-sm-8">@Model.Designation</dd>

                    <dt class="col-sm-4">Department</dt>
                    <dd class="col-sm-8">@Model.Department</dd>

                    <dt class="col-sm-4">Email</dt>
                    <dd class="col-sm-8">@Model.Email</dd>

                    <dt class="col-sm-4">Phone</dt>
                    <dd class="col-sm-8">@Model.Phone</dd>

                    <dt class="col-sm-4">Status</dt>
                    <dd class="col-sm-8">
                        @if (Model.IsActive)
                        {
                            <span class="badge badge-success">Active</span>
                        }
                        else
                        {
                            <span class="badge badge-danger">Inactive</span>
                        }
                    </dd>
                </dl>
            </div>
        </div>

        <form asp-action="Delete" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />
            
            <div class="form-group">
                <label for="deleteReason" class="control-label">Reason for Deletion</label>
                <textarea id="deleteReason" name="deleteReason" class="form-control" rows="3" required></textarea>
                <small class="form-text text-muted">Please provide a reason for deleting this record.</small>
            </div>

            <div class="form-group mt-4">
                <button type="submit" class="btn btn-danger">
                    <i class="fas fa-trash"></i> Delete
                </button>
                <a asp-action="Index" class="btn btn-secondary">
                    <i class="fas fa-arrow-left"></i> Back to List
                </a>
            </div>
        </form>
    </div>
</div>