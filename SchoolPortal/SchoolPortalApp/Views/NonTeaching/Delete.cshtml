@* SchoolPortal.Web/Views/NonTeaching/Delete.cshtml *@
@model SchoolPortal.Entities.Models.NonTeachingMaster

@{
    ViewData["Title"] = "Delete Staff Member";
}

<div class="card">
    <div class="card-header bg-danger text-white">
        <h4>@ViewData["Title"]</h4>
    </div>
    <div class="card-body">
        <h5>Are you sure you want to delete this staff member?</h5>
        <div class="alert alert-warning">
            <strong>Warning:</strong> This action cannot be undone. All related data will also be removed.
        </div>
        
        <div class="row">
            <div class="col-md-6">
                <h5>Staff Details</h5>
                <hr />
                <dl class="row">
                    <dt class="col-sm-4">Name</dt>
                    <dd class="col-sm-8">@($"{Model.FirstName} {Model.LastName}")</dd>

                    <dt class="col-sm-4">Employee Code</dt>
                    <dd class="col-sm-8">@Model.EmployeeCode</dd>

                    <dt class="col-sm-4">Designation</dt>
                    <dd class="col-sm-8">@Model.Designation</dd>

                    <dt class="col-sm-4">Department</dt>
                    <dd class="col-sm-8">@Model.Department</dd>
                </dl>
            </div>
        </div>

        <form asp-action="Delete" method="post">
            <input type="hidden" asp-for="Id" />
            <div class="form-group mt-4">
                <button type="submit" class="btn btn-danger">Delete</button>
                <a asp-action="Index" class="btn btn-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>