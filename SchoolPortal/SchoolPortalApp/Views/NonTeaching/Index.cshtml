@* SchoolPortal.Web/Views/NonTeaching/Index.cshtml *@
@model IEnumerable<SchoolPortal.Entities.Models.NonTeachingMaster>

@{
    ViewData["Title"] = "Non-Teaching Staff";
}

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h4>Non-Teaching Staff</h4>
        <a asp-action="Create" class="btn btn-primary">Add New Staff</a>
    </div>
    <div class="card-body">
        <table class="table table-striped table-bordered" id="nonTeachingTable">
            <thead>
                <tr>
                    <th>Employee Code</th>
                    <th>Name</th>
                    <th>Designation</th>
                    <th>Department</th>
                    <th>Email</th>
                    <th>Phone</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.EmployeeCode</td>
                        <td>@($"{item.FirstName} {item.LastName}")</td>
                        <td>@item.Designation</td>
                        <td>@item.Department</td>
                        <td>@item.Email</td>
                        <td>@item.MobilePhone</td>
                        <td>
                            @if (item.IsActive)
                            {
                                <span class="badge bg-success">Active</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">Inactive</span>
                            }
                        </td>
                        <td>
                            <div class="btn-group" role="group">
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-info btn-sm">Details</a>
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning btn-sm">Edit</a>
                                <form asp-action="Delete" method="post" onsubmit="return confirm('Are you sure you want to delete this staff member?');">
                                    <input type="hidden" name="id" value="@item.Id" />
                                    <button type="submit" class="btn btn-danger btn-sm">Delete</button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#nonTeachingTable').DataTable({
                responsive: true,
                order: [[1, 'asc']]
            });
        });
    </script>
}