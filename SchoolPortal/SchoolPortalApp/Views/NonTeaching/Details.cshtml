@* SchoolPortal.Web/Views/NonTeaching/Details.cshtml *@
@model SchoolPortal.Entities.Models.NonTeachingMaster

@{
    ViewData["Title"] = "Staff Details";
}

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h4>@ViewData["Title"]</h4>
        <div>
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Edit</a>
            <a asp-action="Index" class="btn btn-secondary">Back to List</a>
        </div>
    </div>
    <div class="card-body">
        <div class="row">
            <div class="col-md-3 text-center">
                @if (Model.Image != null)
                {
                    <img src="data:image/jpeg;base64,@Convert.ToBase64String(Model.Image)" 
                         class="img-thumbnail mb-3" style="max-width: 200px;" alt="Profile Image" />
                }
                else
                {
                    <div class="bg-light p-5 text-center mb-3">
                        <i class="fas fa-user fa-5x text-muted"></i>
                    </div>
                }
                <h4>@($"{Model.FirstName} {Model.LastName}")</h4>
                <p class="text-muted">@Model.Designation</p>
                <p>
                    @if (Model.IsActive)
                    {
                        <span class="badge bg-success">Active</span>
                    }
                    else
                    {
                        <span class="badge bg-danger">Inactive</span>
                    }
                </p>
            </div>
            <div class="col-md-9">
                <div class="row">
                    <div class="col-md-6">
                        <h5>Personal Information</h5>
                        <hr />
                        <dl class="row">
                            <dt class="col-sm-4">Employee Code</dt>
                            <dd class="col-sm-8">@Model.EmployeeCode</dd>

                            <dt class="col-sm-4">Date of Birth</dt>
                            <dd class="col-sm-8">@Model.DOB.ToString()</dd>

                            <dt class="col-sm-4">Gender</dt>
                            <dd class="col-sm-8">@Model.Gender</dd>

                            <dt class="col-sm-4">Email</dt>
                            <dd class="col-sm-8">@Model.Email</dd>

                            <dt class="col-sm-4">Phone</dt>
                            <dd class="col-sm-8">@Model.Phone</dd>

                            <dt class="col-sm-4">Mobile</dt>
                            <dd class="col-sm-8">@Model.MobilePhone</dd>
                        </dl>
                    </div>
                    <div class="col-md-6">
                        <h5>Employment Details</h5>
                        <hr />
                        <dl class="row">
                            <dt class="col-sm-4">Department</dt>
                            <dd class="col-sm-8">@Model.Department</dd>

                            <dt class="col-sm-4">Date of Joining</dt>
                            <dd class="col-sm-8">@Model.DOJ.ToString()</dd>

                            <dt class="col-sm-4">Date of Leaving</dt>
                            <dd class="col-sm-8">@(Model.DateOfLeaving?.ToString("dd/MM/yyyy") ?? "N/A")</dd>

                            <dt class="col-sm-4">Qualification</dt>
                            <dd class="col-sm-8">@Model.Qualification</dd>

                            <dt class="col-sm-4">Salary</dt>
                            <dd class="col-sm-8">@(Model.Salary?.ToString("C") ?? "N/A")</dd>
                        </dl>
                    </div>
                </div>

                <div class="row mt-4">
                    <div class="col-12">
                        <h5>Documents</h5>
                        <hr />
                        @if (Model.Documents != null && Model.Documents.Any())
                        {
                            <div class="table-responsive">
                                <table class="table table-sm">
                                    <thead>
                                        <tr>
                                            <th>Document Type</th>
                                            <th>Document Number</th>
                                            <th>Issue Date</th>
                                            <th>Expiry Date</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var doc in Model.Documents)
                                        {
                                            <tr>
                                                <td>@doc.DocumentType</td>
                                                <td>@doc.DocumentNumber</td>
                                                <td>@doc.IssueDate.ToString()</td>
                                                <td>@doc.ExpiryDate?.ToString()</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        else
                        {
                            <p>No documents found.</p>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>