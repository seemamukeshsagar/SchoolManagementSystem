@* SchoolPortal.Web/Views/NonTeaching/Documents.cshtml *@
@model SchoolPortal.Web.Models.NonTeaching.NonTeachingViewModel

@{
    ViewData["Title"] = "Manage Documents";
}

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h4>@ViewData["Title"] - @($"{Model.FirstName} {Model.LastName}")</h4>
        <div>
            <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#addDocumentModal">
                <i class="fas fa-plus"></i> Add Document
            </button>
            <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-secondary">Back to Details</a>
        </div>
    </div>
    <div class="card-body">
        @if (Model.Documents != null && Model.Documents.Any())
        {
            <div class="table-responsive">
                <table class="table table-striped">
                    <thead>
                        <tr>
                            <th>Document Type</th>
                            <th>Document Number</th>
                            <th>Issue Date</th>
                            <th>Expiry Date</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var doc in Model.Documents)
                        {
                            <tr>
                                <td>@doc.DocumentType</td>
                                <td>@doc.DocumentNumber</td>
                                <td>@doc.IssueDate.ToString()</td>
                                <td>@(doc.ExpiryDate?.ToString("dd/MM/yyyy") ?? "N/A")</td>
                                <td>
                                    <a href="#" class="btn btn-sm btn-info" title="View Document">
                                        <i class="fas fa-eye"></i>
                                    </a>
                                    <a href="#" class="btn btn-sm btn-warning" title="Edit Document">
                                        <i class="fas fa-edit"></i>
                                    </a>
                                    <form asp-action="DeleteDocument" method="post" style="display: inline;">
                                        <input type="hidden" name="id" value="@doc.Id" />
                                        <button type="submit" class="btn btn-sm btn-danger" title="Delete Document" 
                                                onclick="return confirm('Are you sure you want to delete this document?');">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="alert alert-info">
                No documents found for this staff member.
            </div>
        }
    </div>
</div>

<!-- Add Document Modal -->
<div class="modal fade" id="addDocumentModal" tabindex="-1" aria-labelledby="addDocumentModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="addDocumentModalLabel">Add New Document</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="AddDocument" method="post" enctype="multipart/form-data">
                <div class="modal-body">
                    <input type="hidden" name="nonTeachingId" value="@Model.Id" />
                    
                    <div class="form-group mb-3">
                        <label class="form-label">Document Type</label>
                        <select name="documentType" class="form-select" required>
                            <option value="">-- Select Document Type --</option>
                            <option value="Aadhar Card">Aadhar Card</option>
                            <option value="PAN Card">PAN Card</option>
                            <option value="Passport">Passport</option>
                            <option value="Driving License">Driving License</option>
                            <option value="Voter ID">Voter ID</option>
                            <option value="Resume">Resume</option>
                            <option value="Experience Certificate">Experience Certificate</option>
                            <option value="Qualification Certificate">Qualification Certificate</option>
                            <option value="Other">Other</option>
                        </select>
                    </div>
                    
                    <div class="form-group mb-3">
                        <label class="form-label">Document Number</label>
                        <input type="text" name="documentNumber" class="form-control" required />
                    </div>
                    
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label class="form-label">Issue Date</label>
                                <input type="date" name="issueDate" class="form-control" required />
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label class="form-label">Expiry Date (if any)</label>
                                <input type="date" name="expiryDate" class="form-control" />
                            </div>
                        </div>
                    </div>
                    
                    <div class="form-group mb-3">
                        <label class="form-label">Upload Document</label>
                        <input type="file" name="documentFile" class="form-control" required accept=".pdf,.jpg,.jpeg,.png" />
                        <small class="form-text text-muted">Accepted formats: PDF, JPG, PNG (Max: 5MB)</small>
                    </div>
                    
                    <div class="form-group mb-3">
                        <label class="form-label">Description (Optional)</label>
                        <textarea name="description" class="form-control" rows="2"></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Upload Document</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Initialize tooltips
        var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
        var tooltipList = tooltipTriggerList.map(function (tooltipTriggerEl) {
            return new bootstrap.Tooltip(tooltipTriggerEl);
        });
    </script>
}