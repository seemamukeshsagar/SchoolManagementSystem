@* SchoolPortalApp/Views/NonTeaching/Edit.cshtml *@
@model SchoolPortal.Entities.Models.NonTeachingMaster

@{
    ViewData["Title"] = "Edit Non-Teaching Staff";
}

<div class="card">
    <div class="card-header">
        <h3 class="card-title">@ViewData["Title"]</h3>
    </div>
    <div class="card-body">
        <form asp-action="Edit" enctype="multipart/form-data" id="nonTeachingForm">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />
            
            @if (ViewData.ModelState.ErrorCount > 0)
            {
                <div class="alert alert-danger">
                    <h5>Please correct the following errors:</h5>
                    <div asp-validation-summary="All" class="text-danger"></div>
                </div>
            }

            <!-- Same form fields as Create.cshtml, but with values populated from the model -->
            <div class="row">
                <div class="col-md-6">
                    <div class="form-group">
                        <label asp-for="EmployeeCode" class="control-label"></label>
                        <input asp-for="EmployeeCode" class="form-control" />
                        <span asp-validation-for="EmployeeCode" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label asp-for="Salutation" class="control-label"></label>
                        <select asp-for="Salutation" class="form-control">
                            <option value="">-- Select --</option>
                            <option value="Mr.">Mr.</option>
                            <option value="Mrs.">Mrs.</option>
                            <option value="Ms.">Ms.</option>
                            <option value="Dr.">Dr.</option>
                            <option value="Prof.">Prof.</option>
                        </select>
                        <span asp-validation-for="Salutation" class="text-danger"></span>
                    </div>
                </div>
            </div>

            <!-- Include all other fields from Create.cshtml, but with values populated from the model -->
            <!-- ... (similar to Create.cshtml but with model values) ... -->

            <div class="form-group mt-4">
                <button type="submit" class="btn btn-primary">
                    <i class="fas fa-save"></i> Update
                </button>
                <a asp-action="Index" class="btn btn-secondary">
                    <i class="fas fa-arrow-left"></i> Back to List
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        // Similar JavaScript as in Create.cshtml for form validation and dynamic dropdowns
        // ... (same as Create.cshtml) ...
    </script>
}