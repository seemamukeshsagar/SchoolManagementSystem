@model SchoolPortal.Entities.Models.TimeTableClassPeriodDetails

@{
    ViewData["Title"] = "Delete Timetable Period";
}

<h2>Delete Timetable Period</h2>

<h3>Are you sure you want to delete this?</h3>
<div>
    <h4>Timetable Period Details</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-3">Class</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.ClassId)</dd>

        <dt class="col-sm-3">Section</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.SectionId)</dd>

        <dt class="col-sm-3">Subject</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.SubjectId)</dd>

        <dt class="col-sm-3">Period</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.PeriodId)</dd>

        <dt class="col-sm-3">Day of Week</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.DayOfWeek)</dd>

        <dt class="col-sm-3">Status</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.Status)</dd>
    </dl>

    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <div class="form-group">
            <input type="submit" value="Delete" class="btn btn-danger" />
            <a asp-action="Index" class="btn btn-secondary">Back to List</a>
        </div>
    </form>
</div>