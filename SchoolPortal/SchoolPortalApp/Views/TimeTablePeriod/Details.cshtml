@model SchoolPortal.Entities.Models.TimeTableClassPeriodDetails

@{
    ViewData["Title"] = "Timetable Period Details";
}

<h2>Timetable Period Details</h2>

<div>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">Class</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.ClassId)</dd>

        <dt class="col-sm-2">Section</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.SectionId)</dd>

        <dt class="col-sm-2">Subject</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.SubjectId)</dd>

        <dt class="col-sm-2">Period</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.PeriodId)</dd>

        <dt class="col-sm-2">Day of Week</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.DayOfWeek)</dd>

        <dt class="col-sm-2">Session</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.SessionId)</dd>

        <dt class="col-sm-2">Status</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Status)</dd>

        <dt class="col-sm-2">Active</dt>
        <dd class="col-sm-10">@(Model.IsActive ? "Yes" : "No")</dd>
    </dl>
</div>
<div>
    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Edit</a>
    <a asp-action="Index" class="btn btn-secondary">Back to List</a>
</div>