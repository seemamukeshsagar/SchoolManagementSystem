@model SchoolPortalApp.Models.RoleMasterDetailsViewModel

@{
	ViewData["Title"] = "Delete Role";
}

<div class="card">
	<div class="card-header bg-danger text-white">
		<h3 class="card-title">Confirm Delete</h3>
	</div>
	<div class="card-body">
		<h4>Are you sure you want to delete this role?</h4>
		<div class="alert alert-warning">
			<strong>Warning:</strong> This action cannot be undone.
		</div>
		
		<dl class="row">
			<dt class="col-sm-3">@Html.DisplayNameFor(model => model.RoleName)</dt>
			<dd class="col-sm-9">@Model.RoleName</dd>

			<dt class="col-sm-3">@Html.DisplayNameFor(model => model.Description)</dt>
			<dd class="col-sm-9">@(string.IsNullOrEmpty(Model.Description) ? "N/A" : Model.Description)</dd>

			<dt class="col-sm-3">Status</dt>
			<dd class="col-sm-9">
				<span class="badge @(Model.IsActive ? "badge-success" : "badge-danger")">
					@Model.Status
				</span>
			</dd>
		</dl>
	</div>
	<div class="card-footer">
		<form asp-action="Delete" method="post">
			<input type="hidden" asp-for="Id" />
			<button type="submit" class="btn btn-danger">
				<i class="fas fa-trash"></i> Delete
			</button>
			<a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-secondary">
				<i class="fas fa-times"></i> Cancel
			</a>
		</form>
	</div>
</div>