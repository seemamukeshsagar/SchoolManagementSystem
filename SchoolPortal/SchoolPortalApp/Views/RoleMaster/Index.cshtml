@{
	ViewData["Title"] = "Roles";
}

<div class="card">
	<div class="card-header">
		@* <h3 class="card-title">Roles</h3> *@
		<div class="card-header d-flex justify-content-between align-items-center">
			<h4 class="mb-0">Roles</h4>
			<a asp-action="Create" class="btn btn-primary">
				<i class="bi bi-plus-circle me-2"></i>Add New Role
			</a>
		</div>
	</div>
	<div class="card-body">
		<table id="rolesTable" class="table table-bordered table-striped">
			<thead>
				<tr>
					<th>Name</th>
					<th>Description</th>
					<th>Status</th>
					<th>Actions</th>
				</tr>
			</thead>
			<tbody>
				<!-- Data will be loaded via AJAX -->
			</tbody>
		</table>
	</div>
</div>

@section Styles {
	<link rel="stylesheet" href="https://cdn.datatables.net/1.11.5/css/dataTables.bootstrap5.min.css" />
	<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.8.1/font/bootstrap-icons.css">
	<style>
		.modal-body {
			max-height: 60vh;
			overflow-y: auto;
		}
		.spinner-border {
			width: 3rem;
			height: 3rem;
		}
		a {
			color: #0d6efd;
			text-decoration: none;
			cursor: pointer;
		}
		a:hover {
			text-decoration: underline;
		}
	</style>
}

<!-- Privileges Modal -->
<div class="modal fade" id="privilegesModal" tabindex="-1" aria-labelledby="privilegesModalLabel" aria-hidden="true">
	<div class="modal-dialog modal-lg">
		<div class="modal-content">
			<div class="modal-header">
				<h5 class="modal-title" id="privilegesModalLabel">Role Privileges</h5>
				<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
			</div>
			<div class="modal-body" id="privilegesContent">
				<div class="text-center">
					<div class="spinner-border" role="status">
						<span class="visually-hidden">Loading...</span>
					</div>
					<p>Loading privileges...</p>
				</div>
			</div>
			<div class="modal-footer">
				<button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
			</div>
		</div>
	</div>
</div>

@section Scripts {
	<!-- Add Bootstrap JS bundle (includes Modal) -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.datatables.net/1.11.5/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.11.5/js/dataTables.bootstrap5.min.js"></script>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
	
	<script>
        // Make sure the function is in the global scope
        window.showPrivileges = function(roleId, roleName) {
            console.log('showPrivileges called with:', { roleId, roleName }); // Debug log
            
            var modal = new bootstrap.Modal(document.getElementById('privilegesModal'));
            $('#privilegesModalLabel').text('Privileges for ' + roleName);
            
            // Show loading state
            $('#privilegesContent').html(`
                <div class="text-center">
                    <div class="spinner-border" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                    <p>Loading privileges...</p>
                </div>
            `);
            
            // Show modal first
            modal.show();
            
            // Fetch privileges
            $.ajax({
                url: '@Url.Action("GetRolePrivileges", "RoleMaster")',
                type: 'GET',
                data: { roleId: roleId },
                dataType: 'json',
                success: function(response) {
                    console.log('Privileges response:', response); // Debug log
                    
                    if (response && response.success) {
                        var html = '<div class="table-responsive"><table class="table table-striped">';
                        html += '<thead><tr><th>Privilege Name</th><th>Description</th></tr></thead><tbody>';
                        
                        if (response.data && response.data.length > 0) {
                            response.data.forEach(function(priv) {
                                html += `<tr><td>${escapeHtml(priv.name || '')}</td><td>${escapeHtml(priv.description || '')}</td></tr>`;
                            });
                        } else {
                            html += '<tr><td colspan="2" class="text-center">No privileges assigned to this role.</td></tr>';
                        }
                        
                        html += '</tbody></table></div>';
                        $('#privilegesContent').html(html);
                    } else {
                        var errorMsg = (response && response.message) ? response.message : 'Unknown error occurred';
                        console.error('Error loading privileges:', errorMsg);
                        showError('Error loading privileges: ' + errorMsg);
                    }
                },
                error: function(xhr, status, error) {
                    console.error('AJAX error:', status, error);
                    showError('Failed to load privileges. Please try again later.');
                }
            });
        };
        // Helper function to escape HTML
        function escapeHtml(unsafe) {
            return unsafe
                .replace(/&/g, "&amp;")
                .replace(/</g, "&lt;")
                .replace(/>/g, "&gt;")
                .replace(/"/g, "&quot;")
                .replace(/'/g, "&#039;");
        }
        // Helper function to show error messages
        function showError(message) {
            $('#privilegesContent').html(
                '<div class="alert alert-danger">' + 
                '<i class="bi bi-exclamation-triangle-fill me-2"></i>' + 
                message + 
                '</div>'
            );
        }
		
		$(document).ready(function () {
			$('#rolesTable').DataTable({
				processing: true,
				serverSide: true,
				ajax: {
					url: '@Url.Action("GetRoles", "RoleMaster")',
					type: 'POST',
					data: function (d) {
						// Add any additional parameters here
					}
				},
				columns: [
					{ data: 'name', name: 'Name',
						render: function(data, type, row) {
							return data ? `<a href="javascript:void(0);" onclick="showPrivileges('${row.id}', '${data.replace(/'/g, "\\'")}')">${data}</a>` : '';
						}
					},
					{ 
						data: 'description', 
						name: 'Description',
						render: function(data, type, row) {
							return data || '-';
						}
					},
					{ 
						data: 'isActive',
						name: 'IsActive',
						render: function(data, type, row) {
							return data 
								? '<span class="badge bg-success">Active</span>'
								: '<span class="badge bg-danger">Inactive</span>';
						}
					},
					{
						data: 'id',
						name: 'Actions',
						orderable: false,
						render: function(data, type, row) {
							return `
								<div class="btn-group btn-group-sm">
									<a href="/RoleMaster/Details/${data}" class="btn btn-info" title="View Details">
										<i class="bi bi-eye"></i>
									</a>
									<a href="/RoleMaster/Edit/${data}" class="btn btn-warning" title="Edit">
										<i class="bi bi-pencil"></i>
									</a>
									<a href="/RoleMaster/Delete/${data}" class="btn btn-danger" title="Delete">
										<i class="bi bi-trash"></i>
									</a>
								</div>`;
						}
					}
				],
				order: [[0, 'asc']],
				responsive: true,
				pageLength: 10,
				lengthMenu: [10, 25, 50, 100]
			});
		});
	</script>
}