@{
	ViewData["Title"] = "Roles";
}

<div class="card">
	<div class="card-header">
		@* <h3 class="card-title">Roles</h3> *@
		<div class="card-header d-flex justify-content-between align-items-center">
			<h4 class="mb-0">Roles</h4>
			<a asp-action="Create" class="btn btn-primary">
				<i class="bi bi-plus-circle me-2"></i>Add New Role
			</a>
		</div>
	</div>
	<div class="card-body">
		<table id="rolesTable" class="table table-bordered table-striped">
			<thead>
				<tr>
					<th>Name</th>
					<th>Description</th>
					<th>Status</th>
					<th>Actions</th>
				</tr>
			</thead>
			<tbody>
				<!-- Data will be loaded via AJAX -->
			</tbody>
		</table>
	</div>
</div>

@section Styles {
	<link rel="stylesheet" href="https://cdn.datatables.net/1.11.5/css/dataTables.bootstrap5.min.css" />
	<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.8.1/font/bootstrap-icons.css">
	<style>
		.modal-body {
			max-height: 60vh;
			overflow-y: auto;
		}
		.spinner-border {
			width: 3rem;
			height: 3rem;
		}
		a {
			color: #0d6efd;
			text-decoration: none;
			cursor: pointer;
		}
		a:hover {
			text-decoration: underline;
		}
	</style>
}

<!-- Privileges Modal -->
<div class="modal fade" id="privilegesModal" tabindex="-1" aria-labelledby="privilegesModalLabel" aria-hidden="true">
	<div class="modal-dialog modal-lg">
		<div class="modal-content">
			<div class="modal-header">
				<h5 class="modal-title" id="privilegesModalLabel">Role Privileges</h5>
				<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
			</div>
			<div class="modal-body" id="privilegesContent">
				<div class="text-center">
					<div class="spinner-border" role="status">
						<span class="visually-hidden">Loading...</span>
					</div>
					<p>Loading privileges...</p>
				</div>
			</div>
			<div class="modal-footer">
				<button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
			</div>
		</div>
	</div>
</div>

@section Scripts {
	<script src="https://cdn.datatables.net/1.11.5/js/jquery.dataTables.min.js"></script>
	<script src="https://cdn.datatables.net/1.11.5/js/dataTables.bootstrap5.min.js"></script>
	
	<script>
		function showPrivileges(roleId, roleName) {
			$('#privilegesModalLabel').text('Privileges for ' + roleName);
			var modal = new bootstrap.Modal(document.getElementById('privilegesModal'));
			
			// Show loading state
			$('#privilegesContent').html(`
				<div class="text-center">
					<div class="spinner-border" role="status">
						<span class="visually-hidden">Loading...</span>
					</div>
					<p>Loading privileges...</p>
				</div>
			`);
			
			// Show modal
			modal.show();
			
			// Fetch privileges
			$.get('@Url.Action("GetRolePrivileges", "RoleMaster")', { roleId: roleId })
				.done(function(response) {
					if (response.success && response.data) {
						var html = '<div class="table-responsive"><table class="table table-striped">';
						html += '<thead><tr><th>Privilege Name</th><th>Description</th></tr></thead><tbody>';
						
						if (response.data.length > 0) {
							response.data.forEach(function(priv) {
								html += `<tr><td>${priv.name || ''}</td><td>${priv.description || ''}</td></tr>`;
							});
						} else {
							html += '<tr><td colspan="2" class="text-center">No privileges assigned to this role.</td></tr>';
						}
						
						html += '</tbody></table></div>';
						$('#privilegesContent').html(html);
					} else {
						$('#privilegesContent').html('<div class="alert alert-danger">Error loading privileges. ' + (response.message || '') + '</div>');
					}
				})
				.fail(function() {
					$('#privilegesContent').html('<div class="alert alert-danger">Failed to load privileges. Please try again.</div>');
				});
		}

		$(document).ready(function () {
			$('#rolesTable').DataTable({
				processing: true,
				serverSide: true,
				ajax: {
					url: '@Url.Action("GetRoles", "RoleMaster")',
					type: 'POST',
					data: function (d) {
						// Add any additional parameters here
					}
				},
				columns: [
					{ data: 'name', name: 'Name',
						render: function(data, type, row) {
							return data ? `<a href="javascript:void(0);" onclick="showPrivileges('${row.id}', '${data.replace(/'/g, "\\'")}')">${data}</a>` : '';
						}
					},
					{ 
						data: 'description', 
						name: 'Description',
						render: function(data, type, row) {
							return data || '-';
						}
					},
					{ 
						data: 'isActive',
						name: 'IsActive',
						render: function(data, type, row) {
							return data 
								? '<span class="badge bg-success">Active</span>'
								: '<span class="badge bg-danger">Inactive</span>';
						}
					},
					{
						data: 'id',
						name: 'Actions',
						orderable: false,
						render: function(data, type, row) {
							return `
								<div class="btn-group btn-group-sm">
									<a href="/RoleMaster/Details/${data}" class="btn btn-info" title="View Details">
										<i class="bi bi-eye"></i>
									</a>
									<a href="/RoleMaster/Edit/${data}" class="btn btn-warning" title="Edit">
										<i class="bi bi-pencil"></i>
									</a>
									<a href="/RoleMaster/Delete/${data}" class="btn btn-danger" title="Delete">
										<i class="bi bi-trash"></i>
									</a>
								</div>`;
						}
					}
				],
				order: [[0, 'asc']],
				responsive: true,
				pageLength: 10,
				lengthMenu: [10, 25, 50, 100]
			});
		});
	</script>
}