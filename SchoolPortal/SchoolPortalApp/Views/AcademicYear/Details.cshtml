@model SchoolPortalApp.Models.AcademicYearViewModel

@{
    ViewData["Title"] = "Academic Year Details";
    var successMessage = TempData["SuccessMessage"] as string;
    var errorMessage = TempData["ErrorMessage"] as string;
}

<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">Academic Year Details</h3>
                <div class="card-tools">
                    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary btn-sm">
                        <i class="fas fa-edit"></i> Edit
                    </a>
                    <a asp-action="Index" class="btn btn-default btn-sm">
                        <i class="fas fa-arrow-left"></i> Back to List
                    </a>
                </div>
            </div>
            <div class="card-body">
                @if (!string.IsNullOrEmpty(successMessage))
                {
                    <div class="alert alert-success alert-dismissible">
                        <button type="button" class="close" data-dismiss="alert" aria-hidden="true">×</button>
                        @successMessage
                    </div>
                }
                @if (!string.IsNullOrEmpty(errorMessage))
                {
                    <div class="alert alert-danger alert-dismissible">
                        <button type="button" class="close" data-dismiss="alert" aria-hidden="true">×</button>
                        @errorMessage
                    </div>
                }
                <dl class="row">
                    <dt class="col-sm-3">@Html.DisplayNameFor(model => model.AcademicYearName)</dt>
                    <dd class="col-sm-9">@Html.DisplayFor(model => model.AcademicYearName)</dd>

                    <dt class="col-sm-3">@Html.DisplayNameFor(model => model.StartDate)</dt>
                    <dd class="col-sm-9">@Model.StartDate.ToString("dd MMM yyyy")</dd>

                    <dt class="col-sm-3">@Html.DisplayNameFor(model => model.EndDate)</dt>
                    <dd class="col-sm-9">@Model.EndDate.ToString("dd MMM yyyy")</dd>

                    <dt class="col-sm-3">@Html.DisplayNameFor(model => model.IsCurrent)</dt>
                    <dd class="col-sm-9">
                        @if (Model.IsCurrent)
                        {
                            <span class="badge bg-success">Current Academic Year</span>
                        }
                        else
                        {
                            <span class="text-muted">Not Current</span>
                        }
                    </dd>

                    <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Status)</dt>
                    <dd class="col-sm-9">
                        @if (Model.IsActive)
                        {
                            <span class="badge bg-success">@Model.Status</span>
                        }
                        else
                        {
                            <span class="badge bg-danger">@Model.Status</span>
                        }
                    </dd>
                </dl>
            </div>
            <div class="card-footer">
                <form asp-action="Delete" method="post" onsubmit="return confirm('Are you sure you want to delete this academic year?');">
                    <input type="hidden" name="id" value="@Model.Id" />
                    <button type="submit" class="btn btn-danger">
                        <i class="fas fa-trash"></i> Delete
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            // Any additional scripts for the details view
        });
    </script>
}