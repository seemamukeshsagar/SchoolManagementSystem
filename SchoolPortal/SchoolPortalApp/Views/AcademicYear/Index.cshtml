@model IEnumerable<SchoolPortal.Entities.Models.AcademicYear>

@{
    ViewData["Title"] = "Academic Years";
    var successMessage = TempData["SuccessMessage"] as string;
    var errorMessage = TempData["ErrorMessage"] as string;
}

<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">Academic Years</h3>
                <div class="card-tools">
                    <a asp-action="Create" class="btn btn-primary btn-sm">
                        <i class="fas fa-plus"></i> Add New
                    </a>
                </div>
            </div>
            <div class="card-body">
                @if (!string.IsNullOrEmpty(successMessage))
                {
                    <div class="alert alert-success alert-dismissible">
                        <button type="button" class="close" data-dismiss="alert" aria-hidden="true">×</button>
                        @successMessage
                    </div>
                }
                @if (!string.IsNullOrEmpty(errorMessage))
                {
                    <div class="alert alert-danger alert-dismissible">
                        <button type="button" class="close" data-dismiss="alert" aria-hidden="true">×</button>
                        @errorMessage
                    </div>
                }
                <table id="academicYearsTable" class="table table-bordered table-striped">
                    <thead>
                        <tr>
                            <th>@Html.DisplayNameFor(model => model.AcademicYearName)</th>
                            <th>@Html.DisplayNameFor(model => model.StartDate)</th>
                            <th>@Html.DisplayNameFor(model => model.EndDate)</th>
                            <th>@Html.DisplayNameFor(model => model.IsCurrent)</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@Html.DisplayFor(modelItem => item.AcademicYearName)</td>
                                <td>@item.StartDate.ToString("dd MMM yyyy")</td>
                                <td>@item.EndDate.ToString("dd MMM yyyy")</td>
                                <td>
                                    @if (item.IsCurrent)
                                    {
                                        <span class="badge bg-success">Current</span>
                                    }
                                    else
                                    {
                                        <a href="#" class="btn-set-current" data-id="@item.Id">Set as Current</a>
                                    }
                                </td>
                                <td>
                                    <div class="custom-control custom-switch">
                                        <input type="checkbox" class="custom-control-input toggle-status" 
                                               id="status-@item.Id" @(item.IsActive ? "checked" : "") 
                                               data-id="@item.Id">
                                        <label class="custom-control-label" for="status-@item.Id">
                                            @(item.IsActive ? "Active" : "Inactive")
                                        </label>
                                    </div>
                                </td>
                                <td>
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-primary">
                                        <i class="fas fa-edit"></i> Edit
                                    </a>
                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info">
                                        <i class="fas fa-eye"></i> Details
                                    </a>
                                    <form asp-action="Delete" method="post" class="d-inline" 
                                          onsubmit="return confirm('Are you sure you want to delete this academic year?');">
                                        <input type="hidden" name="id" value="@item.Id" />
                                        <button type="submit" class="btn btn-sm btn-danger">
                                            <i class="fas fa-trash"></i> Delete
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            $('#academicYearsTable').DataTable({
                "responsive": true,
                "autoWidth": false,
                "order": [[1, "desc"]] // Sort by start date by default
            });

            // Toggle status
            $('.toggle-status').change(function() {
                var id = $(this).data('id');
                var isActive = $(this).is(':checked');
                
                $.post('@Url.Action("ToggleStatus", "AcademicYear")/' + id, function(data) {
                    if (!data.success) {
                        // Revert the toggle if the operation failed
                        $('#status-' + id).prop('checked', !isActive).trigger('change');
                        toastr.error(data.message);
                    } else {
                        toastr.success(data.message);
                    }
                }).fail(function() {
                    $('#status-' + id).prop('checked', !isActive).trigger('change');
                    toastr.error('An error occurred while updating the status.');
                });
            });

            // Set current academic year
            $('.btn-set-current').click(function(e) {
                e.preventDefault();
                var id = $(this).data('id');
                var $button = $(this);
                
                if (confirm('Are you sure you want to set this as the current academic year?')) {
                    $.post('@Url.Action("SetCurrent", "AcademicYear")/' + id, function(data) {
                        if (data.success) {
                            toastr.success(data.message);
                            // Reload the page to reflect changes
                            setTimeout(function() { location.reload(); }, 1000);
                        } else {
                            toastr.error(data.message);
                        }
                    }).fail(function() {
                        toastr.error('An error occurred while setting the current academic year.');
                    });
                }
            });
        });
    </script>
}