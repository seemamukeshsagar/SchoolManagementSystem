@model SchoolPortal.Entities.Models.InventoryMaster
@{
    ViewData["Title"] = "Delete Inventory";
}
<h2>Delete Inventory</h2>

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
}

<div class="mb-3"><strong>Name:</strong> @Model.Name</div>
<div class="mb-3"><strong>ItemId:</strong> @Model.ItemId</div>
<div class="mb-3"><strong>LocationId:</strong> @Model.LocationId</div>
<div class="mb-3"><strong>Quantity:</strong> @Model.Quantity</div>
<div class="mb-3"><strong>Is Active:</strong> @(Model.IsActive == true ? "Yes" : "No")</div>

<form asp-action="Delete" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" name="id" value="@Model.Id" />
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>