@model SchoolPortalApp.Models.ItemMasterDetailsViewModel
@{
    ViewData["Title"] = "Item Details";
}
<h2>Item Details</h2>
<dl class="row">
    <dt class="col-sm-3">Item Name</dt><dd class="col-sm-9">@Model.ItemName</dd>
    <dt class="col-sm-3">Description</dt><dd class="col-sm-9">@Model.Description</dd>
    <dt class="col-sm-3">Item Type</dt><dd class="col-sm-9">@Model.ItemTypeName</dd>
    <dt class="col-sm-3">Active</dt><dd class="col-sm-9">@(Model.IsActive ? "Yes" : "No")</dd>
</dl>
<p>
    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-secondary">Edit</a>
    <a asp-action="Index" class="btn btn-outline-secondary">Back</a>
</p>