@model SchoolPortal.Entities.Models.ItemMaster
@{
    ViewData["Title"] = "Delete Item";
}
<h2>Delete Item</h2>
<div class="alert alert-warning">Are you sure you want to delete this item?</div>
<dl class="row">
    <dt class="col-sm-3">Item Name</dt><dd class="col-sm-9">@Model.ItemName</dd>
</dl>
<form asp-action="Delete" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" name="id" value="@Model.Id" />
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>
@if (TempData["ErrorMessage"] != null)
{
    <div class="text-danger mt-2">@TempData["ErrorMessage"]</div>
}