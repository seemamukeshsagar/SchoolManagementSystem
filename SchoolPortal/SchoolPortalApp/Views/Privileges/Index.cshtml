@model IEnumerable<SchoolPortalApp.Models.PrivilegeListItemViewModel>

@{
    ViewData["Title"] = "Privileges";
}

<h2>Privileges</h2>

<div class="row mb-3">
    <div class="col-md-4">
        <div class="input-group">
            <label class="input-group-text" for="roleId">Filter by Role:</label>
            @Html.DropDownList("roleId", ViewBag.Roles as SelectList, "-- All Roles --", 
                new { 
                    @class = "form-select", 
                    id = "roleId",
                    data_url = Url.Action("Index")
                })
        </div>
    </div>
</div>

@if (SchoolPortal.Services.Common.AuthorizedManager.HasPrivilege("Create Privilege"))
{
    <p>
        <a class="btn btn-primary" asp-controller="Privileges" asp-action="Create">
            <i class="bi bi-plus-circle"></i> Create New
        </a>
    </p>
}

<div id="privilegesTableContainer">
    @await Html.PartialAsync("_PrivilegesTable", Model)
</div>

<div id="loadingIndicator" class="text-center" style="display: none;">
    <div class="spinner-border text-primary" role="status">
        <span class="visually-hidden">Loading...</span>
    </div>
    <p>Loading privileges...</p>
</div>

@section Styles {
    <link rel="stylesheet" type="text/css" href="https://cdn.datatables.net/1.11.5/css/dataTables.bootstrap4.min.css">
    <link rel="stylesheet" href="https://cdn.datatables.net/buttons/2.4.2/css/buttons.dataTables.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">
}

@section Scripts {
    <script src="https://cdn.datatables.net/1.11.5/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.11.5/js/dataTables.bootstrap4.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.2/js/dataTables.buttons.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.2/js/buttons.html5.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.2/js/buttons.print.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.2.7/pdfmake.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.2.7/vfs_fonts.js"></script>

    <script>
        $(document).ready(function () {
            var table = null;
            
            function initializeDataTable() {
                if ($.fn.DataTable.isDataTable('#privilegesTable')) {
                    table.destroy();
                }
                
                table = $('#privilegesTable').DataTable({
                    paging: true,
                    pageLength: 10,
                    lengthChange: true,
                    lengthMenu: [[10, 25, 50, -1], [10, 25, 50, 'All']],
                    searching: true,
                    ordering: true,
                    info: true,
                    autoWidth: false,
                    responsive: true,
                    order: [],
                    dom: 'Bfrtip',
                    buttons: [
                        {
                            extend: 'excelHtml5',
                            text: '<i class="bi bi-file-excel"></i> Excel',
                            title: 'Privileges',
                            className: 'btn btn-success btn-sm',
                            exportOptions: {
                                columns: [0, 1, 2]
                            }
                        },
                        {
                            extend: 'pdfHtml5',
                            text: '<i class="bi bi-file-pdf"></i> PDF',
                            title: 'Privileges',
                            className: 'btn btn-danger btn-sm',
                            orientation: 'landscape',
                            pageSize: 'A4',
                            exportOptions: {
                                columns: [0, 1, 2]
                            }
                        }
                    ],
                    language: {
                        search: 'Search:',
                        lengthMenu: 'Show _MENU_ entries',
                        info: 'Showing _START_ to _END_ of _TOTAL_ entries',
                        infoEmpty: 'No entries found',
                        infoFiltered: '(filtered from _MAX_ total entries)'
                    },
                    stateSave: true,
                    stateLoadParams: function (settings, data) {
                        if ($('#roleId').val()) {
                            return false;
                        }
                        return true;
                    }
                });
            }

            // Initialize DataTable on page load
            initializeDataTable();

            // Handle role filter change with AJAX
            $('#roleId').on('change', function () {
                var roleId = $(this).val();
                var url = $(this).data('url');
                var params = {};
                
                if (roleId) {
                    params.roleId = roleId;
                }

                // Show loading indicator
                $('#privilegesTableContainer').hide();
                $('#loadingIndicator').show();

                // Make AJAX request
                $.ajax({
                    url: url,
                    type: 'GET',
                    data: params,
                    success: function (response) {
                        // Update the URL without reloading the page
                        var newUrl = url;
                        if (roleId) {
                            newUrl += (url.indexOf('?') >= 0 ? '&' : '?') + 'roleId=' + roleId;
                        }
                        window.history.pushState({}, '', newUrl);

                        // Update the table content
                        $('#privilegesTableContainer').html(response);
                        
                        // Reinitialize DataTable
                        initializeDataTable();
                    },
                    error: function (xhr, status, error) {
                        console.error('Error loading privileges:', error);
                        alert('An error occurred while loading privileges. Please try again.');
                    },
                    complete: function () {
                        // Hide loading indicator
                        $('#loadingIndicator').hide();
                        $('#privilegesTableContainer').show();
                    }
                });
            });

            // Handle browser back/forward buttons
            $(window).on('popstate', function() {
                location.reload();
            });
        });
    </script>
}