@model SchoolPortal.Entities.Models.Privileges
@{
	ViewData["Title"] = "Delete Privilege";
}
<h2>Delete Privilege</h2>
<h3>Are you sure you want to delete this?</h3>
<div>
	<hr />
	<dl class="row">
		<dt class="col-sm-3">Privilege Name</dt>
		<dd class="col-sm-9">@Model.PrivilegeName</dd>

		<dt class="col-sm-3">Is Active</dt>
		<dd class="col-sm-9">@Model.IsActive</dd>
	</dl>

	<form asp-action="Delete" method="post">
		@Html.AntiForgeryToken()
		<input type="hidden" asp-for="Id" />
		<button type="submit" class="btn btn-danger">Delete</button>
		<a asp-action="Index" class="btn btn-secondary">Cancel</a>
	</form>
</div>