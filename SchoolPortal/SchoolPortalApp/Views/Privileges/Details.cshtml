@model SchoolPortalApp.Models.PrivilegeDetailsViewModel

@{
	ViewData["Title"] = "Privilege Details";
}
<h2>Privilege Details</h2>
<div>
	<hr />
	<dl class="row">
		<dt class="col-sm-3">Privilege Name</dt>
		<dd class="col-sm-9">@Model.PrivilegeName</dd>

		<dt class="col-sm-3">Is Active</dt>
		<dd class="col-sm-9">@Model.IsActive</dd>

		<dt class="col-sm-3">Parent Privilege</dt>
		<dd class="col-sm-9">@Model.ParentPrivilegeName</dd>
	</dl>
</div>
<div>
	<a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Edit</a>
	<a asp-action="Index" class="btn btn-secondary">Back to List</a>
</div>
