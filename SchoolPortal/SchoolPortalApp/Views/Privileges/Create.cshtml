@model SchoolPortalApp.Models.PrivilegeViewModel
@{
	ViewData["Title"] = "Create Privilege";
}
<h2>Create Privilege</h2>
<form asp-action="Create" method="post">
	@Html.AntiForgeryToken()
	<div asp-validation-summary="ModelOnly" class="text-danger"></div>
	<div class="mb-3">
		<label asp-for="PrivilegeName" class="form-label"></label>
		<input asp-for="PrivilegeName" class="form-control" />
		<span asp-validation-for="PrivilegeName" class="text-danger"></span>
	</div>
	<div class="mb-3">
		<label asp-for="PrivilegeParentId" class="form-label"></label>
		<select asp-for="PrivilegeParentId" class="form-select" asp-items="Model.ParentPrivileges">
			<option value="">-- No Parent (Root Privilege) --</option>
		</select>
		<span asp-validation-for="PrivilegeParentId" class="text-danger"></span>
	</div>
	<div class="form-check mb-3">
		<input asp-for="IsActive" class="form-check-input" />
		<label asp-for="IsActive" class="form-check-label"></label>
	</div>
	<button type="submit" class="btn btn-primary">Create</button>
	<a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>
@section Scripts {
	<partial name="_ValidationScriptsPartial" />
}