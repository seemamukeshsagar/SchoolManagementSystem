@model IEnumerable<SchoolPortalApp.Models.PrivilegeListItemViewModel>

@{
    Layout = null;
}

<table id="privilegesTable" class="table table-striped">
    <thead>
        <tr>
            <th>Privilege Name</th>
            <th>Is Active</th>
            <th>Parent Privilege</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @if (Model != null && Model.Any())
        {
            foreach (var item in Model)
            {
                <tr>
                    <td>@item.PrivilegeName</td>
                    <td>@(item.IsActive ? "Yes" : "No")</td>
                    <td>@item.ParentPrivilegeName</td>
                    <td>
                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-info btn-sm" title="View Details">
                            <i class="bi bi-eye"></i>
                        </a>
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning btn-sm" title="Edit">
                            <i class="bi bi-pencil"></i>
                        </a>
                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger btn-sm" title="Delete">
                            <i class="bi bi-trash"></i>
                        </a>
                    </td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="4" class="text-center">No privileges found</td>
            </tr>
        }
    </tbody>
</table>