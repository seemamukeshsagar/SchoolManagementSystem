@model IEnumerable<SchoolPortal.Entities.Models.HolidayTypeMaster>
@{
	ViewData["Title"] = "Holiday Types";
}
<h2>Holiday Types</h2>
<p>
	<a asp-action="Create" class="btn btn-primary">Create New</a>
</p>
<table class="table table-striped">
	<thead>
		<tr>
			<th>Name</th>
			<th>Description</th>
			<th>Is Active</th>
			<th></th>
		</tr>
	</thead>
	<tbody>
@foreach (var item in Model)
{
		<tr>
			<td>@item.HolidayTypeName</td>
			<td>@item.HolidayTypeDescription</td>
			<td>@(item.IsActive ? "Yes" : "No")</td>
			<td>
					<div class="btn-group btn-group-sm">
						<a asp-action="Details" asp-route-id="@item.Id" class="btn btn-info" title="View Details">
							<i class="bi bi-eye"></i>
						</a>
						<a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning" title="Edit">
							<i class="bi bi-pencil"></i>
						</a>
						<a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger" title="Delete">
							<i class="bi bi-trash"></i>
						</a>
					</div>
			</td>
		</tr>
}
	</tbody>
</table>
