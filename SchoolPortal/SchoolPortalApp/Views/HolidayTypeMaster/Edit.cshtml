@model SchoolPortal.Entities.Models.HolidayTypeMaster
@{
	ViewData["Title"] = "Edit Holiday Type";
}
<h2>Edit Holiday Type</h2>
<form asp-action="Edit" method="post">
	<input type="hidden" asp-for="Id" />
	<div class="form-group">
		<label asp-for="HolidayTypeName"></label>
		<input asp-for="HolidayTypeName" class="form-control" />
		<span asp-validation-for="HolidayTypeName" class="text-danger"></span>
	</div>
	<div class="form-group">
		<label asp-for="HolidayTypeDescription"></label>
		<input asp-for="HolidayTypeDescription" class="form-control" />
		<span asp-validation-for="HolidayTypeDescription" class="text-danger"></span>
	</div>
	<div class="form-group form-check">
		<input asp-for="IsActive" class="form-check-input" />
		<label asp-for="IsActive" class="form-check-label"></label>
	</div>
	<button type="submit" class="btn btn-primary">Save</button>
	<a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>
