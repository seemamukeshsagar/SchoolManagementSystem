@model SchoolPortal.Entities.Models.HolidayTypeMaster
@{
    ViewData["Title"] = "Create Holiday Type";
}
<h2>Create Holiday Type</h2>
<form asp-action="Create" method="post">
    <div class="form-group">
        <label asp-for="HolidayTypeName"></label>
        <input asp-for="HolidayTypeName" class="form-control" />
        <span asp-validation-for="HolidayTypeName" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="HolidayTypeDescription"></label>
        <input asp-for="HolidayTypeDescription" class="form-control" />
        <span asp-validation-for="HolidayTypeDescription" class="text-danger"></span>
    </div>
    <div class="form-group form-check">
        <input asp-for="IsActive" class="form-check-input" />
        <label asp-for="IsActive" class="form-check-label"></label>
    </div>
    <button type="submit" class="btn btn-primary">Save</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>
