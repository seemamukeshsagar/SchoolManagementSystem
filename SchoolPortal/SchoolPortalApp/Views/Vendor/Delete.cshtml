@model SchoolPortal.Entities.Models.VendorMaster
@{
	ViewData["Title"] = "Delete Vendor";
}
<h2>Delete Vendor</h2>
<h3>Are you sure you want to delete this?</h3>
<div>
	<hr />
	<dl class="row">
		<dt class="col-sm-3">Vendor Name</dt>
		<dd class="col-sm-9">@Model.VendorName</dd>

		<dt class="col-sm-3">Description</dt>
		<dd class="col-sm-9">@Model.Description</dd>

		<dt class="col-sm-3">Email</dt>
		<dd class="col-sm-9">@Model.EmailId</dd>

		<dt class="col-sm-3">Contact Number</dt>
		<dd class="col-sm-9">@Model.ContactNumber</dd>

		<dt class="col-sm-3">Mobile Number</dt>
		<dd class="col-sm-9">@Model.MobileNumber</dd>

		<dt class="col-sm-3">Address Line 1</dt>
		<dd class="col-sm-9">@Model.Address1</dd>

		<dt class="col-sm-3">Address Line 2</dt>
		<dd class="col-sm-9">@Model.Address2</dd>

		<dt class="col-sm-3">Zip Code</dt>
		<dd class="col-sm-9">@Model.ZipCode</dd>

		<dt class="col-sm-3">Is Active</dt>
		<dd class="col-sm-9">@Model.IsActive</dd>
	</dl>

	<form asp-action="Delete" method="post">
		@Html.AntiForgeryToken()
		<input type="hidden" asp-for="Id" />
		<button type="submit" class="btn btn-danger">Delete</button>
		<a asp-action="Index" class="btn btn-secondary">Cancel</a>
	</form>
</div>