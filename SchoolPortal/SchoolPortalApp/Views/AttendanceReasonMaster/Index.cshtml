@model IEnumerable<SchoolPortal.Entities.Models.AttendanceReasonMaster>
@{
	ViewData["Title"] = "Attendance Reasons";
}
<h2>Attendance Reasons</h2>
<p>
	<a class="btn btn-primary" asp-controller="AttendanceReasonMaster" asp-action="Create">Create New</a>
</p>
<table class="table table-striped">
	<thead>
		<tr>
			<th>Code</th>
			<th>Name</th>
			<th>Description</th>
			<th>Is Active</th>
			<th></th>
		</tr>
	</thead>
	<tbody>
	@foreach (var item in Model)
	{
		<tr>
			<td>@item.Code</td>
			<td>@item.Name</td>
			<td>@item.Description</td>
			<td>@item.IsActive</td>
			<td>
				<a asp-action="Details" asp-route-id="@item.Id" class="btn btn-info" title="View Details"><i class="bi bi-eye"></i></a> |
				<a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning" title="Edit"><i class="bi bi-pencil"></i></a> |
				<a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger" title="Delete"><i class="bi bi-trash"></i></a>
			</td>
		</tr>
	}
	</tbody>
</table>
