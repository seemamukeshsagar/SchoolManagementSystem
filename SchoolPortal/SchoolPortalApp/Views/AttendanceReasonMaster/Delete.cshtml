@model SchoolPortal.Entities.Models.AttendanceReasonMaster
@{
	ViewData["Title"] = "Delete Attendance Reason";
}
<h2>Delete Attendance Reason</h2>
<h5>Are you sure you want to delete this attendance reason?</h5>
<div class="mb-3">
	<strong>@Model.Code - @Model.Name</strong>
</div>
<form asp-action="Delete" method="post">
	@Html.AntiForgeryToken()
	<input type="hidden" name="id" value="@Model.Id" />
	<button type="submit" class="btn btn-danger">Delete</button>
	<a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>
