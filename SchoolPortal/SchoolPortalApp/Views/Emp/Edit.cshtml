@section Scripts{
	<partial name="_ValidationScriptsPartial" />
	<script>
		var getDesignationsUrl = '@Url.Action("GetDesignationsByDepartment", "Emp")';
		function loadDesignations(deptId, $desigSelect, selectedId) {
			if (!deptId) {
				$desigSelect.empty().append($('<option>', { value: '', text: '-- Select Designation --' })).prop('disabled', true); return;
			}
			$.get(getDesignationsUrl + '/' + deptId, function (items) {
				$desigSelect.empty().append($('<option>', { value: '', text: '-- Select Designation --' }));
				if (items && items.length) {
					$.each(items, function (i, it) { $desigSelect.append($('<option>', { value: it.value, text: it.text })); }); if (selectedId) { $desigSelect.val(selectedId); } $desigSelect.prop('disabled', false);
				} else { $desigSelect.prop('disabled', true); }
			}).fail(function (xhr) {
				console.error('Failed to load designations', xhr);
				$desigSelect.empty().append($('<option>', { value: '', text: '-- Error loading designations --' })).prop('disabled', true);
			});
		}
		function loadStates(countryId, $stateSelect, selectedId) {
			if (!countryId) { $stateSelect.empty().append($('<option>', { value: '', text: '-- Select State --' })).prop('disabled', true); return; }
			$.get('/StudentMaster/GetStatesByCountry/' + countryId, function (states) {
				$stateSelect.empty().append($('<option>', { value: '', text: '-- Select State --' }));
				if (states && states.length) { $.each(states, function (i, s) { $stateSelect.append($('<option>', { value: s.value, text: s.text })); }); if (selectedId) { $stateSelect.val(selectedId); } $stateSelect.prop('disabled', false); }
			}).fail(function () { $stateSelect.empty().append($('<option>', { value: '', text: '-- Error loading states --' })); });
		}
		function loadCities(stateId, $citySelect, selectedId) {
			if (!stateId) { $citySelect.empty().append($('<option>', { value: '', text: '-- Select City --' })).prop('disabled', true); return; }
			$.get('/StudentMaster/GetCitiesByState/' + stateId, function (cities) {
				$citySelect.empty().append($('<option>', { value: '', text: '-- Select City --' }));
				if (cities && cities.length) { $.each(cities, function (i, c) { $citySelect.append($('<option>', { value: c.value, text: c.text })); }); if (selectedId) { $citySelect.val(selectedId); } $citySelect.prop('disabled', false); }
			}).fail(function () { $citySelect.empty().append($('<option>', { value: '', text: '-- Error loading cities --' })); });
		}
		$(document).ready(function () {
			var $dept = $('#DepartmentId');
			var $desig = $('#DesignationId');
			if (!$dept.val()) { $desig.prop('disabled', true); }
			$dept.on('change', function () {
				var deptId = $(this).val();
				$desig.empty().append($('<option>', { value: '', text: '-- Select Designation --' }));
				if (deptId) { loadDesignations(deptId, $desig); } else { $desig.prop('disabled', true); }
			});
			var initDept = $dept.val();
			var initDesig = $desig.val();
			if (initDept) { loadDesignations(initDept, $desig, initDesig); }
			var $curCountry = $('#CurrentCountryId');
			var $curState = $('#CurrentStateId');
			var $curCity = $('#CurrentCityId');
			var $perCountry = $('#PermanentCountryId');
			var $perState = $('#PermanentStateId');
			var $perCity = $('#PermanentCityId');
			if (!$curCountry.val()) { $curState.prop('disabled', true); $curCity.prop('disabled', true); }
			if (!$perCountry.val()) { $perState.prop('disabled', true); $perCity.prop('disabled', true); }
			$curCountry.on('change', function () { var countryId = $(this).val(); $curState.empty().append($('<option>', { value: '', text: '-- Select State --' })); $curCity.empty().append($('<option>', { value: '', text: '-- Select City --' })).prop('disabled', true); if (countryId) { loadStates(countryId, $curState); } else { $curState.prop('disabled', true); } });
			$curState.on('change', function () { var stateId = $(this).val(); $curCity.empty().append($('<option>', { value: '', text: '-- Select City --' })); if (stateId) { loadCities(stateId, $curCity); } else { $curCity.prop('disabled', true); } });
			$perCountry.on('change', function () { var countryId = $(this).val(); $perState.empty().append($('<option>', { value: '', text: '-- Select State --' })); $perCity.empty().append($('<option>', { value: '', text: '-- Select City --' })).prop('disabled', true); if (countryId) { loadStates(countryId, $perState); } else { $perState.prop('disabled', true); } });
			$perState.on('change', function () { var stateId = $(this).val(); $perCity.empty().append($('<option>', { value: '', text: '-- Select City --' })); if (stateId) { loadCities(stateId, $perCity); } else { $perCity.prop('disabled', true); } });
			var curCountryVal = $curCountry.val(); var curStateSelected = $curState.val(); var curCitySelected = $curCity.val(); if (curCountryVal) { loadStates(curCountryVal, $curState, curStateSelected); if (curStateSelected) { loadCities(curStateSelected, $curCity, curCitySelected); } }
			var perCountryVal = $perCountry.val(); var perStateSelected = $perState.val(); var perCitySelected = $perCity.val(); if (perCountryVal) { loadStates(perCountryVal, $perState, perStateSelected); if (perStateSelected) { loadCities(perStateSelected, $perCity, perCitySelected); } }
		});
	</script>
}
