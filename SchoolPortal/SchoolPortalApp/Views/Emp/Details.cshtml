@model SchoolPortalApp.Models.EmpViewModel
@{
    ViewData["Title"] = "Employee Details";
}
<h2>Employee Details</h2>
<div class="row">
  <div class="col-md-6">
    <dl class="row">
      <dt class="col-sm-5">First Name</dt><dd class="col-sm-7">@Model.FirstName</dd>
      <dt class="col-sm-5">Last Name</dt><dd class="col-sm-7">@Model.LastName</dd>
      <dt class="col-sm-5">DOB</dt><dd class="col-sm-7">@Model.DOB.ToShortDateString()</dd>
      <dt class="col-sm-5">DOJ</dt><dd class="col-sm-7">@Model.DOJ.ToShortDateString()</dd>
      <dt class="col-sm-5">Department</dt><dd class="col-sm-7">@Model.Departments?.FirstOrDefault(x=>x.Value==Model.DepartmentId?.ToString())?.Text</dd>
      <dt class="col-sm-5">Designation</dt><dd class="col-sm-7">@Model.Designations?.FirstOrDefault(x=>x.Value==Model.DesignationId?.ToString())?.Text</dd>
      <dt class="col-sm-5">Gender</dt><dd class="col-sm-7">@Model.Genders?.FirstOrDefault(x=>x.Value==Model.GenderId?.ToString())?.Text</dd>
      <dt class="col-sm-5">Phone</dt><dd class="col-sm-7">@Model.PhoneNumber</dd>
      <dt class="col-sm-5">Mobile</dt><dd class="col-sm-7">@Model.MobileNumber</dd>
      <dt class="col-sm-5">Email</dt><dd class="col-sm-7">@Model.EmailId</dd>
      <dt class="col-sm-5">Active</dt><dd class="col-sm-7">@(Model.IsActive ? "Yes" : "No")</dd>
      <dt class="col-sm-5">Status</dt><dd class="col-sm-7">@Model.Status</dd>
      <dt class="col-sm-5">Status Message</dt><dd class="col-sm-7">@Model.StatusMessage</dd>
    </dl>
  </div>
  <div class="col-md-6">
    <dl class="row">
      <dt class="col-sm-5">PAN</dt><dd class="col-sm-7">@Model.PANNumber</dd>
      <dt class="col-sm-5">ESIC</dt><dd class="col-sm-7">@Model.ESICNumber</dd>
      <dt class="col-sm-5">PF Number</dt><dd class="col-sm-7">@Model.PFNumeber</dd>
      <dt class="col-sm-5">Bank A/C</dt><dd class="col-sm-7">@Model.BankAccountNumber</dd>
      <dt class="col-sm-5">Bank Name</dt><dd class="col-sm-7">@Model.BankName</dd>
      <dt class="col-sm-5">Category</dt><dd class="col-sm-7">@Model.EmployeeCategories?.FirstOrDefault(x=>x.Value==Model.CategoryId?.ToString())?.Text</dd>
      <dt class="col-sm-5">Type</dt><dd class="col-sm-7">@Model.EmployeeTypes?.FirstOrDefault(x=>x.Value==Model.EmployeeTypeId?.ToString())?.Text</dd>
      <dt class="col-sm-5">Grade</dt><dd class="col-sm-7">@Model.Grades?.FirstOrDefault(x=>x.Value==Model.GradeId?.ToString())?.Text</dd>
      <dt class="col-sm-5">Blood Group</dt><dd class="col-sm-7">@Model.BloodGroups?.FirstOrDefault(x=>x.Value==Model.BloodGroupId?.ToString())?.Text</dd>
    </dl>
  </div>
</div>

<div class="row">
  <div class="col-md-6">
    <h5>Current Address</h5>
    <p>
      @Model.CurrentAddress1<br />
      @Model.CurrentAddress2<br />
      @Model.CurrentCities?.FirstOrDefault(x=>x.Value==Model.CurrentCityId?.ToString())?.Text,
      @Model.CurrentStates?.FirstOrDefault(x=>x.Value==Model.CurrentStateId?.ToString())?.Text,
      @Model.CurrentCountries?.FirstOrDefault(x=>x.Value==Model.CurrentCountryId?.ToString())?.Text - @Model.CurrentZipCode
    </p>
  </div>
  <div class="col-md-6">
    <h5>Permanent Address</h5>
    <p>
      @Model.PermanentAddress1<br />
      @Model.PermanentAddress2<br />
      @Model.PermanentCities?.FirstOrDefault(x=>x.Value==Model.PermanentCityId?.ToString())?.Text,
      @Model.PermanentStates?.FirstOrDefault(x=>x.Value==Model.PermanentStateId?.ToString())?.Text,
      @Model.PermanentCountries?.FirstOrDefault(x=>x.Value==Model.PermanentCountryId?.ToString())?.Text - @Model.PermanentZipCode
    </p>
  </div>
</div>

<p class="mt-3">
  <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Edit</a>
  <a asp-action="Index" class="btn btn-secondary">Back to List</a>
</p>
