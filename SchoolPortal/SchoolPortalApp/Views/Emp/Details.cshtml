@model SchoolPortalApp.Models.EmpDetailsViewModel
@{
	ViewData["Title"] = "Employee Details";
}
<h2>Employee Details</h2>
<div class="row">
	<div class="col-md-6">
		<dl class="row">
			<dt class="col-sm-5">First Name</dt>
			<dd class="col-sm-7">@Model.FirstName</dd>
			<dt class="col-sm-5">Last Name</dt>
			<dd class="col-sm-7">@Model.LastName</dd>
			<dt class="col-sm-5">Department</dt>
			<dd class="col-sm-7">@Model.DepartmentName</dd>
			<dt class="col-sm-5">Designation</dt>
			<dd class="col-sm-7">@Model.DesignationName</dd>
		</dl>
	</div>
	<div class="col-md-6">
		<dl class="row">
			<dt class="col-sm-5">Active</dt>
			<dd class="col-sm-7">@(Model.IsActive ? "Yes" : "No")</dd>
			<dt class="col-sm-5">Status</dt>
			<dd class="col-sm-7">@Model.Status</dd>
			<dt class="col-sm-5">Status Message</dt>
			<dd class="col-sm-7">@Model.StatusMessage</dd>
		</dl>
	</div>
</div>

<p class="mt-3">
	<a asp-action="Index" class="btn btn-secondary">Back to List</a>
</p>
