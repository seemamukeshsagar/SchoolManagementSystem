@model IEnumerable<SchoolPortalApp.Models.StudentListItemViewModel>
@{
	ViewData["Title"] = "Students";
}
<h2>Students</h2>
<div class="mb-3">
    <a class="btn btn-primary" asp-controller="StudentMaster" asp-action="Create">
        <i class="fas fa-plus"></i> Create New
    </a>
    <a class="btn btn-success" asp-controller="StudentMaster" asp-action="Import">
        <i class="fas fa-file-import"></i> Import from Excel
    </a>
</div>
<table class="table table-striped">
	<thead>
		<tr>
			<th>Name</th>
			<th>Email</th>
			<th>Phone</th>
			<th>Is Active</th>
			<th>School</th>
			<th></th>
		</tr>
	</thead>
	<tbody>
	@foreach (var item in Model)
	{
		<tr>
			<td>@item.Name</td>
			<td>@item.Email</td>
			<td>@item.Phone</td>
			<td>@item.IsActive</td>
			<td>@item.SchoolName</td>
			<td>
					<div class="btn-group btn-group-sm">
						<a asp-action="Details" asp-route-id="@item.Id" class="btn btn-info" title="View Details">
							<i class="bi bi-eye"></i>
						</a>
						<a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning" title="Edit">
							<i class="bi bi-pencil"></i>
						</a>
						<a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger" title="Delete">
							<i class="bi bi-trash"></i>
						</a>
					</div>
			</td>
		</tr>
	}
	</tbody>
</table>
