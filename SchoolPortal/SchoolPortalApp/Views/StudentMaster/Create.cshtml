@model SchoolPortalApp.Models.StudentViewModel
@{
    ViewData["Title"] = "Create Student";
}

<h2>Create Student</h2>

<form asp-action="Create" method="post" enctype="multipart/form-data">
    <ul class="nav nav-tabs" id="studentTabs" role="tablist">
        <li class="nav-item">
            <a class="nav-link active" id="basic-tab" data-toggle="tab" href="#basic" role="tab" aria-controls="basic" aria-selected="true">Basic Information</a>
        </li>
        <li class="nav-item">
            <a class="nav-link" id="address-tab" data-toggle="tab" href="#address" role="tab" aria-controls="address" aria-selected="false">Address & Contact</a>
        </li>
        <li class="nav-item">
            <a class="nav-link" id="academic-tab" data-toggle="tab" href="#academic" role="tab" aria-controls="academic" aria-selected="false">Academic Details</a>
        </li>
        <li class="nav-item">
            <a class="nav-link" id="medical-tab" data-toggle="tab" href="#medical" role="tab" aria-controls="medical" aria-selected="false">Medical & Background</a>
        </li>
        <li class="nav-item">
            <a class="nav-link" id="previous-school-tab" data-toggle="tab" href="#previous-school" role="tab" aria-controls="previous-school" aria-selected="false">Previous School</a>
        </li>
        <li class="nav-item">
            <a class="nav-link" id="additional-tab" data-toggle="tab" href="#additional" role="tab" aria-controls="additional" aria-selected="false">Additional Info</a>
        </li>
    </ul>

    <div class="tab-content p-3 border border-top-0 rounded-bottom" id="studentTabsContent">
        <!-- Basic Information Tab -->
        <div class="tab-pane fade show active" id="basic" role="tabpanel" aria-labelledby="basic-tab">
            <div class="row">
                <div class="col-md-6">
                    <div class="form-group">
                        <label asp-for="FirstName"></label>
                        <input asp-for="FirstName" class="form-control" />
                        <span asp-validation-for="FirstName" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label asp-for="LastName"></label>
                        <input asp-for="LastName" class="form-control" />
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-md-4">
                    <div class="form-group">
                        <label asp-for="DOB"></label>
                        <input asp-for="DOB" class="form-control" />
                        <span asp-validation-for="DOB" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="form-group">
                        <label asp-for="Gender"></label>
                        <select asp-for="Gender" asp-items="Model.Genders" class="form-control"></select>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="form-group">
                        <label asp-for="ImageFile"></label>
                        <input asp-for="ImageFile" type="file" class="form-control-file" />
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-md-6">
                    <div class="form-group">
                        <label asp-for="Email"></label>
                        <input asp-for="Email" class="form-control" />
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label asp-for="Phone"></label>
                        <input asp-for="Phone" class="form-control" />
                    </div>
                </div>
            </div>
        </div>

        <!-- Address & Contact Tab -->
        <div class="tab-pane fade" id="address" role="tabpanel" aria-labelledby="address-tab">
            <div class="form-group">
                <label asp-for="Address"></label>
                <textarea asp-for="Address" class="form-control" rows="2"></textarea>
            </div>
            <div class="row">
                <div class="col-md-4">
                    <div class="form-group">
                        <label asp-for="CountryId"></label>
                        <select asp-for="CountryId" asp-items="Model.Countries" class="form-control" id="countryDropdown"></select>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="form-group">
                        <label asp-for="StateId"></label>
                        <select asp-for="StateId" asp-items="Model.States" class="form-control" id="stateDropdown"></select>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="form-group">
                        <label asp-for="CityId"></label>
                        <select asp-for="CityId" asp-items="Model.Cities" class="form-control" id="cityDropdown"></select>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-md-4">
                    <div class="form-group">
                        <label asp-for="ZipCode"></label>
                        <input asp-for="ZipCode" class="form-control" />
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="form-group">
                        <label asp-for="ContactNumber"></label>
                        <input asp-for="ContactNumber" class="form-control" />
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="form-group">
                        <label asp-for="EmergencyContactNumber"></label>
                        <input asp-for="EmergencyContactNumber" class="form-control" />
                    </div>
                </div>
            </div>
        </div>

        <!-- Academic Details Tab -->
        <div class="tab-pane fade" id="academic" role="tabpanel" aria-labelledby="academic-tab">
            <div class="row">
                <div class="col-md-6">
                    <div class="form-group">
                        <label asp-for="SchoolId"></label>
                        <select asp-for="SchoolId" asp-items="Model.Schools" class="form-control"></select>
                        <span asp-validation-for="SchoolId" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label asp-for="ClassId"></label>
                        <select asp-for="ClassId" asp-items="Model.Classes" class="form-control"></select>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-md-6">
                    <div class="form-group">
                        <label asp-for="SectionId"></label>
                        <select asp-for="SectionId" asp-items="Model.Sections" class="form-control"></select>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label asp-for="RollNumber"></label>
                        <input asp-for="RollNumber" class="form-control" />
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-md-6">
                    <div class="form-group">
                        <label asp-for="RegistrationNumber"></label>
                        <input asp-for="RegistrationNumber" class="form-control" />
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label asp-for="DOJ"></label>
                        <input asp-for="DOJ" class="form-control" />
                    </div>
                </div>
            </div>
        </div>

        <!-- Medical & Background Tab -->
        <div class="tab-pane fade" id="medical" role="tabpanel" aria-labelledby="medical-tab">
            <div class="row">
                <div class="col-md-4">
                    <div class="form-group">
                        <label asp-for="BloodGroupId"></label>
                        <select asp-for="BloodGroupId" asp-items="Model.BloodGroups" class="form-control"></select>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="form-group">
                        <label asp-for="Nationality"></label>
                        <select asp-for="Nationality" asp-items="Model.Nationalities" class="form-control"></select>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="form-group">
                        <label asp-for="ReligionId"></label>
                        <select asp-for="ReligionId" asp-items="Model.Religions" class="form-control"></select>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-md-6">
                    <div class="form-group">
                        <label asp-for="DisabilityAny"></label>
                        <input asp-for="DisabilityAny" class="form-control" placeholder="If any, please specify" />
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label asp-for="MedicalAlleryAny"></label>
                        <input asp-for="MedicalAlleryAny" class="form-control" placeholder="If any, please specify" />
                    </div>
                </div>
            </div>
            <div class="form-group">
                <label>Birth Details</label>
                <div class="row">
                    <div class="col-md-4">
                        <div class="form-group">
                            <label asp-for="BirthCityId"></label>
                            <select asp-for="BirthCityId" asp-items="Model.BirthCities" class="form-control"></select>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-group">
                            <label asp-for="BirthStateId"></label>
                            <select asp-for="BirthStateId" asp-items="Model.BirthStates" class="form-control"></select>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-group">
                            <label asp-for="BirthCountryId"></label>
                            <select asp-for="BirthCountryId" asp-items="Model.BirthCountries" class="form-control"></select>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Previous School Tab -->
        <div class="tab-pane fade" id="previous-school" role="tabpanel" aria-labelledby="previous-school-tab">
            <div class="form-group">
                <label asp-for="PreviousSchoolAttended"></label>
                <input asp-for="PreviousSchoolAttended" class="form-control" placeholder="Name of the previous school" />
            </div>
            <div class="row">
                <div class="col-md-6">
                    <div class="form-group">
                        <label asp-for="PreviousSchoolClassId"></label>
                        <select asp-for="PreviousSchoolClassId" class="form-control">
                            <option value="">-- Select Class --</option>
                            @foreach (var item in Model.PreviousSchoolClasses)
                            {
                                <option value="@item.Value" selected="@(item.Selected ? "selected" : null)">@item.Text</option>
                            }
                        </select>
                        <span asp-validation-for="PreviousSchoolClassId" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label asp-for="PreviousSchoolBoardId"></label>
                        <select asp-for="PreviousSchoolBoardId" class="form-control">
                            <option value="">-- Select Board --</option>
                            @foreach (var item in Model.PreviousSchoolBoards)
                            {
                                <option value="@item.Value" selected="@(item.Selected ? "selected" : null)">@item.Text</option>
                            }
                        </select>
                        <span asp-validation-for="PreviousSchoolBoardId" class="text-danger"></span>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-md-4">
                    <div class="form-group">
                        <label asp-for="PreviousSchoolPercentage"></label>
                        <div class="input-group">
                            <input asp-for="PreviousSchoolPercentage" class="form-control" />
                            <div class="input-group-append">
                                <span class="input-group-text">%</span>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="form-group">
                        <label asp-for="PreviousSchoolFromDate"></label>
                        <input type="date" asp-for="PreviousSchoolFromDate" class="form-control" />
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="form-group">
                        <label asp-for="PreviousSchoolToDate"></label>
                        <input type="date" asp-for="PreviousSchoolToDate" class="form-control" />
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-md-6">
                    <div class="form-group">
                        <label asp-for="PreviousSchoolRank"></label>
                        <input asp-for="PreviousSchoolRank" class="form-control" placeholder="If applicable" />
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label asp-for="WithdrawnDate"></label>
                        <input asp-for="WithdrawnDate" class="form-control" />
                    </div>
                </div>
            </div>
            <div class="form-group">
                <label asp-for="WithdrawnReason"></label>
                <textarea asp-for="WithdrawnReason" class="form-control" rows="2" placeholder="Reason for leaving previous school"></textarea>
            </div>
        </div>

        <!-- Additional Info Tab -->
        <div class="tab-pane fade" id="additional" role="tabpanel" aria-labelledby="additional-tab">
            <div class="form-group">
                <label asp-for="Hobbies"></label>
                <input asp-for="Hobbies" class="form-control" placeholder="Student's hobbies/interests" />
            </div>
            <div class="form-check mb-3">
                <input class="form-check-input" type="checkbox" asp-for="SiblingsIfAny" id="siblingsCheckbox" />
                <label class="form-check-label" for="siblingsCheckbox" asp-for="SiblingsIfAny"></label>
            </div>
            <div class="form-group" id="siblingClassGroup">
                <label asp-for="SiblingClassId"></label>
                <select asp-for="SiblingClassId" asp-items="Model.SiblingClasses" class="form-control">
                    <option value="">-- Select Sibling's Class --</option>
                </select>
            </div>
            <div class="form-check mb-3">
                <input class="form-check-input" type="checkbox" asp-for="AvailTransport" id="transportCheckbox" />
                <label class="form-check-label" for="transportCheckbox" asp-for="AvailTransport"></label>
            </div>
            <div class="form-group">
                <label asp-for="CategoryId"></label>
                <select asp-for="CategoryId" asp-items="Model.Categories" class="form-control"></select>
            </div>
            <div class="form-check mb-3">
                <input class="form-check-input" type="checkbox" asp-for="IsActive" id="isActiveCheckbox" />
                <label class="form-check-label" for="isActiveCheckbox" asp-for="IsActive"></label>
            </div>
        </div>
    </div>

    <!-- Form Buttons -->
    <div class="form-group mt-4">
        <button type="submit" class="btn btn-primary">Save</button>
        <a asp-action="Index" class="btn btn-secondary">Back to List</a>
    </div>
    </div>
    <div class="form-row">
        <div class="form-group col-md-4">
            <label asp-for="RouteId"></label>
            <select asp-for="RouteId" asp-items="Model.Routes" class="form-control"></select>
        </div>
        <div class="form-group col-md-4">
            <label asp-for="RouteStopDetailsId"></label>
            <select asp-for="RouteStopDetailsId" asp-items="Model.RouteStops" class="form-control"></select>
        </div>
        <div class="form-group col-md-4">
            <label asp-for="ClassTeacherId"></label>
            <select asp-for="ClassTeacherId" asp-items="Model.ClassTeachers" class="form-control"></select>
        </div>
    </div>
    <div class="form-group form-check">
        <input class="form-check-input" asp-for="RoutePickAndDrop" />
        <label class="form-check-label" asp-for="RoutePickAndDrop"></label>
    </div>
    <div class="form-row">
        <div class="form-group col-md-4">
            <label asp-for="FeesDiscountCategoryMasterId"></label>
            <select asp-for="FeesDiscountCategoryMasterId" asp-items="Model.FeesDiscountCategories" class="form-control"></select>
        </div>
        <div class="form-group col-md-4">
            <label asp-for="TutionFees"></label>
            <input asp-for="TutionFees" class="form-control" />
        </div>
        <div class="form-group col-md-4">
            <label asp-for="AnnualFees"></label>
            <input asp-for="AnnualFees" class="form-control" />
        </div>
    </div>
    <div class="form-row">
        <div class="form-group col-md-6">
            <label asp-for="TransportFees"></label>
            <input asp-for="TransportFees" class="form-control" />
        </div>
        <div class="form-group col-md-6">
            <label asp-for="UseTransportFees"></label>
            <input class="form-check-input" type="checkbox" asp-for="UseTransportFees" />
        </div>
    </div>
    <div class="form-row">
        <div class="form-group col-md-6">
            <label asp-for="SessionId"></label>
            <select asp-for="SessionId" asp-items="Model.Sessions" class="form-control"></select>
        </div>
        <div class="form-group col-md-6">
            <label asp-for="HouseAllotted"></label>
            <select asp-for="HouseAllotted" asp-items="Model.Houses" class="form-control"></select>
        </div>
    </div>
    <div class="form-row">
        <div class="form-group col-md-6">
            <label asp-for="CompanyId"></label>
            <input asp-for="CompanyId" class="form-control" />
        </div>
        <div class="form-group col-md-6">
            <label asp-for="IsDeleted"></label>
            <input class="form-check-input" type="checkbox" asp-for="IsDeleted" />
        </div>
    </div>    
    <button type="submit" class="btn btn-primary">Create</button>
    <a class="btn btn-secondary" asp-action="Index">Cancel</a>
</form>
@section Scripts{
    <partial name="_ValidationScriptsPartial" />
    <script>
        $(document).ready(function() {
            // Toggle sibling class field based on checkbox
            toggleSiblingClass();
            $("#siblingsCheckbox").change(function() {
                toggleSiblingClass();
            });
            
            function toggleSiblingClass() {
                if ($("#siblingsCheckbox").is(":checked")) {
                    $("#siblingClassGroup").show();
                } else {
                    $("#siblingClassGroup").hide();
                    // Clear the sibling class selection when hiding
                    $("#SiblingClassId").val('');
                }
            }
            
            // Initialize tabs
            $('a[data-toggle="tab"]').on('shown.bs.tab', function (e) {
                localStorage.setItem('lastTab', $(this).attr('id'));
            });
            
            // Restore last active tab if available
            var lastTab = localStorage.getItem('lastTab');
            if (lastTab) {
                $('#' + lastTab).tab('show');
            }
            
            // Initialize form validation
            var $form = $('form');
            $form.validate({
                ignore: ':hidden:not(.validate-required)',
                errorElement: 'span',
                errorClass: 'text-danger',
                highlight: function(element, errorClass) {
                    $(element).addClass('is-invalid');
                },
                unhighlight: function(element, errorClass) {
                    $(element).removeClass('is-invalid');
                },
                errorPlacement: function(error, element) {
                    error.addClass('invalid-feedback d-block');
                    error.insertAfter(element);
                }
            });
            
            // Make sure all required fields are validated before form submission
            $form.on('submit', function(e) {
                var currentTab = $('.nav-tabs .nav-link.active').attr('id');
                localStorage.setItem('lastTab', currentTab);
                
                // Validate all form fields
                var isValid = $form.valid();
                
                if (!isValid) {
                    // Find the first tab with errors and switch to it
                    var $firstError = $('.field-validation-error').first();
                    if ($firstError.length) {
                        var $tabPane = $firstError.closest('.tab-pane');
                        if ($tabPane.length) {
                            var tabId = $tabPane.attr('id') + '-tab';
                            $('#' + tabId).tab('show');
                            // Scroll to the error
                            $('html, body').animate({
                                scrollTop: $firstError.offset().top - 100
                            }, 500);
                        }
                    }
                    e.preventDefault();
                    return false;
                }
                
                return true;
            });
            
            // Initialize datepickers for date fields
            $('input[type="date"]').each(function() {
                if (!$(this).val()) {
                    // Set default date to today if empty
                    $(this).val(new Date().toISOString().split('T')[0]);
                }
            });
            
            // Initialize select2 for better dropdowns (if you're using select2)
            if ($.fn.select2) {
                $('select').select2({
                    theme: 'bootstrap4',
                    width: '100%'
                });
            }
            
            // Handle form reset
            $('button[type="reset"]').on('click', function() {
                // Reset the form
                $form[0].reset();
                // Reset validation
                $form.validate().resetForm();
                $('.is-invalid').removeClass('is-invalid');
                $('.field-validation-error').remove();
                // Reset tabs to first tab
                $('#basic-tab').tab('show');
                // Reset any custom UI elements
                toggleSiblingClass();
            });
            
            // Cascade dropdowns for address
            $("#CountryId").change(function() {
                var countryId = $(this).val();
                var $stateDropdown = $("#StateId");
                var $cityDropdown = $("#CityId");
                
                // Reset and disable dependent dropdowns
                $stateDropdown.empty().append($('<option>', { value: '', text: '-- Select State --' }));
                $cityDropdown.empty().append($('<option>', { value: '', text: '-- Select City --' }));
                
                if (countryId) {
                    // Make AJAX call to get states for the selected country
                    $.get('/StudentMaster/GetStatesByCountry', { countryId: countryId }, function(states) {
                        $.each(states, function(i, state) {
                            $stateDropdown.append($('<option>', { 
                                value: state.value, 
                                text: state.text,
                                selected: state.selected
                            }));
                        });
                        $stateDropdown.prop('disabled', false);
                    });
                } else {
                    $stateDropdown.prop('disabled', true);
                    $cityDropdown.prop('disabled', true);
                }
            });
            
            $("#StateId").change(function() {
                var stateId = $(this).val();
                var $cityDropdown = $("#CityId");
                
                // Reset city dropdown
                $cityDropdown.empty().append($('<option>', { value: '', text: '-- Select City --' }));
                
                if (stateId) {
                    // Make AJAX call to get cities for the selected state
                    $.get('/StudentMaster/GetCitiesByState', { stateId: stateId }, function(cities) {
                        $.each(cities, function(i, city) {
                            $cityDropdown.append($('<option>', { 
                                value: city.value, 
                                text: city.text,
                                selected: city.selected
                            }));
                        });
                        $cityDropdown.prop('disabled', false);
                    });
                } else {
                    $cityDropdown.prop('disabled', true);
                }
            });
            
            // Initialize the form state
            toggleSiblingClass();
            
            // Disable state and city dropdowns initially if country is not selected
            if (!$("#CountryId").val()) {
                $("#StateId").prop('disabled', true);
                $("#CityId").prop('disabled', true);
            }
        });
    </script>
}

