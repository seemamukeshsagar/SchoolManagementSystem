@model SchoolPortalApp.Models.StudentViewModel
@{
    ViewData["Title"] = "Create Student";
}

<!-- Add SweetAlert2 CSS -->
<link href="https://cdn.jsdelivr.net/npm/sweetalert2@11.0.19/dist/sweetalert2.min.css" rel="stylesheet">

<h2>Create Student</h2>

<form asp-controller="StudentMaster" asp-action="Create" method="post" enctype="multipart/form-data" class="needs-validation" novalidate>
    @Html.AntiForgeryToken()

	<!-- Loading Overlay -->
    <div id="loadingOverlay" class="position-fixed w-100 h-100 bg-white bg-opacity-75 d-flex justify-content-center align-items-center" style="display: none !important; z-index: 9999;">
        <div class="text-center">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
            <p class="mt-2">Saving student data...</p>
        </div>
    </div>
    
    <!-- Required Fields Note -->
    <div class="alert alert-info mb-3">
        <i class="fas fa-info-circle"></i> Fields marked with <span class="text-danger">*</span> are required.
    </div>

    <ul class="nav nav-tabs" id="studentTabs" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active" id="basic-tab" data-bs-toggle="tab" data-bs-target="#basic" type="button" role="tab" aria-controls="basic" aria-selected="true">Basic Information</button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="address-tab" data-bs-toggle="tab" data-bs-target="#address" type="button" role="tab" aria-controls="address" aria-selected="false">Address & Contact</button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="parents-tab" data-bs-toggle="tab" data-bs-target="#parents" type="button" role="tab" aria-controls="parents" aria-selected="false">Parents</button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="academic-tab" data-bs-toggle="tab" data-bs-target="#academic" type="button" role="tab" aria-controls="academic" aria-selected="false">Academic Details</button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="medical-tab" data-bs-toggle="tab" data-bs-target="#medical" type="button" role="tab" aria-controls="medical" aria-selected="false">Medical & Background</button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="previous-school-tab" data-bs-toggle="tab" data-bs-target="#previous-school" type="button" role="tab" aria-controls="previous-school" aria-selected="false">Previous School</button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="additional-tab" data-bs-toggle="tab" data-bs-target="#additional" type="button" role="tab" aria-controls="additional" aria-selected="false">Additional Info</button>
        </li>
    </ul>

    <div class="tab-content p-3 border border-top-0 rounded-bottom" id="studentTabsContent">
        <!-- Basic Information Tab -->
        <div class="tab-pane fade show active" id="basic" role="tabpanel" aria-labelledby="basic-tab">
            <div class="row">
                <div class="col-md-6">
                    <div class="form-group">
                        <label asp-for="FirstName" class="required"></label>
                        <input asp-for="FirstName" class="form-control" required />
                        <span asp-validation-for="FirstName" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label asp-for="LastName" class="required"></label>
                        <input asp-for="LastName" class="form-control" required />
                        <span asp-validation-for="LastName" class="text-danger"></span>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-md-4">
                    <div class="form-group">
                        <label asp-for="DOB" class="required"></label>
                        <input asp-for="DOB" type="date" class="form-control" 
                               max="@DateTime.Now.ToString("yyyy-MM-dd")" 
                               required />
                        <span asp-validation-for="DOB" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="mb-3">
                        <label class="form-label required">@Html.DisplayNameFor(m => m.Gender)</label>
                        <div class="d-flex gap-3 mt-2">
                            @foreach (var gender in Model.Genders)
                            {
                                <div class="form-check">
                                    <input asp-for="Gender" class="form-check-input" type="radio" 
                                           value="@gender.Value" id="gender-@gender.Value" required>
                                    <label class="form-check-label" for="gender-@gender.Value">
                                        @gender.Text
                                    </label>
                                </div>
                            }
                        </div>
                        <span asp-validation-for="Gender" class="text-danger small"></span>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="form-group">
                        <label asp-for="ImageFile"></label>
                        <input asp-for="ImageFile" type="file" class="form-control-file" 
                               accept="image/*" 
                               data-max-size="5242880" 
                               onchange="previewImage(this);" />
                        <small class="form-text text-muted">Max file size: 5MB. Allowed types: jpg, jpeg, png</small>
                        <div id="imagePreview" class="mt-2" style="max-width: 200px; display: none;">
                            <img id="preview" class="img-thumbnail" />
                        </div>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-md-6">
                    <div class="form-group">
                        <label asp-for="Email" class="required"></label>
                        <input asp-for="Email" type="email" class="form-control" required />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label asp-for="Phone" class="required"></label>
                        <input asp-for="Phone" class="form-control" required />
                        <span asp-validation-for="Phone" class="text-danger"></span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Address & Contact Tab -->
        <div class="tab-pane fade" id="address" role="tabpanel" aria-labelledby="address-tab">
            <div class="form-group">
                <label asp-for="Address" class="required"></label>
                <textarea asp-for="Address" class="form-control" rows="2" required></textarea>
                <span asp-validation-for="Address" class="text-danger"></span>
            </div>
            <div class="row">
                <div class="col-md-4">
                    <div class="form-group">
                        <label asp-for="CountryId" class="required"></label>
                        <select asp-for="CountryId" asp-items="Model.Countries" class="form-control" required>
                            <option value="">-- Select Country --</option>
                        </select>
                        <span asp-validation-for="CountryId" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="form-group">
                        <label asp-for="StateId" class="required"></label>
                        <select asp-for="StateId" asp-items="Model.States" class="form-control" required>
                            <option value="">-- Select State --</option>
                        </select>
                        <span asp-validation-for="StateId" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="form-group">
                        <label asp-for="CityId" class="required"></label>
                        <select asp-for="CityId" asp-items="Model.Cities" class="form-control" required>
                            <option value="">-- Select City --</option>
                        </select>
                        <span asp-validation-for="CityId" class="text-danger"></span>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-md-4">
                    <div class="form-group">
                        <label asp-for="ZipCode" class="required"></label>
                        <input asp-for="ZipCode" class="form-control" required />
                        <span asp-validation-for="ZipCode" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="form-group">
                        <label asp-for="ContactNumber" class="required"></label>
                        <input asp-for="ContactNumber" class="form-control" required />
                        <span asp-validation-for="ContactNumber" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="form-group">
                        <label asp-for="EmergencyContactNumber" class="required"></label>
                        <input asp-for="EmergencyContactNumber" class="form-control" required />
                        <span asp-validation-for="EmergencyContactNumber" class="text-danger"></span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Parents Tab -->
        <div class="tab-pane fade" id="parents" role="tabpanel" aria-labelledby="parents-tab">
            <div class="row">
                <div class="col-md-6">
                    <div class="form-group">
                        <label asp-for="ParentFirstName" class="required"></label>
                        <input asp-for="ParentFirstName" class="form-control" required />
                        <span asp-validation-for="ParentFirstName" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label asp-for="ParentLastName" class="required"></label>
                        <input asp-for="ParentLastName" class="form-control" required />
                        <span asp-validation-for="ParentLastName" class="text-danger"></span>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-md-4">
                    <div class="form-group">
                        <label asp-for="ParentRelationTypeId" class="required"></label>
                        <select asp-for="ParentRelationTypeId" asp-items="Model.ParentRelationTypes" class="form-control" required>
                            <option value="">-- Select Relation --</option>
                        </select>
                        <span asp-validation-for="ParentRelationTypeId" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="form-group">
                        <label asp-for="ParentQualificationId"></label>
                        <select asp-for="ParentQualificationId" asp-items="Model.ParentQualifications" class="form-control">
                            <option value="">-- Select Qualification --</option>
                        </select>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="form-group">
                        <label asp-for="ParentDesignationId"></label>
                        <select asp-for="ParentDesignationId" asp-items="Model.ParentDesignations" class="form-control">
                            <option value="">-- Select Designation --</option>
                        </select>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-md-4">
                    <div class="form-group">
                        <label asp-for="ParentOccupation"></label>
                        <input asp-for="ParentOccupation" class="form-control" />
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="form-group">
                        <label asp-for="ParentAnnualIncome"></label>
                        <input asp-for="ParentAnnualIncome" type="number" class="form-control" />
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="form-group">
                        <label asp-for="ParentDOB"></label>
                        <input asp-for="ParentDOB" type="date" class="form-control" max="@DateTime.Now.ToString("yyyy-MM-dd")" />
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-md-6">
                    <div class="form-group">
                        <label asp-for="ParentPhone" class="required"></label>
                        <input asp-for="ParentPhone" class="form-control" required />
                        <span asp-validation-for="ParentPhone" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label asp-for="ParentEmail"></label>
                        <input asp-for="ParentEmail" type="email" class="form-control" />
                        <span asp-validation-for="ParentEmail" class="text-danger"></span>
                    </div>
                </div>
            </div>
            <div class="form-group">
                <label asp-for="ParentAddress1" class="required"></label>
                <input asp-for="ParentAddress1" class="form-control" required />
                <span asp-validation-for="ParentAddress1" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="ParentAddress2"></label>
                <input asp-for="ParentAddress2" class="form-control" />
            </div>
            <div class="row">
                <div class="col-md-4">
                    <div class="form-group">
                        <label asp-for="ParentCountryId" class="required"></label>
                        <select asp-for="ParentCountryId" asp-items="Model.ParentCountries" class="form-control" id="ParentCountryId" required>
                            <option value="">-- Select Country --</option>
                        </select>
                        <span asp-validation-for="ParentCountryId" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="form-group">
                        <label asp-for="ParentStateId" class="required"></label>
                        <select asp-for="ParentStateId" asp-items="Model.ParentStates" class="form-control" id="ParentStateId" disabled required>
                            <option value="">-- Select State --</option>
                        </select>
                        <span asp-validation-for="ParentStateId" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="form-group">
                        <label asp-for="ParentCityId" class="required"></label>
                        <select asp-for="ParentCityId" asp-items="Model.ParentCities" class="form-control" id="ParentCityId" disabled required>
                            <option value="">-- Select City --</option>
                        </select>
                        <span asp-validation-for="ParentCityId" class="text-danger"></span>
                    </div>
                </div>
            </div>
            <div class="form-group form-check">
                <input class="form-check-input" type="checkbox" asp-for="ParentIsActive" id="ParentIsActive" />
                <label class="form-check-label" for="ParentIsActive">@Html.DisplayNameFor(m => m.ParentIsActive)</label>
            </div>
        </div>

        <!-- Academic Details Tab -->
        <div class="tab-pane fade" id="academic" role="tabpanel" aria-labelledby="academic-tab">
            <div class="row">
                <div class="col-md-6">
                    <div class="form-group">
                        <label asp-for="ClassId" class="required"></label>
                        <select asp-for="ClassId" asp-items="Model.Classes" class="form-control" id="ClassId" required>
                            <option value="">-- Select Class --</option>
                        </select>
                        <span asp-validation-for="ClassId" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label asp-for="SectionId" class="required"></label>
                        <select asp-for="SectionId" class="form-control" id="SectionId" disabled required>
                            <option value="">-- Select Section --</option>
                        </select>
                        <span asp-validation-for="SectionId" class="text-danger"></span>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-md-6">
                    <div class="form-group">
                        <label asp-for="RollNumber" class="required"></label>
                        <input asp-for="RollNumber" class="form-control" required />
                        <span asp-validation-for="RollNumber" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label asp-for="RegistrationNumber"></label>
                        <input asp-for="RegistrationNumber" class="form-control" />
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-md-6">
                    <div class="form-group">
                        <label asp-for="DOJ" class="required"></label>
                        <input asp-for="DOJ" type="date" class="form-control" max="@DateTime.Now.ToString("yyyy-MM-dd")" required />
                        <span asp-validation-for="DOJ" class="text-danger"></span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Medical & Background Tab -->
        <div class="tab-pane fade" id="medical" role="tabpanel" aria-labelledby="medical-tab">
            <div class="row">
                <div class="col-md-4">
                    <div class="form-group">
                        <label asp-for="BloodGroupId"></label>
                        <select asp-for="BloodGroupId" asp-items="Model.BloodGroups" class="form-control">
                            <option value="">-- Select Blood Group --</option>
                        </select>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="form-group">
                        <label asp-for="Nationality"></label>
                        <select asp-for="Nationality" asp-items="Model.Nationalities" class="form-control">
                            <option value="">-- Select Nationality --</option>
                        </select>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="form-group">
                        <label asp-for="ReligionId"></label>
                        <select asp-for="ReligionId" asp-items="Model.Religions" class="form-control">
                            <option value="">-- Select Religion --</option>
                        </select>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-md-6">
                    <div class="form-group">
                        <label asp-for="DisabilityAny"></label>
                        <input asp-for="DisabilityAny" class="form-control" placeholder="If any, please specify" />
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label asp-for="MedicalAlleryAny"></label>
                        <input asp-for="MedicalAlleryAny" class="form-control" placeholder="If any, please specify" />
                    </div>
                </div>
            </div>
            <div class="form-group">
                <label>Birth Details</label>
                <div class="row">
                    <div class="col-md-4">
                        <div class="form-group">
                            <label asp-for="BirthCountryId"></label>
                            <select asp-for="BirthCountryId" asp-items="Model.BirthCountries" class="form-control" id="BirthCountryId">
                                <option value="">-- Select Country --</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-group">
                            <label asp-for="BirthStateId"></label>
                            <select asp-for="BirthStateId" class="form-control" id="BirthStateId" disabled>
                                <option value="">-- Select State --</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-group">
                            <label asp-for="BirthCityId"></label>
                            <select asp-for="BirthCityId" class="form-control" id="BirthCityId" disabled>
                                <option value="">-- Select City --</option>
                            </select>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Previous School Tab -->
        <div class="tab-pane fade" id="previous-school" role="tabpanel" aria-labelledby="previous-school-tab">
            <div class="form-group">
                <label asp-for="PreviousSchoolAttended"></label>
                <input asp-for="PreviousSchoolAttended" class="form-control" placeholder="Name of the previous school" />
            </div>
            <div class="row">
                <div class="col-md-6">
                    <div class="form-group">
                        <label asp-for="PreviousSchoolClassId"></label>
                        <select asp-for="PreviousSchoolClassId" asp-items="Model.PreviousSchoolClasses" class="form-control">
                            <option value="">-- Select Class --</option>
                        </select>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label asp-for="PreviousSchoolBoardId"></label>
                        <select asp-for="PreviousSchoolBoardId" asp-items="Model.PreviousSchoolBoards" class="form-control">
                            <option value="">-- Select Board --</option>
                        </select>
                    </div>
                </div>
            </div>
        </div>

        <!-- Additional Info Tab -->
		<div class="tab-pane fade" id="additional" role="tabpanel" aria-labelledby="additional-tab">
			<div class="row">
				<div class="col-md-6">
					<div class="form-group">
						<label asp-for="CategoryId" class="control-label"></label>
						<select asp-for="CategoryId" class="form-control" asp-items="ViewBag.Categories">
							<option value="">-- Select Category --</option>
						</select>
						<span asp-validation-for="CategoryId" class="text-danger"></span>
					</div>
				</div>
			</div>

			<!-- Transport Section -->
			<div class="card mt-3 mb-3">
				<div class="card-header">
					<h5>Transportation Details</h5>
				</div>
				<div class="card-body">
					<div class="row">
						<div class="col-md-6">
							<div class="form-check mb-3">
								<input type="checkbox" asp-for="AvailTransport" class="form-check-input" id="availTransport" />
								<label class="form-check-label" for="availTransport">Available for Transport</label>
							</div>
						</div>
						<div class="col-md-6">
							<div class="form-group">
								<input type="hidden" name="UseTransportFees" value="false" />
								<input type="checkbox" name="UseTransportFees" value="true" id="useTransportFees" />
								<label class="form-check-label" for="useTransportFees">Include Transport Fees</label>
							</div>
						</div>
					</div>
					
					<div class="row transport-fields" style="display: none;">
						<div class="col-md-6">
							<div class="form-group">
								<label asp-for="RouteId"></label>
								<select asp-for="RouteId" asp-items="Model.Routes" class="form-control" id="RouteId">
									<option value="">-- Select Route --</option>
								</select>
								<span asp-validation-for="RouteId" class="text-danger"></span>
							</div>
						</div>
						<div class="col-md-6">
							<div class="form-group">
								<label asp-for="RouteStopDetailsId"></label>
								<select asp-for="RouteStopDetailsId" class="form-control" id="RouteStopDetailsId" disabled>
									<option value="">-- Select Route First --</option>
								</select>
								<span asp-validation-for="RouteStopDetailsId" class="text-danger"></span>
							</div>
						</div>
						<div class="col-md-6">
							<div class="form-group">
								<label asp-for="RoutePickAndDrop"></label>
								<select asp-for="RoutePickAndDrop" class="form-control">
									<option value="true">Both Pickup & Drop</option>
									<option value="false">One Way Only</option>
								</select>
							</div>
						</div>
					</div>
				</div>
			</div>
			
			<div class="form-group">
				<label asp-for="AdditionalNotes"></label>
				<textarea asp-for="AdditionalNotes" class="form-control" rows="4"></textarea>
			</div>
		</div>
    </div>

    <!-- Form Buttons -->
    <div class="form-group mt-4">
        <button type="submit" class="btn btn-primary" id="submitButton">
            <i class="fas fa-save"></i> Save
        </button>
        <a asp-action="Index" class="btn btn-secondary">
            <i class="fas fa-arrow-left"></i> Back to List
        </a>
    </div>
</form>

<!-- Add SweetAlert2 JS -->
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11.0.19/dist/sweetalert2.all.min.js"></script>


@section Styles {
    <style>
        .required:after {
            content: " *";
            color: red;
        }
        .field-validation-error {
            color: #dc3545;
            font-size: 0.875em;
        }
        .input-validation-error {
            border-color: #dc3545;
        }
        .was-validated .form-control:invalid, .form-control.is-invalid {
            border-color: #dc3545;
            padding-right: calc(1.5em + 0.75rem);
            background-image: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 12 12' width='12' height='12' fill='none' stroke='%23dc3545'%3e%3ccircle cx='6' cy='6' r='4.5'/%3e%3cpath stroke-linejoin='round' d='M5.8 3.6h.4L6 6.5z'/%3e%3ccircle cx='6' cy='8.2' r='.6' fill='%23dc3545' stroke='none'/%3e%3c/svg%3e");
            background-repeat: no-repeat;
            background-position: right calc(0.375em + 0.1875rem) center;
            background-size: calc(0.75em + 0.375rem) calc(0.75em + 0.375rem);
        }
    </style>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    
    <script>
        // Initialize tabs (Bootstrap 5)
        document.querySelectorAll('[data-bs-toggle="tab"]').forEach(function (el) {
            el.addEventListener('shown.bs.tab', function (e) {
                localStorage.setItem('lastTab', e.target.id);
            });
        });

        // Restore last active tab
        var lastTab = localStorage.getItem('lastTab');
        if (lastTab) {
            var tab = new bootstrap.Tab(document.getElementById(lastTab));
            tab.show();
        }

        // Image Preview Function
        function previewImage(input) {
            const preview = document.getElementById('preview');
            const previewContainer = document.getElementById('imagePreview');
            
            if (input.files && input.files[0]) {
                const file = input.files[0];
                const fileSize = file.size / 1024 / 1024; // in MB
                const validTypes = ['image/jpeg', 'image/png', 'image/gif'];
                
                if (!validTypes.includes(file.type)) {
                    alert('Please select a valid image file (JPEG, PNG, GIF)');
                    input.value = '';
                    return;
                }
                
                if (fileSize > 5) {
                    alert('File size exceeds 5MB');
                    input.value = '';
                    return;
                }
                
                const reader = new FileReader();
                reader.onload = function(e) {
                    preview.src = e.target.result;
                    previewContainer.style.display = 'block';
                }
                reader.readAsDataURL(file);
            }
        }

		// Transport fields toggle
		function toggleTransportFields() {
			if ($('#availTransport').is(':checked')) {
				$('.transport-fields').show();
				$('#RouteId').prop('disabled', false);
				$('#RouteStopDetailsId').prop('disabled', false);
			} else {
				$('.transport-fields').hide();
				$('#RouteId').prop('disabled', true);
				$('#RouteStopDetailsId').prop('disabled', true);
			}
		}

		// Initialize transport fields
		toggleTransportFields();

		// Bind change event
		$('#availTransport').change(toggleTransportFields);

		// Load route stops when route changes
		$('#RouteId').change(function() {
			var routeId = $(this).val();
			var $stopSelect = $('#RouteStopDetailsId');
			
			$stopSelect.empty().prop('disabled', true);
			
			if (routeId) {
				$stopSelect.append($('<option>', {
					value: '',
					text: 'Loading stops...'
				}));

				// Replace with your actual endpoint to get stops
				$.getJSON(`/api/transport/getstops?routeId=${routeId}`, function(data) {
					$stopSelect.empty().append($('<option>', {
						value: '',
						text: '-- Select Stop --'
					}));
					
					if (data && data.length > 0) {
						$.each(data, function(i, stop) {
							$stopSelect.append($('<option>', {
								value: stop.id,
								text: stop.name
							}));
						});
					}
					
					$stopSelect.prop('disabled', false);
				}).fail(function() {
					$stopSelect.empty().append($('<option>', {
						value: '',
						text: 'Error loading stops'
					}));
				});
			} else {
				$stopSelect.append($('<option>', {
					value: '',
					text: '-- Select Route First --'
				}));
			}
		});
		
        // Form validation
        (function () {
            'use strict';
            var forms = document.querySelectorAll('.needs-validation');
            Array.prototype.slice.call(forms).forEach(function (form) {
                form.addEventListener('submit', function (event) {
                    if (!form.checkValidity()) {
                        event.preventDefault();
                        event.stopPropagation();
                    } else {
                        // Disable submit button and show loading state
                        const submitButton = document.getElementById('submitButton');
                        submitButton.disabled = true;
                        submitButton.innerHTML = '<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span> Saving...';
                    }
                    form.classList.add('was-validated');
                }, false);
            });
        })();

        // Handle form submission
        $(document).ready(function() {
			// Initialize form validation
            var $form = $('#studentForm');
            var $loadingOverlay = $('#loadingOverlay');
            var $submitButton = $('#submitButton');
            var originalButtonText = $submitButton.html();

            // Initialize validation
            $form.validate({
                ignore: ':hidden:not(.validate-required)',
                errorElement: 'span',
                errorClass: 'text-danger',
                highlight: function(element, errorClass) {
                    $(element).addClass('is-invalid');
                },
                unhighlight: function(element, errorClass) {
                    $(element).removeClass('is-invalid');
                },
                errorPlacement: function(error, element) {
                    error.addClass('invalid-feedback d-block');
                    error.insertAfter(element);
                },
                submitHandler: function(form) {
                    // Show loading overlay
                    $loadingOverlay.show();
                    $('body').addClass('overflow-hidden');
                    
                    // Disable submit button and show loading state
                    $submitButton.prop('disabled', true).html('<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span> Saving...');

                    // Create FormData object to handle file uploads
                    var formData = new FormData(form);

                    $.ajax({
                        url: $form.attr('action'),
                        type: 'POST',
                        data: formData,
                        processData: false,
                        contentType: false,
                        success: function(response) {
                            if (response.success) {
                                // Show success message
                                Swal.fire({
                                    icon: 'success',
                                    title: 'Success!',
                                    text: response.message || 'Student record has been saved successfully.',
                                    showConfirmButton: false,
                                    timer: 2000
                                }).then(function() {
                                    // Redirect to details page or list
                                    window.location.href = response.redirectUrl || '@Url.Action("Index")';
                                });
                            } else {
                                // Show error message
                                showError(response.message || 'An error occurred while saving the student record.');
                            }
                        },
                        error: function(xhr, status, error) {
                            // Handle server-side validation errors
                            if (xhr.status === 400) {
                                var response = xhr.responseJSON;
                                if (response && response.errors) {
                                    // Clear previous errors
                                    $('.field-validation-error').remove();
                                    $('.is-invalid').removeClass('is-invalid');
                                    
                                    // Show validation errors
                                    $.each(response.errors, function(field, messages) {
                                        var $field = $('[name="' + field + '"]');
                                        var $formGroup = $field.closest('.form-group');
                                        if ($formGroup.length === 0) {
                                            $formGroup = $field.closest('.mb-3');
                                        }
                                        var errorHtml = '<span class="text-danger field-validation-error">' + 
                                                      '<span>' + messages.join('<br>') + '</span>' +
                                                      '</span>';
                                        $field.addClass('is-invalid');
                                        $formGroup.append(errorHtml);
                                    });
                                    
                                    // Scroll to first error
                                    $('html, body').animate({
                                        scrollTop: $('.is-invalid').first().offset().top - 100
                                    }, 500);
                                    
                                    showError('Please correct the validation errors.');
                                    return;
                                }
                            }
                            showError('An unexpected error occurred. Please try again.');
                        },
                        complete: function() {
                            // Hide loading overlay
                            $loadingOverlay.hide();
                            $('body').removeClass('overflow-hidden');
                            
                            // Re-enable submit button
                            $submitButton.prop('disabled', false).html(originalButtonText);
                        }
                    });
                    
                    return false; // Prevent normal form submission
                }
            });

            function showError(message) {
                Swal.fire({
                    icon: 'error',
                    title: 'Error!',
                    text: message,
                    confirmButtonText: 'OK'
                });
            }
            // Handle country-state-city cascading
            $('#CountryId, #ParentCountryId, #BirthCountryId').on('change', function() {
                const countryId = $(this).val();
                const prefix = this.id.replace('CountryId', '');
                const $stateDropdown = $(`#${prefix}StateId`);
                const $cityDropdown = $(`#${prefix}CityId`);
                
                if (!countryId) {
                    $stateDropdown.empty().append($('<option>', { value: '', text: '-- Select State --' })).prop('disabled', true);
                    $cityDropdown.empty().append($('<option>', { value: '', text: '-- Select City --' })).prop('disabled', true);
                    return;
                }

                // Show loading state
                $stateDropdown.empty().append($('<option>', { value: '', text: 'Loading...' })).prop('disabled', true);
                $cityDropdown.empty().append($('<option>', { value: '', text: '-- Select City --' })).prop('disabled', true);

                // Fetch states
                $.get(`/StudentMaster/GetStatesByCountry/${countryId}`, function(states) {
                    $stateDropdown.empty().append($('<option>', { value: '', text: '-- Select State --' }));
                    $.each(states, function(i, state) {
                        $stateDropdown.append($('<option>', {
                            value: state.value,
                            text: state.text
                        }));
                    });
                    $stateDropdown.prop('disabled', false);
                }).fail(function() {
                    alert('Error loading states. Please try again.');
                    $stateDropdown.empty().append($('<option>', { value: '', text: '-- Select State --' })).prop('disabled', true);
                });
            });

            // Handle state change to load cities
            $('body').on('change', '#StateId, #ParentStateId, #BirthStateId', function() {
                const stateId = $(this).val();
                const prefix = this.id.replace('StateId', '');
                const $cityDropdown = $(`#${prefix}CityId`);

                if (!stateId) {
                    $cityDropdown.empty().append($('<option>', { value: '', text: '-- Select City --' })).prop('disabled', true);
                    return;
                }

                // Show loading state
                $cityDropdown.empty().append($('<option>', { value: '', text: 'Loading...' })).prop('disabled', true);

                // Fetch cities
                $.get(`/StudentMaster/GetCitiesByState/${stateId}`, function(cities) {
                    $cityDropdown.empty().append($('<option>', { value: '', text: '-- Select City --' }));
                    $.each(cities, function(i, city) {
                        $cityDropdown.append($('<option>', {
                            value: city.value,
                            text: city.text
                        }));
                    });
                    $cityDropdown.prop('disabled', false);
                }).fail(function() {
                    alert('Error loading cities. Please try again.');
                    $cityDropdown.empty().append($('<option>', { value: '', text: '-- Select City --' })).prop('disabled', true);
                });
            });

            // Handle class change to load sections
            $('#ClassId').on('change', function() {
                const classId = $(this).val();
                const $sectionDropdown = $('#SectionId');

                if (!classId) {
                    $sectionDropdown.empty().append($('<option>', { value: '', text: '-- Select Section --' })).prop('disabled', true);
                    return;
                }

                // Show loading state
                $sectionDropdown.empty().append($('<option>', { value: '', text: 'Loading...' })).prop('disabled', true);

                // Fetch sections
                $.get(`/StudentMaster/GetSectionsByClass/${classId}`, function(sections) {
                    $sectionDropdown.empty().append($('<option>', { value: '', text: '-- Select Section --' }));
                    $.each(sections, function(i, section) {
                        $sectionDropdown.append($('<option>', {
                            value: section.value,
                            text: section.text
                        }));
                    });
                    $sectionDropdown.prop('disabled', false);
                }).fail(function() {
                    alert('Error loading sections. Please try again.');
                    $sectionDropdown.empty().append($('<option>', { value: '', text: '-- Select Section --' })).prop('disabled', true);
                });
            });

            // Initialize any existing values
            if ($('#CountryId').val()) {
                $('#CountryId').trigger('change');
                setTimeout(() => {
                    if ($('#StateId').val()) {
                        $('#StateId').trigger('change');
                    }
                }, 500);
            }

            if ($('#ParentCountryId').val()) {
                $('#ParentCountryId').trigger('change');
                setTimeout(() => {
                    if ($('#ParentStateId').val()) {
                        $('#ParentStateId').trigger('change');
                    }
                }, 500);
            }

            if ($('#BirthCountryId').val()) {
                $('#BirthCountryId').trigger('change');
                setTimeout(() => {
                    if ($('#BirthStateId').val()) {
                        $('#BirthStateId').trigger('change');
                    }
                }, 500);
            }

            if ($('#ClassId').val()) {
                $('#ClassId').trigger('change');
            }
        });
    </script>
}