				{
					<span class="text-muted">N/A</span>
				}
			</dd>
			<dt class="col-sm-3">State</dt>
			<dd class="col-sm-9">
				@if (Model.ParentStateId.HasValue)
				{
					@(Model.ParentStates?.FirstOrDefault(x => x.Value == Model.ParentStateId.Value.ToString())?.Text ?? "N/A")
				}
				else
				{
					<span class="text-muted">N/A</span>
				}
			</dd>
			<dt class="col-sm-3">City</dt>
			<dd class="col-sm-9">
				@if (Model.ParentCityId.HasValue)
				{
					@(Model.ParentCities?.FirstOrDefault(x => x.Value == Model.ParentCityId.Value.ToString())?.Text ?? "N/A")
