				{
					@ViewBag.ReligionName @* <small class="text-muted">(ID: @(Model.ReligionId != Guid.Empty ? Model.ReligionId.ToString() : "N/A"))</small> *@
				}
				else if (Model.ReligionId != Guid.Empty)
				{
					@((Model.Religions?.FirstOrDefault(x => x.Value == Model.ReligionId.ToString())?.Text) ?? "N/A") @* <small class="text-muted">(ID: @Model.ReligionId.ToString())</small> *@
				}
				else
				{
					<span class="text-muted">N/A</span>
				}
			</dd>
			<dt class="col-sm-3">Disability</dt>
			<dd class="col-sm-9">
				@if (!string.IsNullOrEmpty(Model.DisabilityAny))
				{
					@Model.DisabilityAny
				}
				else
				{
					<span class="text-muted">N/A</span>
				}
			</dd>
			<dt class="col-sm-3">Medical Allergy</dt>
			<dd class="col-sm-9">
				@if (!string.IsNullOrEmpty(Model.MedicalAlleryAny))
				{
					@Model.MedicalAlleryAny
				}
				else
				{
					<span class="text-muted">N/A</span>
				}
			</dd>
			<dt class="col-sm-3">Birth Country</dt>
			<dd class="col-sm-9">
				@if (!string.IsNullOrEmpty(ViewBag.BirthCountryName as string))
				{
					@ViewBag.BirthCountryName @* <small class="text-muted">(ID: @(Model.BirthCountryId != Guid.Empty ? Model.BirthCountryId.ToString() : "N/A"))</small> *@
				}
				else if (Model.BirthCountryId != Guid.Empty)
				{
					@((Model.BirthCountries?.FirstOrDefault(x => x.Value == Model.BirthCountryId.ToString())?.Text) ?? "N/A") @* <small class="text-muted">(ID: @Model.BirthCountryId.ToString())</small> *@
				}
				else
				{
					<span class="text-muted">N/A</span>
				}
			</dd>
			<dt class="col-sm-3">Birth State</dt>
			<dd class="col-sm-9">
				@if (!string.IsNullOrEmpty(ViewBag.BirthStateName as string))
				{
					@ViewBag.BirthStateName @* <small class="text-muted">(ID: @(Model.BirthStateId != Guid.Empty ? Model.BirthStateId.ToString() : "N/A"))</small> *@
				}
				else if (Model.BirthStateId != Guid.Empty)
				{
					@((Model.BirthStates?.FirstOrDefault(x => x.Value == Model.BirthStateId.ToString())?.Text) ?? "N/A") @* <small class="text-muted">(ID: @Model.BirthStateId.ToString())</small> *@
				}
				else
				{
					<span class="text-muted">N/A</span>
				}
			</dd>
			<dt class="col-sm-3">Birth City</dt>
			<dd class="col-sm-9">
				@if (!string.IsNullOrEmpty(ViewBag.BirthCityName as string))
				{
					@ViewBag.BirthCityName @* <small class="text-muted">(ID: @(Model.BirthCityId != Guid.Empty ? Model.BirthCityId.ToString() : "N/A"))</small> *@
				}
				else if (Model.BirthCityId != Guid.Empty)
				{
					@((Model.BirthCities?.FirstOrDefault(x => x.Value == Model.BirthCityId.ToString())?.Text) ?? "N/A") @* <small class="text-muted">(ID: @Model.BirthCityId.ToString())</small> *@
				}
				else
				{
					<span class="text-muted">N/A</span>
				}
			</dd>
		</dl>
	</div>

	<!-- Previous School Tab -->
	<div class="tab-pane fade" id="previous-school" role="tabpanel" aria-labelledby="previous-school-tab">
		<dl class="row">
			<dt class="col-sm-3">Previous School</dt>
			<dd class="col-sm-9">
				@if (!string.IsNullOrEmpty(Model.PreviousSchoolAttended))
