	</div>

	<!-- Academic Details Tab -->
	<div class="tab-pane fade" id="academic" role="tabpanel" aria-labelledby="academic-tab">
		<dl class="row">
			<dt class="col-sm-3">Class</dt>
			<dd class="col-sm-9">
				@{
					var className = ViewBag.ClassName as string;
					if (string.IsNullOrEmpty(className) && Model.ClassId != Guid.Empty)
					{
						className = Model.Classes?.FirstOrDefault(x => x.Value == Model.ClassId.ToString())?.Text;
					}
				}
				@if (!string.IsNullOrEmpty(className))
				{
					@className
				}
				else
				{
					<span class="text-muted">N/A</span>
				}
				@* <small class="text-muted">(ID: @(ViewBag.ClassId != null ? ViewBag.ClassId.ToString() : (Model.ClassId != Guid.Empty ? Model.ClassId.ToString() : "N/A")))</small> *@
			</dd>
			<dt class="col-sm-3">Section</dt>
			<dd class="col-sm-9">
				@{
					var sectionName = ViewBag.SectionName as string;
					if (string.IsNullOrEmpty(sectionName) && Model.SectionId != Guid.Empty)
					{
						sectionName = Model.Sections?.FirstOrDefault(x => x.Value == Model.SectionId.ToString())?.Text;
					}
				}
				@if (!string.IsNullOrEmpty(sectionName))
				{
					@sectionName
				}
				else
				{
					<span class="text-muted">N/A</span>
				}
				@* <small class="text-muted">(ID: @(ViewBag.SectionId != null ? ViewBag.SectionId.ToString() : (Model.SectionId != Guid.Empty ? Model.SectionId.ToString() : "N/A")))</small> *@
			</dd>
			<dt class="col-sm-3">Roll Number</dt>
			<dd class="col-sm-9">
				@if (Model.RollNumber != Guid.Empty)
				{
					@Model.RollNumber
				}
				else
				{
					<span class="text-muted">N/A</span>
				}
			</dd>
			<dt class="col-sm-3">Registration Number</dt>
			<dd class="col-sm-9">
				@if (!string.IsNullOrEmpty(Model.RegistrationNumber))
				{
					@Model.RegistrationNumber
				}
				else
				{
					<span class="text-muted">N/A</span>
				}
			</dd>
			<dt class="col-sm-3">DOJ</dt>
			<dd class="col-sm-9">
				@if (Model.DOJ != default(DateTime))
				{
					@Model.DOJ.ToString("yyyy-MM-dd")
				}
				else
				{
					<span class="text-muted">N/A</span>
				}
			</dd>
			<dt class="col-sm-3">Class Teacher</dt>
			<dd class="col-sm-9">
				@{
					var teacherName = ViewBag.ClassTeacherName as string;
					if (string.IsNullOrEmpty(teacherName) && Model.ClassTeacherId.HasValue)
					{
						teacherName = Model.ClassTeachers?.FirstOrDefault(x => x.Value == Model.ClassTeacherId.Value.ToString())?.Text;
					}
				}
				@if (!string.IsNullOrEmpty(teacherName))
				{
					@teacherName
				}
				else if (Model.ClassTeacherId.HasValue)
				{
					<span class="text-muted">ID: @Model.ClassTeacherId.Value.ToString()</span>
				}
				else
				{
					<span class="text-muted">N/A</span>
				}
			</dd>
		</dl>
	</div>

	<!-- Medical & Background Tab -->
	<div class="tab-pane fade" id="medical" role="tabpanel" aria-labelledby="medical-tab">
		<dl class="row">
			<dt class="col-sm-3">Blood Group</dt>
			<dd class="col-sm-9">
				@if (!string.IsNullOrEmpty(ViewBag.BloodGroupName as string))
				{
					@ViewBag.BloodGroupName @* <small class="text-muted">(ID: @(Model.BloodGroupId != Guid.Empty ? Model.BloodGroupId.ToString() : "N/A"))</small> *@
				}
				else if (Model.BloodGroupId != Guid.Empty)
				{
					@((Model.BloodGroups?.FirstOrDefault(x => x.Value == Model.BloodGroupId.ToString())?.Text) ?? "N/A") @* <small class="text-muted">(ID: @Model.BloodGroupId.ToString())</small> *@
				}
				else
				{
					<span class="text-muted">N/A</span>
				}
			</dd>
			<dt class="col-sm-3">Nationality</dt>
			<dd class="col-sm-9">
				@if (!string.IsNullOrEmpty(ViewBag.NationalityName as string))
				{
					@ViewBag.NationalityName @* <small class="text-muted">(ID: @(Model.Nationality != Guid.Empty ? Model.Nationality.ToString() : "N/A"))</small> *@
				}
				else if (Model.Nationality != Guid.Empty)
				{
					@((Model.Nationalities?.FirstOrDefault(x => x.Value == Model.Nationality.ToString())?.Text) ?? "N/A") @* <small class="text-muted">(ID: @Model.Nationality.ToString())</small> *@
