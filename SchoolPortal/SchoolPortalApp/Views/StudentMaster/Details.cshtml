@model SchoolPortalApp.Models.StudentViewModel
@{
	ViewData["Title"] = "Student Details";
}
<h2>Student Details</h2>

<ul class="nav nav-tabs" id="studentTabs" role="tablist">
	<li class="nav-item" role="presentation">
		<button class="nav-link active" id="basic-tab" data-bs-toggle="tab" data-bs-target="#basic" type="button" role="tab" aria-controls="basic" aria-selected="true">Basic Information</button>
	</li>
	<li class="nav-item" role="presentation">
		<button class="nav-link" id="address-tab" data-bs-toggle="tab" data-bs-target="#address" type="button" role="tab" aria-controls="address" aria-selected="false">Address & Contact</button>
	</li>
	<li class="nav-item" role="presentation">
		<button class="nav-link" id="parents-tab" data-bs-toggle="tab" data-bs-target="#parents" type="button" role="tab" aria-controls="parents" aria-selected="false">Parents</button>
	</li>
	<li class="nav-item" role="presentation">
		<button class="nav-link" id="academic-tab" data-bs-toggle="tab" data-bs-target="#academic" type="button" role="tab" aria-controls="academic" aria-selected="false">Academic Details</button>
	</li>
	<li class="nav-item" role="presentation">
		<button class="nav-link" id="medical-tab" data-bs-toggle="tab" data-bs-target="#medical" type="button" role="tab" aria-controls="medical" aria-selected="false">Medical & Background</button>
	</li>
	<li class="nav-item" role="presentation">
		<button class="nav-link" id="previous-school-tab" data-bs-toggle="tab" data-bs-target="#previous-school" type="button" role="tab" aria-controls="previous-school" aria-selected="false">Previous School</button>
	</li>
	<li class="nav-item" role="presentation">
		<button class="nav-link" id="additional-tab" data-bs-toggle="tab" data-bs-target="#additional" type="button" role="tab" aria-controls="additional" aria-selected="false">Additional Info</button>
	</li>
	
	
</ul>

<div class="tab-content p-3 border border-top-0 rounded-bottom" id="studentTabsContent">
	<!-- Basic Information Tab -->
	<div class="tab-pane fade show active" id="basic" role="tabpanel" aria-labelledby="basic-tab">
		<dl class="row">
			<dt class="col-sm-3">First Name</dt><dd class="col-sm-9">@Model.FirstName</dd>
			<dt class="col-sm-3">Last Name</dt><dd class="col-sm-9">@Model.LastName</dd>
			<dt class="col-sm-3">Date of Birth</dt><dd class="col-sm-9">@Model.DOB.ToString("yyyy-MM-dd")</dd>
			<dd class="col-sm-9">@(Model.Gender.HasValue && Model.Genders != null ? Model.Genders.FirstOrDefault(x => x.Value == Model.Gender.Value.ToString())?.Text ?? "N/A" : "N/A")</dd>
			<dt class="col-sm-3">Email</dt><dd class="col-sm-9">@Model.Email</dd>
			<dt class="col-sm-3">Phone</dt><dd class="col-sm-9">@Model.Phone</dd>
			<dt class="col-sm-3">Image</dt><dd class="col-sm-9">
				@if (!string.IsNullOrEmpty(Model.Image))
				{
					<img src="@Model.Image" alt="Student Image" class="img-thumbnail" style="max-width: 200px; max-height: 200px;" />
				}
				else
				{
					<span class="text-muted">No image available</span>
				}
			</dd>
		</dl>
	</div>

	<!-- Address & Contact Tab -->
	<div class="tab-pane fade" id="address" role="tabpanel" aria-labelledby="address-tab">
		<dl class="row">
			<dt class="col-sm-3">Address</dt>
			<dd class="col-sm-9">
				@if (!string.IsNullOrEmpty(Model.Address))
				{
					@Model.Address
				}
				else
				{
					<span class="text-muted">N/A</span>
				}
			</dd>
			<dt class="col-sm-3">Country</dt>
			<dd class="col-sm-9">
				@{
					var countryName = ViewBag.CountryName as string;
					if (string.IsNullOrEmpty(countryName) && Model.CountryId != Guid.Empty)
					{
						countryName = Model.Countries?.FirstOrDefault(x => x.Value == Model.CountryId.ToString())?.Text;
					}
				}
				@if (!string.IsNullOrEmpty(countryName))
				{
					@countryName
				}
				else
				{
					<span class="text-muted">N/A</span>
				}
				@* <small class="text-muted">(ID: @(ViewBag.CountryId != null ? ViewBag.CountryId.ToString() : (Model.CountryId != Guid.Empty ? Model.CountryId.ToString() : "N/A")))</small> *@
			</dd>
			<dt class="col-sm-3">State</dt>
			<dd class="col-sm-9">
				@{
					var stateName = ViewBag.StateName as string;
					if (string.IsNullOrEmpty(stateName) && Model.StateId != Guid.Empty)
					{
						stateName = Model.States?.FirstOrDefault(x => x.Value == Model.StateId.ToString())?.Text;
					}
				}
				@if (!string.IsNullOrEmpty(stateName))
				{
					@stateName
				}
				else
				{
					<span class="text-muted">N/A</span>
				}
				@* <small class="text-muted">(ID: @(ViewBag.StateId != null ? ViewBag.StateId.ToString() : (Model.StateId != Guid.Empty ? Model.StateId.ToString() : "N/A")))</small> *@
			</dd>
			<dt class="col-sm-3">City</dt>
			<dd class="col-sm-9">
				@{
					var cityName = ViewBag.CityName as string;
					if (string.IsNullOrEmpty(cityName) && Model.CityId != Guid.Empty)
					{
						cityName = Model.Cities?.FirstOrDefault(x => x.Value == Model.CityId.ToString())?.Text;
					}
				}
				@if (!string.IsNullOrEmpty(cityName))
				{
					@cityName
				}
				else
				{
					<span class="text-muted">N/A</span>
				}
				@* <small class="text-muted">(ID: @(ViewBag.CityId != null ? ViewBag.CityId.ToString() : (Model.CityId != Guid.Empty ? Model.CityId.ToString() : "N/A")))</small> *@
			</dd>
			<dt class="col-sm-3">Zip Code</dt>
			<dd class="col-sm-9">
				@if (!string.IsNullOrEmpty(Model.ZipCode))
				{
					@Model.ZipCode
				}
				else
				{
					<span class="text-muted">N/A</span>
				}
			</dd>
			<dt class="col-sm-3">Contact Number</dt>
			<dd class="col-sm-9">
				@if (!string.IsNullOrEmpty(Model.ContactNumber))
				{
					@Model.ContactNumber
				}
				else
				{
					<span class="text-muted">N/A</span>
				}
			</dd>
			<dt class="col-sm-3">Emergency Contact</dt>
			<dd class="col-sm-9">
				@if (!string.IsNullOrEmpty(Model.EmergencyContactNumber))
				{
					@Model.EmergencyContactNumber
				}
				else
				{
					<span class="text-muted">N/A</span>
				}
			</dd>
		</dl>
	</div>

	<!-- Parents Tab -->
	<div class="tab-pane fade" id="parents" role="tabpanel" aria-labelledby="parents-tab">
		<dl class="row">
			<dt class="col-sm-3">Parent First Name</dt>
