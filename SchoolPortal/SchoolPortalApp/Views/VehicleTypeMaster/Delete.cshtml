@{
	ViewData["Title"] = "Delete Vehicle Type";
}
<h2>Delete Vehicle Type</h2>
<h5>Are you sure you want to delete this vehicle type?</h5>
<div class="mb-3">
	<strong>@Model.VehicleType</strong>
</div>
<div class="mb-3">
	<strong>Company:</strong> @Model.CompanyName
</div>
<div class="mb-3">
	<strong>School:</strong> @Model.SchoolName
</div>
<form asp-action="Delete" method="post">
	@Html.AntiForgeryToken()
	<input type="hidden" name="id" value="@Model.Id" />
	<button type="submit" class="btn btn-danger">Delete</button>
	<a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>