@{
	ViewData["Title"] = "Vehicle Types";
}
<h2>Vehicle Types</h2>
@if (SchoolPortal.Services.Common.AuthorizedManager.HasPrivilege("Create VehicleType"))
{
	<p>
		<a class="btn btn-primary" asp-controller="VehicleTypeMaster" asp-action="Create">Create New</a>
	</p>
}
<table class="table table-striped">
	<thead>
		<tr>
			<th>Vehicle Type</th>
			<th>Company</th>
			<th>School</th>
			<th>Is Active</th>
			<th></th>
		</tr>
	</thead>
	<tbody>
	@foreach (var item in Model)
	{
		<tr>
			<td>@item.VehicleType</td>
			<td>@item.CompanyName</td>
			<td>@item.SchoolName</td>
			<td>@item.IsActive</td>
			<td>
				<a asp-action="Details" asp-route-id="@item.Id"class="btn btn-info" title="View Details">
				<i class="bi bi-eye"></i></a> |
				<a asp-action="Edit" asp-route-id="@item.Id"class="btn btn-warning" title="Edit">
				<i class="bi bi-pencil"></i></a> |
				<a asp-action="Delete" asp-route-id="@item.Id"class="btn btn-danger" title="Delete">
				<i class="bi bi-trash"></i></a>
			</td>			
		</tr>
	}
	</tbody>
</table>