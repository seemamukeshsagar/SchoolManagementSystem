@{
	ViewData["Title"] = "Delete Vehicle Expense";
}
<h2>Delete Vehicle Expense</h2>
<h5>Are you sure you want to delete this vehicle expense?</h5>
<div class="mb-3">
	<strong>Name:</strong> @Model.Name
</div>
<div class="mb-3">
	<strong>Vehicle:</strong> @Model.VehicleNumber
</div>
<div class="mb-3">
	<strong>Vehicle Type:</strong> @Model.VehicleType
</div>
<div class="mb-3">
	<strong>Expense Amount:</strong> @Model.ExpenseAmount
</div>
<div class="mb-3">
	<strong>Company:</strong> @Model.CompanyName
</div>
<div class="mb-3">
	<strong>School:</strong> @Model.SchoolName
</div>
<form asp-action="Delete" method="post">
	@Html.AntiForgeryToken()
	<input type="hidden" name="id" value="@Model.Id" />
	<button type="submit" class="btn btn-danger">Delete</button>
	<a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>