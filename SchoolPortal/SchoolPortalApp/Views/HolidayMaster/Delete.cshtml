@model SchoolPortal.Entities.Models.HolidayMaster
@{
	ViewData["Title"] = "Delete Holiday";
}
<h2>Delete Holiday</h2>
<h3>Are you sure you want to delete this?</h3>
<div>
	<h4>@Model.Name</h4>
	<hr />
	<dl class="row">
		<dt class="col-sm-2">From</dt>
		<dd class="col-sm-10">@Model.FromDate.ToString("yyyy-MM-dd")</dd>
		<dt class="col-sm-2">To</dt>
		<dd class="col-sm-10">@Model.ToDate.ToString("yyyy-MM-dd")</dd>
	</dl>
	<form asp-action="Delete" method="post">
		<input type="hidden" asp-for="Id" />
		<button type="submit" class="btn btn-danger">Delete</button>
		<a asp-action="Index" class="btn btn-secondary">Cancel</a>
	</form>
</div>
