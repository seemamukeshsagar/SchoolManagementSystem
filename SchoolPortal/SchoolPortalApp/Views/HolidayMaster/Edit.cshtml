@model SchoolPortalApp.Models.HolidayViewModel
@{
    ViewData["Title"] = "Edit Holiday";
}
<h2>Edit Holiday</h2>
<form asp-action="Edit" method="post">
    <input type="hidden" asp-for="Id" />
    <div class="form-group">
        <label asp-for="Name"></label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="Description"></label>
        <input asp-for="Description" class="form-control" />
    </div>
    <div class="form-group">
        <label asp-for="TypeId"></label>
        <select asp-for="TypeId" class="form-control" asp-items="Model.HolidayTypes">
            <option value="">-- Select Holiday Type --</option>
        </select>
        <span asp-validation-for="TypeId" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="FromDate"></label>
        <input asp-for="FromDate" type="date" class="form-control" />
    </div>
    <div class="form-group">
        <label asp-for="ToDate"></label>
        <input asp-for="ToDate" type="date" class="form-control" />
    </div>
    <div class="form-group">
        <label asp-for="Year"></label>
        <input asp-for="Year" class="form-control" />
    </div>
    <div class="form-group">
        <label asp-for="SessionId"></label>
        <input asp-for="SessionId" class="form-control" />
    </div>
    <div class="form-group form-check">
        <input asp-for="IsStaffApplicable" class="form-check-input" />
        <label asp-for="IsStaffApplicable" class="form-check-label"></label>
    </div>
    <div class="form-group form-check">
        <input asp-for="IsActive" class="form-check-input" />
        <label asp-for="IsActive" class="form-check-label"></label>
    </div>
    <button type="submit" class="btn btn-primary">Save</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>
