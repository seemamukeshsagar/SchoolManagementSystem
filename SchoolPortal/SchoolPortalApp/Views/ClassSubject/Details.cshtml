<!-- Views/ClassSubject/Details.cshtml -->
@model SchoolPortalApp.Models.ClassSubjectViewModel

@{
	ViewData["Title"] = "Class-Subject Details";
}

<h2>@ViewData["Title"]</h2>

<div>
	<h4>Class-Subject Mapping</h4>
	<hr />
	<dl class="row">
		<dt class="col-sm-2">Class</dt>
		<dd class="col-sm-10">@Model.ClassName</dd>
		
		<dt class="col-sm-2">Subject</dt>
		<dd class="col-sm-10">@Model.SubjectName</dd>
		
		<dt class="col-sm-2">Status</dt>
		<dd class="col-sm-10">@(Model.IsActive ? "Active" : "Inactive")</dd>
	</dl>
</div>
<div>
	<a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Edit</a>
	<a asp-action="Index" class="btn btn-secondary">Back to List</a>
</div>