<!-- Views/ClassSubject/Delete.cshtml -->
@model SchoolPortalApp.Models.ClassSubjectViewModel

@{
    ViewData["Title"] = "Delete Class-Subject Mapping";
}

<h2>@ViewData["Title"]</h2>

<h3>Are you sure you want to delete this?</h3>
<div>
    <h4>Class-Subject Mapping</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">Class</dt>
        <dd class="col-sm-10">@Model.ClassName</dd>
        
        <dt class="col-sm-2">Subject</dt>
        <dd class="col-sm-10">@Model.SubjectName</dd>
        
        <dt class="col-sm-2">Status</dt>
        <dd class="col-sm-10">@(Model.IsActive ? "Active" : "Inactive")</dd>
    </dl>
    
    <form asp-action="DeleteConfirmed">
        <input type="hidden" asp-for="Id" />
        <input type="submit" value="Delete" class="btn btn-danger" />
        <a asp-action="Index" class="btn btn-secondary">Back to List</a>
    </form>
</div>