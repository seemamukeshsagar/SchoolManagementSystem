<!-- Views/ClassSubject/Create.cshtml -->
@model SchoolPortalApp.Models.ClassSubjectViewModel

@{
	ViewData["Title"] = "Create Class-Subject Mapping";
}

<h2>@ViewData["Title"]</h2>

<hr />
<div class="row">
	<div class="col-md-6">
		<form asp-action="Create">
			<div asp-validation-summary="ModelOnly" class="text-danger"></div>
			
			<div class="form-group">
				<label asp-for="ClassMasterId" class="control-label"></label>
				<select asp-for="ClassMasterId" class="form-control" asp-items="Model.Classes">
					<option value="">-- Select Class --</option>
				</select>
				<span asp-validation-for="ClassMasterId" class="text-danger"></span>
			</div>
			
			<div class="form-group">
				<label asp-for="SubjectId" class="control-label"></label>
				<select asp-for="SubjectId" class="form-control" asp-items="Model.Subjects">
					<option value="">-- Select Subject --</option>
				</select>
				<span asp-validation-for="SubjectId" class="text-danger"></span>
			</div>
			
			<div class="form-group form-check">
				<input class="form-check-input" asp-for="IsActive" />
				<label class="form-check-label" asp-for="IsActive"></label>
			</div>
			
			<div class="form-group">
				<input type="submit" value="Create" class="btn btn-primary" />
				<a asp-action="Index" class="btn btn-secondary">Back to List</a>
			</div>
		</form>
	</div>
</div>

@section Scripts {
	@{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}