@model SchoolPortal.Entities.Models.TimeTableSetupDetails
@{
    ViewData["Title"] = "Delete Time Table Setup";
}
<h2>Delete Time Table Setup</h2>
<h3>Are you sure you want to delete this?</h3>

<div>
    <dl class="row">
        <dt class="col-sm-4">School Start Time</dt>
        <dd class="col-sm-8">@Model.SchoolStartTime</dd>
        <dt class="col-sm-4">School End Time</dt>
        <dd class="col-sm-8">@Model.SchoolEndTime</dd>
        <dt class="col-sm-4">Total Periods</dt>
        <dd class="col-sm-8">@Model.TotalPeriods</dd>
        <dt class="col-sm-4">Period Duration</dt>
        <dd class="col-sm-8">@Model.PeriodDuration</dd>
        <dt class="col-sm-4">Recess Duration</dt>
        <dd class="col-sm-8">@Model.RecessDuration</dd>
        <dt class="col-sm-4">Active</dt>
        <dd class="col-sm-8">@Model.IsActive</dd>
    </dl>
</div>

<form asp-action="Delete" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>