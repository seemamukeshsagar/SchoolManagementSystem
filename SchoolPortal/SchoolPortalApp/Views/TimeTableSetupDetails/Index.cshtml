@model IEnumerable<SchoolPortalApp.Models.TimeTableSetupDetailsListItemViewModel>
@{
    ViewData["Title"] = "Time Table Setup";
}
<h2>Time Table Setup</h2>
<p>
    <a asp-action="Create" class="btn btn-primary">Create New</a>
</p>
<table class="table table-striped">
    <thead>
        <tr>
            <th>School Start</th>
            <th>School End</th>
            <th>Total Periods</th>
            <th>Period Duration</th>
            <th>Active</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.SchoolStartTime</td>
            <td>@item.SchoolEndTime</td>
            <td>@item.TotalPeriods</td>
            <td>@item.PeriodDuration</td>
            <td>@(item.IsActive ? "Yes" : "No")</td>
            <td>
                <div class="btn-group btn-group-sm">
                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-info">
                        <i class="bi bi-eye"></i>
                    </a>
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning">
                        <i class="bi bi-pencil"></i>
                    </a>
                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger">
                        <i class="bi bi-trash"></i>
                    </a>
                </div>
            </td>
        </tr>
    }
    </tbody>
</table>