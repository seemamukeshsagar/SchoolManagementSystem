@model IEnumerable<Schoolortal.Entities.Models.CompanyMaster>
@{
    ViewData["Title"] = "Companies";
}
<h2>Companies</h2>
<p>
    <a class="btn btn-primary" asp-controller="Company" asp-action="Create">Create New</a>
</p>
<table class="table table-striped">
    <thead>
        <tr>
            <th>Company Name</th>
            <th>Email</th>
            <th>Is Active</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.CompanyName</td>
            <td>@item.Email</td>
            <td>@item.IsActive</td>
            <td>
                <a asp-action="Details" asp-route-id="@item.Id">Details</a> |
                <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
            </td>
        </tr>
    }
    </tbody>
</table>
