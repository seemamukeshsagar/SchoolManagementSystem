@model IEnumerable<SchoolPortalApp.Models.CompanyListItemViewModel>
@{
	ViewData["Title"] = "Companies";
}
<h2>Companies</h2>
@if (SchoolPortal.Services.Common.AuthorizedManager.HasPrivilege("Create Company"))
{
	@* <p>
		<a class="btn btn-primary" asp-controller="Company" asp-action="Create">Create New</a>
	</p> *@

	<a asp-action="Create" class="btn btn-primary">
		<i class="bi bi-plus-lg"></i> Create New
	</a>
}
<table id="companies-grid" class="table table-striped" data-datatable="true">
	<thead>
		<tr>
			<th>Company Name</th>
			<th>Email</th>
			<th>City</th>
			<th>State</th>
			<th>Country</th>
			<th>Zip Code</th>
			<th>Jurisdiction Area</th>
			<th style="width: 90px;">Est. Year</th>
			<th></th>
		</tr>
		<tr>
			<th><input type="text" class="form-control form-control-sm" placeholder="Search Company" /></th>
			<th><input type="text" class="form-control form-control-sm" placeholder="Search Email" /></th>
			<th><input type="text" class="form-control form-control-sm" placeholder="Search City" /></th>
			<th><input type="text" class="form-control form-control-sm" placeholder="Search State" /></th>
			<th><input type="text" class="form-control form-control-sm" placeholder="Search Country" /></th>
			<th><input type="text" class="form-control form-control-sm" placeholder="Search Zip" /></th>
			<th><input type="text" class="form-control form-control-sm" placeholder="Search Jurisdiction" /></th>
			<th><input type="text" class="form-control form-control-sm" placeholder="Search Year" /></th>
			<th></th>
		</tr>
	</thead>
	<tbody>
	@foreach (var item in Model)
	{
		<tr>
			<td>@item.CompanyName</td>
			<td>@item.Email</td>
			<td>@item.CityName</td>
			<td>@item.StateName</td>
			<td>@item.CountryName</td>
			<td>@item.ZipCode</td>
			<td>@item.JurisdictionAreaName</td>
			<td style="width: 90px;">@item.EstablishmentYear</td>
			<td class="text-nowrap" style="white-space: nowrap;">
				<a asp-action="Details" asp-route-id="@item.Id" class="text-info me-2" title="View Details">
					<i class="bi bi-eye"></i>
				</a>
				<a asp-action="Edit" asp-route-id="@item.Id" class="text-warning me-2" title="Edit">
					<i class="bi bi-pencil"></i>
				</a>
				<a asp-action="Delete" asp-route-id="@item.Id" class="text-danger" title="Delete">
					<i class="bi bi-trash"></i>
				</a>
			</td>			
		</tr>
	}
	</tbody>
</table>
