@model SchoolPortalApp.Models.CompanyDetailsViewModel
@{ 
    ViewData["Title"] = "Company Details";
}
<h2>Company Details</h2>
<div class="mb-3">
    <strong>Name:</strong> @Model.CompanyName
</div>
<div class="mb-3">
    <strong>Email:</strong> @Model.Email
</div>
<div class="mb-3">
    <strong>Active:</strong> @Model.IsActive
</div>
<div class="mb-3">
    <strong>Address:</strong> @Model.Address
</div>
<div class="mb-3">
    <strong>City:</strong> @Model.CityName
</div>
<div class="mb-3">
    <strong>State:</strong> @Model.StateName
</div>
<div class="mb-3">
    <strong>Country:</strong> @Model.CountryName
</div>
<div class="mb-3">
    <strong>Zip:</strong> @Model.ZipCode
</div>
<div class="mb-3">
    <strong>Jurisdiction Area:</strong> @Model.JurisdictionAreaName
</div>
<div class="mb-3">
    <strong>Establishment Year:</strong> @Model.EstablishmentYear
</div>

<p>
    <a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model.Id">Edit</a>
    <a class="btn btn-secondary" asp-action="Index">Back</a>
</p>