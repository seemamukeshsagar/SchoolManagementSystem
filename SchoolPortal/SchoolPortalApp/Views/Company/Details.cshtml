@model SchoolPortal.Entities.Models.CompanyMaster
@{
    ViewData["Title"] = "Company Details";
}
<h2>Company Details</h2>
<div class="mb-3">
    <strong>Name:</strong> @Model.CompanyName
</div>
<div class="mb-3">
    <strong>Email:</strong> @Model.Email
</div>
<div class="mb-3">
    <strong>Active:</strong> @Model.IsActive
</div>
<div class="mb-3">
    <strong>Address:</strong> @Model.Address
</div>
<div class="mb-3">
    <strong>Zip:</strong> @Model.ZipCode
</div>
<p>
    <a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model.Id">Edit</a>
    <a class="btn btn-secondary" asp-action="Index">Back</a>
</p>
