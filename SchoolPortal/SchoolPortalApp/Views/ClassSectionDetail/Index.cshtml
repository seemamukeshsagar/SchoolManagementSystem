@model IEnumerable<ClassSectionDetailListItemViewModel>

@{
	ViewData["Title"] = "Class Section Details";
}

<h2>@ViewData["Title"]</h2>

<p>
	<a asp-action="Create" class="btn btn-primary">Create New</a>
</p>

<table class="table">
	<thead>
		<tr>
			<th>Class</th>
			<th>Section</th>
			<th>Location</th>
			<th>Status</th>
			<th>Actions</th>
		</tr>
	</thead>
	<tbody>
		@foreach (var item in Model)
		{
			<tr>
				<td>@item.ClassName</td>
				<td>@item.SectionName</td>
				<td>@item.LocationName</td>
				<td>
					@if (item.IsActive)
					{
						<span class="badge bg-success">Active</span>
					}
					else
					{
						<span class="badge bg-danger">Inactive</span>
					}
				</td>
				<td>
					<a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info">Details</a>
					<a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Edit</a>
					<button class="btn btn-sm @(item.IsActive ? "btn-danger" : "btn-success")" 
							onclick="toggleStatus('@item.Id', this, @item.IsActive.ToString().ToLower())">
						@(item.IsActive ? "Deactivate" : "Activate")
					</button>
				</td>
			</tr>
		}
	</tbody>
</table>

@section Scripts {
	<script>
		function toggleStatus(id, button, isActive) {
			if (confirm('Are you sure you want to ' + (isActive ? 'deactivate' : 'activate') + ' this class section?')) {
				fetch(`/ClassSectionDetail/ToggleStatus/${id}`, {
					method: 'POST',
					headers: {
						'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
					}
				})
				.then(response => response.json())
				.then(data => {
					if (data.success) {
						// Toggle button text and class
						const newIsActive = !isActive;
						button.textContent = newIsActive ? 'Deactivate' : 'Activate';
						button.classList.toggle('btn-danger', newIsActive);
						button.classList.toggle('btn-success', !newIsActive);
						
						// Update status badge
						const statusBadge = button.closest('tr').querySelector('.badge');
						statusBadge.textContent = newIsActive ? 'Active' : 'Inactive';
						statusBadge.className = 'badge ' + (newIsActive ? 'bg-success' : 'bg-danger');
						
						// Update the onclick handler with the new state
						button.setAttribute('onclick', `toggleStatus('${id}', this, ${!isActive})`);
					} else {
						alert('Failed to update status: ' + (data.message || 'Unknown error'));
					}
				})
				.catch(error => {
					console.error('Error:', error);
					alert('An error occurred while updating the status.');
				});
			}
		}
	</script>
}