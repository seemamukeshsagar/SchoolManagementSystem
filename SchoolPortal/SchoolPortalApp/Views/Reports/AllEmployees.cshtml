@using Microsoft.AspNetCore.Mvc
@using Microsoft.AspNetCore.Mvc.Rendering
@{
    ViewData["Title"] = "All Employees Report";
    Layout = "_Layout";
}

<div class="container-fluid px-4">
    <h1 class="mt-4">All Employees</h1>
    <ol class="breadcrumb mb-4">
        <li class="breadcrumb-item"><a href="/">Dashboard</a></li>
        <li class="breadcrumb-item active">All Employees Report</li>
    </ol>
    
    <div class="card mb-4">
        <div class="card-header">
            <i class="fas fa-table me-1"></i>
            Employee List
        </div>
        <div class="card-body">
            <table id="employeesTable" class="table table-striped table-bordered">
                <thead>
                    <tr>
                        <th>Employee ID</th>
                        <th>Name</th>
                        <th>Department</th>
                        <th>Position</th>
                        <th>Contact</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    <!-- Data will be loaded via AJAX -->
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            $('#employeesTable').DataTable({
                // Configure your DataTable options here
                // Example: serverSide: true,
                // ajax: {
                //     url: '/api/Employees/GetAll',
                //     type: 'GET'
                // }
            });
        });
    </script>
}
