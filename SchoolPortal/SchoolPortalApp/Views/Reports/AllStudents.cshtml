@using Microsoft.AspNetCore.Mvc
@using Microsoft.AspNetCore.Mvc.Rendering
@{
    ViewData["Title"] = "All Students Report";
    Layout = "_Layout";
}

<div class="container-fluid px-4">
    <h1 class="mt-4">All Students</h1>
    <ol class="breadcrumb mb-4">
        <li class="breadcrumb-item"><a href="/">Dashboard</a></li>
        <li class="breadcrumb-item">Reports</li>
        <li class="breadcrumb-item">Students</li>
        <li class="breadcrumb-item active">All Students</li>
    </ol>

    <div class="card mb-4">
        <div class="card-header">
            <i class="fas fa-users me-1"></i>
            Student List
        </div>
        <div class="card-body">
            <div class="row mb-3">
                <div class="col-md-3">
                    <div class="form-group">
                        <label for="classFilter">Class</label>
                        <select class="form-select" id="classFilter">
                            <option value="">All Classes</option>
                            <!-- Will be populated via AJAX -->
                        </select>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="form-group">
                        <label for="sectionFilter">Section</label>
                        <select class="form-select" id="sectionFilter">
                            <option value="">All Sections</option>
                            <!-- Will be populated via AJAX -->
                        </select>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="form-group">
                        <label for="statusFilter">Status</label>
                        <select class="form-select" id="statusFilter">
                            <option value="">All Status</option>
                            <option value="Active">Active</option>
                            <option value="Inactive">Inactive</option>
                            <option value="Graduated">Graduated</option>
                            <option value="Transferred">Transferred</option>
                        </select>
                    </div>
                </div>
                <div class="col-md-3 d-flex align-items-end">
                    <button id="btnFilter" class="btn btn-primary me-2">Filter</button>
                    <button id="btnReset" class="btn btn-secondary">Reset</button>
                </div>
            </div>

            <div class="table-responsive">
                <table id="studentsTable" class="table table-striped table-bordered" style="width:100%">
                    <thead>
                        <tr>
                            <th>Admission No</th>
                            <th>Name</th>
                            <th>Class</th>
                            <th>Section</th>
                            <th>Gender</th>
                            <th>DOB</th>
                            <th>Contact</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        <!-- Data will be loaded via AJAX -->
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            // Initialize DataTable
            var table = $('#studentsTable').DataTable({
                processing: true,
                serverSide: true,
                ajax: {
                    url: '/api/Reports/GetStudents',
                    type: 'POST',
                    data: function (d) {
                        d.classId = $('#classFilter').val();
                        d.sectionId = $('#sectionFilter').val();
                        d.status = $('#statusFilter').val();
                    }
                },
                columns: [
                    { data: 'admissionNo' },
                    { 
                        data: 'fullName',
                        render: function(data, type, row) {
                            return `<a href="/Students/Details/${row.id}">${data}</a>`;
                        }
                    },
                    { data: 'className' },
                    { data: 'sectionName' },
                    { data: 'gender' },
                    { 
                        data: 'dateOfBirth',
                        render: function(data) {
                            return data ? new Date(data).toLocaleDateString() : '';
                        }
                    },
                    { data: 'contactNumber' },
                    { 
                        data: 'status',
                        render: function(data) {
                            var badgeClass = 'bg-secondary';
                            if (data === 'Active') badgeClass = 'bg-success';
                            else if (data === 'Inactive') badgeClass = 'bg-danger';
                            else if (data === 'Graduated') badgeClass = 'bg-info';
                            return `<span class="badge ${badgeClass}">${data}</span>`;
                        }
                    },
                    {
                        data: null,
                        orderable: false,
                        render: function(data, type, row) {
                            return `
                                <div class="btn-group">
                                    <a href="/Students/Details/${row.id}" class="btn btn-sm btn-primary" title="View">
                                        <i class="fas fa-eye"></i>
                                    </a>
                                    <a href="/Students/Edit/${row.id}" class="btn btn-sm btn-warning" title="Edit">
                                        <i class="fas fa-edit"></i>
                                    </a>
                                    <a href="/Reports/PrintStudentIdCard/${row.id}" class="btn btn-sm btn-info" title="Print ID Card" target="_blank">
                                        <i class="fas fa-id-card"></i>
                                    </a>
                                </div>
                            `;
                        }
                    }
                ],
                order: [[0, 'asc']], // Default sort by Admission No
                dom: 'Bfrtip',
                buttons: [
                    'copy', 'csv', 'excel', 'pdf', 'print',
                    {
                        text: 'Export to Excel',
                        action: function (e, dt, node, config) {
                            window.location.href = '/Reports/ExportStudentsToExcel';
                        }
                    },
                    {
                        text: 'Print ID Cards',
                        action: function (e, dt, node, config) {
                            var selected = [];
                            $('input[type="checkbox"]:checked').each(function() {
                                selected.push($(this).val());
                            });
                            
                            if (selected.length === 0) {
                                alert('Please select at least one student');
                                return;
                            }
                            
                            window.open('/Reports/PrintMultipleIdCards?ids=' + selected.join(','), '_blank');
                        }
                    }
                ],
                columnDefs: [
                    {
                        targets: 0,
                        checkboxes: {
                            selectRow: true
                        }
                    }
                ],
                select: {
                    style: 'multi'
                }
            });

            // Load classes for filter
            $.get('/api/Classes/GetAll', function(data) {
                var options = '<option value="">All Classes</option>';
                $.each(data, function(i, item) {
                    options += `<option value="${item.id}">${item.name}</option>`;
                });
                $('#classFilter').html(options);
            });

            // Load sections when class changes
            $('#classFilter').change(function() {
                var classId = $(this).val();
                if (classId) {
                    $.get(`/api/Sections/GetByClass/${classId}`, function(data) {
                        var options = '<option value="">All Sections</option>';
                        $.each(data, function(i, item) {
                            options += `<option value="${item.id}">${item.name}</option>`;
                        });
                        $('#sectionFilter').html(options);
                    });
                } else {
                    $('#sectionFilter').html('<option value="">All Sections</option>');
                }
            });

            // Filter button click handler
            $('#btnFilter').on('click', function() {
                table.ajax.reload();
            });

            // Reset button click handler
            $('#btnReset').on('click', function() {
                $('#classFilter, #sectionFilter, #statusFilter').val('');
                table.ajax.reload();
            });
        });
    </script>
}

<style>
    .dataTables_wrapper .dataTables_filter {
        float: right;
    }
    .dataTables_wrapper .dataTables_paginate {
        float: right;
    }
    .dataTables_wrapper .dataTables_info {
        padding-top: 10px;
    }
    .btn-group .btn {
        margin-right: 5px;
    }
    .badge {
        font-size: 0.85em;
        padding: 0.35em 0.65em;
    }
    table.dataTable tbody td {
        vertical-align: middle;
    }
</style>
