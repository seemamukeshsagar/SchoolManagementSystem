@model SchoolPortalApp.Models.SubjectCategoryViewModel
@{
	ViewData["Title"] = "Edit Subject Category";
}
<h2>Edit Subject Category</h2>
<form asp-action="Edit" method="post">
	@Html.AntiForgeryToken()
	<input type="hidden" asp-for="Id" />
	<div asp-validation-summary="ModelOnly" class="text-danger"></div>

	<div class="mb-3">
		<label asp-for="Name" class="form-label"></label>
		<input asp-for="Name" class="form-control" />
		<span asp-validation-for="Name" class="text-danger"></span>
	</div>

	<div class="mb-3">
		<label asp-for="Description" class="form-label"></label>
		<textarea asp-for="Description" class="form-control"></textarea>
		<span asp-validation-for="Description" class="text-danger"></span>
	</div>

	<div class="mb-3">
		<label asp-for="ParentId" class="form-label"></label>
		<select asp-for="ParentId" asp-items="Model.Parents" class="form-select"></select>
		<span asp-validation-for="ParentId" class="text-danger"></span>
	</div>

	<div class="mb-3">
		<label asp-for="SubjectId" class="form-label"></label>
		<select asp-for="SubjectId" asp-items="Model.Subjects" class="form-select"></select>
		<span asp-validation-for="SubjectId" class="text-danger"></span>
	</div>

	<div class="mb-3">
		<div class="form-check">
			<input asp-for="IsActive" class="form-check-input" />
			<label asp-for="IsActive" class="form-check-label"></label>
		</div>
	</div>

	<button type="submit" class="btn btn-primary">Save</button>
	<a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>
@section Scripts {
	<partial name="_ValidationScriptsPartial" />
}
