@model SchoolPortalApp.Models.RolePrivilege.RolePrivilegeIndexViewModel

@{
	ViewData["Title"] = "Role Privileges";
}

<div class="container-fluid">
	<div class="row mb-3">
		<div class="col-12">
			<h2>@ViewData["Title"]</h2>
		</div>
	</div>

	<div class="card">
		<div class="card-body">
			<div class="row">
				<div class="col-md-4">
					<div class="form-group">
						<label for="roleSelect">Select Role</label>
						<select id="roleSelect" class="form-control">
							<option value="">-- Select a Role --</option>
							@foreach (var role in Model.Roles)
							{
								<option value="@role.Value">@role.Text</option>
							}
						</select>
					</div>
				</div>
				<div class="col-md-8 text-right">
					<button id="viewDetails" class="btn btn-info" disabled>View Details</button>
				</div>
			</div>

			<div class="row mt-3">
				<div class="col-12">
					<div id="privilegesContainer">
						<!-- Privileges will be loaded here via AJAX -->
						<div class="alert alert-info">
							Please select a role to manage its privileges.
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
	
	<!-- Hidden field forAntiForgeryToken -->
	@Html.AntiForgeryToken()
</div>

@section Styles {
	<link rel="stylesheet" type="text/css" href="https://cdn.datatables.net/1.11.5/css/dataTables.bootstrap4.min.css">
}

@section Scripts {
	<!-- DataTables JS -->
	<script src="https://cdn.datatables.net/1.11.5/js/jquery.dataTables.min.js"></script>
	<script src="https://cdn.datatables.net/1.11.5/js/dataTables.bootstrap4.min.js"></script>
	
	<script>
		// Global variable to store the DataTable instance
		var privilegesTable;
		var selectedRoleId = null;
		
		$(document).ready(function() {
			$('#roleSelect').change(function() {
				var roleId = $(this).val();
				selectedRoleId = roleId;
				$('#viewDetails').prop('disabled', !roleId);
				
				if (roleId) {
					loadPrivileges(roleId);
				} else {
					$('#privilegesContainer').html('<div class="alert alert-info">Please select a role to manage its privileges.</div>');
				}
			});
			
			$('#viewDetails').click(function() {
				if (selectedRoleId) {
					window.location.href = '@Url.Action("Details", "RolePrivileges")/' + selectedRoleId;
				}
			});

			function initializeDataTable() {
				if ($.fn.DataTable.isDataTable('#privilegesTable')) {
					privilegesTable.destroy();
				}
				
				privilegesTable = $('#privilegesTable').DataTable({
					paging: true,
					pageLength: 15,
					lengthChange: true,
					lengthMenu: [[10, 15, 25, 50, -1], [10, 15, 25, 50, "All"]],
					searching: true,
					ordering: true,
					info: true,
					autoWidth: false,
					responsive: true,
					order: [], // Disable initial sorting
					stateSave: true, // Save state (page, length, etc.)
					stateDuration: -1, // Use sessionStorage instead of localStorage
					columnDefs: [
						{ orderable: false, targets: 1 }, // Disable sorting on the checkbox column
						{ width: '80%', targets: 0 },
						{ width: '20%', targets: 1 }
					],
					language: {
						search: "Search privileges:",
						lengthMenu: "Show _MENU_ privileges per page",
						info: "Showing _START_ to _END_ of _TOTAL_ privileges",
						infoEmpty: "No privileges found",
						infoFiltered: "(filtered from _MAX_ total privileges)",
						paginate: {
							first: '«',
							previous: '‹',
							next: '›',
							last: '»'
						},
						aria: {
							sortAscending: ": activate to sort column ascending",
							sortDescending: ": activate to sort column descending"
						}
					},
					drawCallback: function() {
						// Re-initialize any custom functionality after table redraw
						initializePrivilegeTree();
					}
				});
			}
			
			function loadPrivileges(roleId) {
				if (!roleId) {
					$('#privilegesContainer').html('<div class="alert alert-warning">Please select a valid role.</div>');
					return;
				}

				$('#privilegesContainer').html('<div class="text-center p-4"><div class="spinner-border text-primary" role="status"><span class="sr-only">Loading privileges...</span></div><p class="mt-2">Loading privileges...</p></div>');
				
				$.ajax({
					url: '@Url.Action("GetPrivileges", "RolePrivileges")/' + roleId,
					type: 'GET',
					dataType: 'html',
					cache: false
				})
				.done(function(data) {
					$('#privilegesContainer').html(data);
					initializeDataTable();
					
					// Add save button functionality
					$('#savePrivileges').off('click').on('click', function() {
						savePrivileges(roleId);
					});
				})
				.fail(function(xhr, status, error) {
					console.error('Error loading privileges:', status, error);
					var errorMsg = 'Error loading privileges. ';
					if (xhr.responseText) {
						try {
							var response = JSON.parse(xhr.responseText);
							errorMsg += response.message || xhr.statusText;
						} catch (e) {
							errorMsg += xhr.statusText;
						}
					}
					$('#privilegesContainer').html('<div class="alert alert-danger">' + errorMsg + '</div>');
				});
			}
			
			function savePrivileges(roleId) {
				// Collect selected privilege IDs
				var selectedPrivilegeIds = [];
				$('.privilege-tree input[type="checkbox"]:checked').each(function() {
					var id = $(this).val();
					if (id) {
						selectedPrivilegeIds.push(id);
					}
				});
				
				var updateModel = {
					RoleId: roleId,
					PrivilegeIds: selectedPrivilegeIds
				};
				
				$.ajax({
					url: '@Url.Action("UpdatePrivileges", "RolePrivileges")',
					type: 'POST',
					contentType: 'application/json',
					data: JSON.stringify(updateModel),
					headers: {
						'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
					}
				})
				.done(function(response) {
					if (response.success) {
						showAlert('success', 'Privileges updated successfully!');
					} else {
						showAlert('danger', 'Failed to update privileges.');
					}
				})
				.fail(function(xhr, status, error) {
					console.error('Error updating privileges:', status, error);
					showAlert('danger', 'Error updating privileges: ' + (xhr.responseText || error));
				});
			}

			function initializePrivilegeTree() {
				// Handle parent checkbox click
				$('.privilege-tree').off('change', '.parent-checkbox').on('change', '.parent-checkbox', function() {
					var parentId = $(this).data('id');
					var isChecked = $(this).is(':checked');
					
					// Update all child checkboxes, including those on other pages
					$('.child-checkbox[data-parent="' + parentId + '"]').prop('checked', isChecked).trigger('change');
					
					// Update the visual indicator
					$('#parent_check_' + parentId).prop('checked', isChecked);
					
					// Save the state in the DataTable
					if (privilegesTable) {
						privilegesTable.draw();
					}
				});
				
				// Handle child checkbox click
				$('.privilege-tree').off('change', '.child-checkbox').on('change', '.child-checkbox', function() {
					updateParentCheckbox(this);
					
					// Save the state in the DataTable
					if (privilegesTable) {
						privilegesTable.draw();
					}
				});
			}
			
			function updateParentCheckbox(childCheckbox) {
				var parentId = $(childCheckbox).data('parent');
				if (!parentId) return;
				
				var allChecked = true;
				var anyChecked = false;
				
				$('.child-checkbox[data-parent="' + parentId + '"]').each(function() {
					if (!$(this).is(':checked')) {
						allChecked = false;
					} else {
						anyChecked = true;
					}
				});
				
				// Update parent checkbox state
				$('#priv_' + parentId).prop('checked', allChecked);
				$('#parent_check_' + parentId).prop('checked', anyChecked);
			}
			
			function updateParentCheckboxes() {
				$('.parent-checkbox').each(function() {
					var parentId = $(this).data('id');
					if (parentId) {
						updateParentCheckbox($('.child-checkbox[data-parent="' + parentId + '"]').first());
					}
				});
			}
			
			function showAlert(type, message) {
				var alertId = 'alert-' + Date.now();
				var alertHtml = '<div id="' + alertId + '" class="alert alert-' + type + ' alert-dismissible fade show" role="alert">' +
					message +
					'<button type="button" class="close" data-dismiss="alert" aria-label="Close">' +
					'<span aria-hidden="true">&times;</span></button></div>';
				
				// Remove any existing alerts and add the new one
				$('.alert-dismissible').alert('close');
				$('#alertContainer').html(alertHtml);
				
				// Auto-dismiss success messages after 5 seconds
				if (type === 'success') {
					setTimeout(function() {
						$('#' + alertId).alert('close');
					}, 5000);
				}
			}
		});
	</script>
}