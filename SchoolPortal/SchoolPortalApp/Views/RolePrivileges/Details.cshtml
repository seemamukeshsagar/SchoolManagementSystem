@model SchoolPortalApp.Models.RolePrivilege.RolePrivilegeDetailsViewModel

@{
    ViewData["Title"] = "Role Privileges Details";
}

<div class="container-fluid">
    <div class="row mb-3">
        <div class="col-12">
            <h2>@ViewData["Title"]</h2>
        </div>
    </div>

    <div class="card">
        <div class="card-header">
            <h4>Role: @Model.RoleName</h4>
        </div>
        <div class="card-body">
            @if (Model.AssignedPrivileges.Any())
            {
                <div class="table-responsive">
                    <table class="table table-bordered table-hover">
                        <thead class="thead-light">
                            <tr>
                                <th>Privilege Name</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var privilege in Model.AssignedPrivileges)
                            {
                                <tr>
                                    <td>@privilege.PrivilegeName</td>
                                    <td>
                                        @if (privilege.IsActive)
                                        {
                                            <span class="badge badge-success">Active</span>
                                        }
                                        else
                                        {
                                            <span class="badge badge-secondary">Inactive</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="alert alert-info">
                    No privileges assigned to this role.
                </div>
            }
        </div>
    </div>

    <div class="row mt-3">
        <div class="col-12">
            <a asp-action="Index" class="btn btn-secondary">Back to List</a>
            <a asp-action="Index" asp-controller="RoleMaster" class="btn btn-primary">Manage Roles</a>
        </div>
    </div>
</div>