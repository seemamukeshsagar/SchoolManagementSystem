@model IEnumerable<SchoolPortal.Services.IServices.PrivilegeAssignmentModel>

@if (Model == null)
{
    <div class="alert alert-danger">Error: Failed to load privileges. Please try again.</div>
    return;
}

@if (!Model.Any())
{
    <div class="alert alert-warning">No privileges found for the selected role.</div>
    return;
}

<div id="alertContainer"></div>

<div class="table-responsive">
    <table id="privilegesTable" class="table table-bordered table-hover" style="width:100%">
        <thead class="thead-light">
            <tr>
                <th>Privilege</th>
                <th class="text-center">Assigned</th>
            </tr>
        </thead>
        <tbody class="privilege-tree">
            @{
                var parentPrivileges = Model.Where(p => p.ParentId == null).OrderBy(p => p.Name).ToList();
                if (!parentPrivileges.Any())
                {
                    <tr>
                        <td colspan="2" class="text-center">No parent privileges found</td>
                    </tr>
                }
                else
                {
                    foreach (var parent in parentPrivileges)
                    {
                        <tr class="table-primary">
                            <td>
                                <div class="form-check">
                                    <input class="form-check-input parent-checkbox" 
                                           type="checkbox" 
                                           id="priv_@parent.Id" 
                                           value="@parent.Id"
                                           data-id="@parent.Id"
                                           @(parent.IsAssigned ? "checked=\"checked\"" : "")>
                                    <label class="form-check-label font-weight-bold" for="priv_@parent.Id">
                                        @parent.Name
                                    </label>
                                </div>
                            </td>
                            <td class="text-center">
                                <div class="custom-control custom-checkbox">
                                    <input type="checkbox" class="custom-control-input" id="parent_check_@parent.Id" disabled @(parent.IsAssigned ? "checked" : "")>
                                    <label class="custom-control-label" for="parent_check_@parent.Id"></label>
                                </div>
                            </td>
                        </tr>
                        
                        var childPrivileges = Model.Where(p => p.ParentId == parent.Id).OrderBy(p => p.Name).ToList();
                        if (childPrivileges.Any())
                        {
                            foreach (var child in childPrivileges)
                            {
                                <tr data-parent-id="@parent.Id">
                                    <td class="pl-4">@child.Name</td>
                                    <td class="text-center">
                                        <div class="custom-control custom-checkbox">
                                            <input type="checkbox" 
                                                   class="custom-control-input child-checkbox" 
                                                   id="child_check_@child.Id" 
                                                   value="@child.Id"
                                                   data-parent="@parent.Id"
                                                   @(child.IsAssigned ? "checked" : "")
                                                   onchange="updateParentCheckbox(this)">
                                            <label class="custom-control-label" for="child_check_@child.Id"></label>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    }
                }
            }
        </tbody>
    </table>
</div>

<div class="text-right mt-3">
    <button id="savePrivileges" class="btn btn-primary">Save Changes</button>
</div>