@model IEnumerable<SchoolPortalApp.Models.TimeTablePeriodMasterListItemViewModel>
@{
    ViewData["Title"] = "Time Table Periods";
}
<h2>Time Table Periods</h2>
<p>
    <a asp-action="Create" class="btn btn-primary">Create New</a>
</p>
<table class="table table-striped">
    <thead>
        <tr>
            <th>Description</th>
            <th>Period</th>
            <th>Start</th>
            <th>End</th>
            <th>Active</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.Description</td>
            <td>@item.PeriodNumber</td>
            <td>@item.StartTime</td>
            <td>@item.EndTime</td>
            <td>@(item.IsActive ? "Yes" : "No")</td>
            <td>
                <div class="btn-group btn-group-sm">
                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-info" title="View Details">
                        <i class="bi bi-eye"></i>
                    </a>
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning" title="Edit">
                        <i class="bi bi-pencil"></i>
                    </a>
                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger" title="Delete">
                        <i class="bi bi-trash"></i>
                    </a>
                </div>
            </td>
        </tr>
    }
    </tbody>
</table>