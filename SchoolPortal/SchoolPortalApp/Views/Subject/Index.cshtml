@model IEnumerable<SchoolPortalApp.Models.SubjectListItemViewModel>
@using Microsoft.AspNetCore.Mvc.Rendering
@{
    ViewData["Title"] = "Subjects";
}
<h2>Subjects</h2>

<form asp-action="Index" method="get" class="form-inline mb-3">
    <div class="form-group mr-2">
        <label for="classId" class="mr-2">Class</label>
        <select id="classId" name="classId" class="form-control">
            <option value="">All</option>
            @if (ViewBag.Classes != null)
            {
                foreach (var cls in (IEnumerable<SelectListItem>)ViewBag.Classes)
				{
					<option value="@cls.Value" selected="@cls.Selected">@cls.Text</option>
				}
            }
        </select>
    </div>
</form>

<p>
    <a asp-action="Create" class="btn btn-primary">Create New</a>
</p>
<table class="table table-striped">
    <thead>
        <tr>
            <th>Class</th>
            <th>Subject Name</th>
            <th>Scholastic</th>
            <th>Active</th>
            <th></th>
        </tr>
    </thead>
    <partial name="_SubjectTable" model="Model" />
</table>