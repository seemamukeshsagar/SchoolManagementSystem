@model SchoolPortal.Entities.Models.SubjectMaster
@{
	ViewData["Title"] = "Subject Details";
}
<h2>Subject Details</h2>
<dl class="row">
	<dt class="col-sm-2">Class</dt>
	<dd class="col-sm-10">@ViewBag.ClassName</dd>
	<dt class="col-sm-2">Subject Name</dt>
	<dd class="col-sm-10">@Model.SubjectName</dd>
	<dt class="col-sm-2">Scholastic</dt>
	<dd class="col-sm-10">@(Model.IsScholastic == true ? "Yes" : "No")</dd>
	<dt class="col-sm-2">Active</dt>
	<dd class="col-sm-10">@(Model.IsActive ? "Yes" : "No")</dd>
</dl>
<p>
	<a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Edit</a>
	<a asp-action="Index" class="btn btn-secondary">Back to List</a>
</p>
