@model SchoolPortal.Entities.Models.SubjectMaster
@{
	ViewData["Title"] = "Delete Subject";
}
<h2>Delete Subject</h2>
<h3>Are you sure you want to delete this?</h3>
<dl class="row">
	<dt class="col-sm-2">Class Name</dt>
	<dd class="col-sm-10">@ViewBag.ClassName</dd>
	<dt class="col-sm-2">Subject Name</dt>
	<dd class="col-sm-10">@Model.SubjectName</dd>
	<dt class="col-sm-2">Scholastic</dt>
	<dd class="col-sm-10">@(Model.IsScholastic == true ? "Yes" : "No")</dd>
	<dt class="col-sm-2">Active</dt>
	<dd class="col-sm-10">@(Model.IsActive ? "Yes" : "No")</dd>
</dl>
<form asp-action="Delete" method="post">
	@Html.AntiForgeryToken()
	<input type="hidden" asp-for="Id" />
	<button type="submit" class="btn btn-danger">Delete</button>
	<a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>
@if (TempData["ErrorMessage"] != null)
{
	<div class="alert alert-danger mt-3">@TempData["ErrorMessage"]</div>
}
