@{
    ViewData["Title"] = "Class Rooms";
}

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h4 class="mb-0">Class Rooms</h4>
        <a asp-controller="ClassRoom" asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-circle me-2"></i>Create New
        </a>
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table id="classRoomsTable" class="table table-striped table-hover">
                <thead class="table-light">
                    <tr>
                        <th>Name</th>
                        <th>Status</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <!-- Data will be loaded via AJAX -->
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="deleteModalLabel">Confirm Delete</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                Are you sure you want to delete this class room?
                <input type="hidden" id="classRoomIdToDelete" />
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-danger" id="confirmDelete">Delete</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            // Initialize DataTable
            var table = $('#classRoomsTable').DataTable({
                processing: true,
                serverSide: true,
                ajax: {
                    url: '@Url.Action("GetClassRoomsData", "ClassRoom")',
                    type: 'POST'
                },
                columns: [
                    { data: 'name' },
                    { 
                        data: 'isActive',
                        render: function (data) {
                            return data 
                                ? '<span class="badge bg-success">Active</span>' 
                                : '<span class="badge bg-secondary">Inactive</span>';
                        }
                    },
                    {
                        data: 'id',
                        orderable: false,
                        render: function (id) {
                            return `
                                <a href="/ClassRoom/Details/${id}" 
                                   class="btn btn-sm btn-outline-info me-1" 
                                   data-bs-toggle="tooltip" 
                                   title="View">
                                    <i class="bi bi-eye"></i>
                                </a>
                                <a href="/ClassRoom/Edit/${id}" 
                                   class="btn btn-sm btn-outline-primary me-1" 
                                   data-bs-toggle="tooltip" 
                                   title="Edit">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <button type="button" 
                                    class="btn btn-sm btn-outline-danger delete-btn" 
                                    data-id="${id}" 
                                    data-bs-toggle="tooltip" 
                                    title="Delete">
                                    <i class="bi bi-trash"></i>
                                </button>
                            `;
                        }
                    }
                ],
                drawCallback: function () {
                    // Re-init Bootstrap tooltips on every table redraw
                    var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
                    tooltipTriggerList.map(function (tooltipTriggerEl) {
                        return new bootstrap.Tooltip(tooltipTriggerEl);
                    });
                }
            });

            // Delete Button Click
            $(document).on('click', '.delete-btn', function () {
                $('#classRoomIdToDelete').val($(this).data('id'));
                $('#deleteModal').modal('show');
            });

            // Confirm Delete
            $('#confirmDelete').click(function () {
                var id = $('#classRoomIdToDelete').val();

                $.ajax({
                    url: '/ClassRoom/Delete/' + id,
                    type: 'POST',
                    success: function () {
                        $('#deleteModal').modal('hide');
                        table.ajax.reload(null, false);
                        showToast('Class room deleted successfully', 'success');
                    },
                    error: function () {
                        showToast('Error deleting class room', 'danger');
                    }
                });
            });

            // Toast Notification
            function showToast(message, type) {
                let toast = document.createElement('div');
                toast.className = `toast align-items-center text-white bg-${type} border-0`;
                toast.style.position = 'fixed';
                toast.style.top = '20px';
                toast.style.right = '20px';
                toast.style.zIndex = '9999';

                toast.innerHTML = `
                    <div class="d-flex">
                        <div class="toast-body">${message}</div>
                        <button type="button" class="btn-close btn-close-white me-2 m-auto" 
                            data-bs-dismiss="toast"></button>
                    </div>
                `;

                document.body.appendChild(toast);
                var bsToast = new bootstrap.Toast(toast);
                bsToast.show();

                toast.addEventListener('hidden.bs.toast', () => toast.remove());
            }
        });
    </script>
}