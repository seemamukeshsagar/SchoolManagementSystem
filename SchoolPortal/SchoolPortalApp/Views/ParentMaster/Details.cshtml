@model SchoolPortal.Entities.ViewModels.ParentMasterViewModel
@{
    ViewData["Title"] = "Parent Details";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-md-8">
            <div class="card">
                <div class="card-header">
                    <h3 class="card-title">Parent Details</h3>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6">
                            <h5>Father Information</h5>
                            <dl class="row">
                                <dt class="col-sm-4">Name</dt>
                                <dd class="col-sm-8">@Html.DisplayFor(model => model.FatherName)</dd>
                                <dt class="col-sm-4">Mobile</dt>
                                <dd class="col-sm-8">@Html.DisplayFor(model => model.FatherMobile)</dd>
                                <dt class="col-sm-4">Email</dt>
                                <dd class="col-sm-8">@Html.DisplayFor(model => model.FatherEmail)</dd>
                                <dt class="col-sm-4">Occupation</dt>
                                <dd class="col-sm-8">@Html.DisplayFor(model => model.FatherOccupation)</dd>
                            </dl>
                        </div>
                        <div class="col-md-6">
                            <h5>Mother Information</h5>
                            <dl class="row">
                                <dt class="col-sm-4">Name</dt>
                                <dd class="col-sm-8">@Html.DisplayFor(model => model.MotherName)</dd>
                                <dt class="col-sm-4">Mobile</dt>
                                <dd class="col-sm-8">@Html.DisplayFor(model => model.MotherMobile)</dd>
                                <dt class="col-sm-4">Email</dt>
                                <dd class="col-sm-8">@Html.DisplayFor(model => model.MotherEmail)</dd>
                                <dt class="col-sm-4">Occupation</dt>
                                <dd class="col-sm-8">@Html.DisplayFor(model => model.MotherOccupation)</dd>
                            </dl>
                        </div>
                    </div>
                    
                    <hr />
                    
                    <dl class="row">
                        <dt class="col-sm-3">
                            @Html.DisplayNameFor(model => model.Address)
                        </dt>
                        <dd class="col-sm-9">
                            @Html.DisplayFor(model => model.Address)
                        </dd>
                        <dt class="col-sm-3">
                            @Html.DisplayNameFor(model => model.IsActive)
                        </dt>
                        <dd class="col-sm-9">
                            @if (Model.IsActive)
                            {
                                <span class="badge badge-success">Active</span>
                            }
                            else
                            {
                                <span class="badge badge-danger">Inactive</span>
                            }
                        </dd>
                        <dt class="col-sm-3">
                            @Html.DisplayNameFor(model => model.CreatedDate)
                        </dt>
                        <dd class="col-sm-9">
                            @Html.DisplayFor(model => model.CreatedDate)
                        </dd>
                        <dt class="col-sm-3">
                            @Html.DisplayNameFor(model => model.ModifiedDate)
                        </dt>
                        <dd class="col-sm-9">
                            @Html.DisplayFor(model => model.ModifiedDate)
                        </dd>
                    </dl>
                </div>
                <div class="card-footer">
                    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">
                        <i class="fas fa-edit"></i> Edit
                    </a>
                    <a asp-action="Index" class="btn btn-secondary">
                        <i class="fas fa-arrow-left"></i> Back to List
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
