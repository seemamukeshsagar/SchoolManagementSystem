@model SchoolPortal.Entities.ViewModels.StudentReportCardMasterViewModel
@{
    ViewData["Title"] = "Report Card Details";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-md-8">
            <div class="card">
                <div class="card-header">
                    <h3 class="card-title">Student Report Card Details</h3>
                </div>
                <div class="card-body">
                    <dl class="row">
                        <dt class="col-sm-3">
                            @Html.DisplayNameFor(model => model.StudentName)
                        </dt>
                        <dd class="col-sm-9">
                            @Html.DisplayFor(model => model.StudentName)
                        </dd>
                        <dt class="col-sm-3">
                            @Html.DisplayNameFor(model => model.ClassName)
                        </dt>
                        <dd class="col-sm-9">
                            @Html.DisplayFor(model => model.ClassName)
                        </dd>
                        <dt class="col-sm-3">
                            @Html.DisplayNameFor(model => model.SectionName)
                        </dt>
                        <dd class="col-sm-9">
                            @Html.DisplayFor(model => model.SectionName)
                        </dd>
                        <dt class="col-sm-3">
                            @Html.DisplayNameFor(model => model.AcademicYearName)
                        </dt>
                        <dd class="col-sm-9">
                            @Html.DisplayFor(model => model.AcademicYearName)
                        </dd>
                        <dt class="col-sm-3">
                            @Html.DisplayNameFor(model => model.ExamType)
                        </dt>
                        <dd class="col-sm-9">
                            @Html.DisplayFor(model => model.ExamType)
                        </dd>
                        <dt class="col-sm-3">
                            @Html.DisplayNameFor(model => model.TotalMarks)
                        </dt>
                        <dd class="col-sm-9">
                            @Html.DisplayFor(model => model.TotalMarks)
                        </dd>
                        <dt class="col-sm-3">
                            @Html.DisplayNameFor(model => model.ObtainedMarks)
                        </dt>
                        <dd class="col-sm-9">
                            @Html.DisplayFor(model => model.ObtainedMarks)
                        </dd>
                        <dt class="col-sm-3">
                            @Html.DisplayNameFor(model => model.Percentage)
                        </dt>
                        <dd class="col-sm-9">
                            @Html.DisplayFor(model => model.Percentage)%
                        </dd>
                        <dt class="col-sm-3">
                            @Html.DisplayNameFor(model => model.Grade)
                        </dt>
                        <dd class="col-sm-9">
                            <span class="badge badge-primary">@Html.DisplayFor(model => model.Grade)</span>
                        </dd>
                        <dt class="col-sm-3">
                            @Html.DisplayNameFor(model => model.Rank)
                        </dt>
                        <dd class="col-sm-9">
                            @Html.DisplayFor(model => model.Rank)
                        </dd>
                        <dt class="col-sm-3">
                            @Html.DisplayNameFor(model => model.Remarks)
                        </dt>
                        <dd class="col-sm-9">
                            @Html.DisplayFor(model => model.Remarks)
                        </dd>
                        <dt class="col-sm-3">
                            @Html.DisplayNameFor(model => model.GeneratedDate)
                        </dt>
                        <dd class="col-sm-9">
                            @Html.DisplayFor(model => model.GeneratedDate)
                        </dd>
                        <dt class="col-sm-3">
                            @Html.DisplayNameFor(model => model.IsActive)
                        </dt>
                        <dd class="col-sm-9">
                            @if (Model.IsActive)
                            {
                                <span class="badge badge-success">Active</span>
                            }
                            else
                            {
                                <span class="badge badge-danger">Inactive</span>
                            }
                        </dd>
                        <dt class="col-sm-3">
                            @Html.DisplayNameFor(model => model.CreatedDate)
                        </dt>
                        <dd class="col-sm-9">
                            @Html.DisplayFor(model => model.CreatedDate)
                        </dd>
                        <dt class="col-sm-3">
                            @Html.DisplayNameFor(model => model.ModifiedDate)
                        </dt>
                        <dd class="col-sm-9">
                            @Html.DisplayFor(model => model.ModifiedDate)
                        </dd>
                    </dl>
                </div>
                <div class="card-footer">
                    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">
                        <i class="fas fa-edit"></i> Edit
                    </a>
                    <a asp-action="Index" class="btn btn-secondary">
                        <i class="fas fa-arrow-left"></i> Back to List
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
