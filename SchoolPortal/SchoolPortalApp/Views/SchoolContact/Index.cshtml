@model IEnumerable<SchoolPortal.Entities.Models.SchoolContactMaster>
@{
	ViewData["Title"] = "School Contacts";
}
<h2>School Contacts</h2>
<p>
	<a asp-action="Create" class="btn btn-primary">Create New</a>
</p>
<table class="table table-striped">
	<thead>
		<tr>
			<th>Name</th>
			<th>Email</th>
			<th>Phone</th>
			<th>Mobile</th>
			<th>Active</th>
			<th></th>
		</tr>
	</thead>
	<tbody>
	@foreach (var item in Model)
	{
		<tr>
			<td>@(item.FirstName + (string.IsNullOrWhiteSpace(item.LastName) ? "" : (" " + item.LastName)))</td>
			<td>@item.Email</td>
			<td>@item.Phone</td>
				<td>@item.MobilePhone</td>
			<td>@item.IsActive</td>
			<td>
					<div class="btn-group btn-group-sm">
						<a asp-action="Details" asp-route-id="@item.Id" class="btn btn-info" title="View Details">
							<i class="bi bi-eye"></i>
						</a>
						<a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning" title="Edit">
							<i class="bi bi-pencil"></i>
						</a>
						<a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger" title="Delete">
							<i class="bi bi-trash"></i>
						</a>
					</div>
			</td>
		</tr>
	}
	</tbody>
</table>
