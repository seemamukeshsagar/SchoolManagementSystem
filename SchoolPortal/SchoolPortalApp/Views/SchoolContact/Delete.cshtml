@model SchoolPortal.Entities.Models.SchoolContactMaster
@{
    ViewData["Title"] = "Delete School Contact";
}
<h2>Delete School Contact</h2>
<h4>Are you sure you want to delete this contact?</h4>
<div>
    <dl class="row">
        <dt class="col-sm-2">School</dt>
        <dd class="col-sm-10">@Model.SchoolId</dd>
        <dt class="col-sm-2">Name</dt>
        <dd class="col-sm-10">@(Model.FirstName + (string.IsNullOrWhiteSpace(Model.LastName) ? "" : (" " + Model.LastName)))</dd>
        <dt class="col-sm-2">Email</dt>
        <dd class="col-sm-10">@Model.Email</dd>
        <dt class="col-sm-2">Phone</dt>
        <dd class="col-sm-10">@Model.Phone</dd>
        <dt class="col-sm-2">Mobile</dt>
        <dd class="col-sm-10">@Model.MobilePhone</dd>
        <dt class="col-sm-2">Address Line 1</dt>
        <dd class="col-sm-10">@Model.AddressLine1</dd>
        <dt class="col-sm-2">Address Line 2</dt>
        <dd class="col-sm-10">@Model.AddressLine2</dd>
        <dt class="col-sm-2">Country</dt>
        <dd class="col-sm-10">@Model.Country.Name</dd>
        <dt class="col-sm-2">State</dt>
        <dd class="col-sm-10">@Model.State.Name</dd>
        <dt class="col-sm-2">City</dt>
        <dd class="col-sm-10">@Model.City.Name</dd>
        <dt class="col-sm-2">Active</dt>
        <dd class="col-sm-10">@Model.IsActive</dd>
    </dl>
</div>
<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>
