@model SchoolPortalApp.Models.SchoolContactViewModel
@{
    ViewData["Title"] = "Create School Contact";
}
<h2>Create School Contact</h2>
<form asp-action="Create" method="post">
    <div class="form-group">
        <label asp-for="SchoolId"></label>
        <select asp-for="SchoolId" asp-items="Model.Schools" class="form-control"></select>
        <span asp-validation-for="SchoolId" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="FirstName"></label>
        <input asp-for="FirstName" class="form-control" />
        <span asp-validation-for="FirstName" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="LastName"></label>
        <input asp-for="LastName" class="form-control" />
        <span asp-validation-for="LastName" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="Email"></label>
        <input asp-for="Email" class="form-control" />
        <span asp-validation-for="Email" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="Phone"></label>
        <input asp-for="Phone" class="form-control" />
        <span asp-validation-for="Phone" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="MobilePhone"></label>
        <input asp-for="MobilePhone" class="form-control" />
        <span asp-validation-for="MobilePhone" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="CountryId"></label>
        <select asp-for="CountryId" asp-items="Model.Countries" class="form-control" id="country"></select>
        <span asp-validation-for="CountryId" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="StateId"></label>
        <select asp-for="StateId" asp-items="Model.States" class="form-control" id="state"></select>
        <span asp-validation-for="StateId" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="CityId"></label>
        <select asp-for="CityId" asp-items="Model.Cities" class="form-control" id="city"></select>
        <span asp-validation-for="CityId" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="AddressLine1"></label>
        <input asp-for="AddressLine1" class="form-control" />
        <span asp-validation-for="AddressLine1" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="AddressLine2"></label>
        <input asp-for="AddressLine2" class="form-control" />
        <span asp-validation-for="AddressLine2" class="text-danger"></span>
    </div>
    <div class="form-group form-check">
        <input class="form-check-input" asp-for="IsActive" />
        <label class="form-check-label" asp-for="IsActive"></label>
    </div>
    <button type="submit" class="btn btn-primary">Save</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>
@section Scripts{
<script>
    const country = document.getElementById('country');
    const state = document.getElementById('state');
    const city = document.getElementById('city');
    country.addEventListener('change', async (e) => {
        const countryId = e.target.value;
        state.innerHTML = '';
        city.innerHTML = '';
        if (!countryId) return;
        const res = await fetch(`/SchoolContact/GetStates?countryId=${countryId}`);
        const data = await res.json();
        data.forEach(x => {
            const opt = document.createElement('option');
            opt.value = x.id; opt.text = x.name; state.add(opt);
        });
    });
    state.addEventListener('change', async (e) => {
        const stateId = e.target.value;
        city.innerHTML = '';
        if (!stateId) return;
        const res = await fetch(`/SchoolContact/GetCities?stateId=${stateId}`);
        const data = await res.json();
        data.forEach(x => {
            const opt = document.createElement('option');
            opt.value = x.id; opt.text = x.name; city.add(opt);
        });
    });
</script>
}
