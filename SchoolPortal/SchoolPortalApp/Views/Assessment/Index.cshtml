@model IEnumerable<AssessmentListItemViewModel>

@{
	ViewData["Title"] = "Assessments";
}

<h2>Assessments</h2>

<a asp-action="Create" class="btn btn-primary">
	<i class="bi bi-plus-lg"></i> Create New
</a>

<table id="assessments-grid" class="table table-striped" data-datatable="true">
	<thead>
		<tr>
			<th>@Html.DisplayNameFor(model => model.Name)</th>
			<th>@Html.DisplayNameFor(model => model.PercentageWeightage)</th>
			<th>@Html.DisplayNameFor(model => model.FromPeriod)</th>
			<th>@Html.DisplayNameFor(model => model.ToPeriod)</th>
			<th>@Html.DisplayNameFor(model => model.IsActive)</th>
			<th>Actions</th>
		</tr>
		<tr>
			<th><input type="text" class="form-control form-control-sm" placeholder="Search Name" /></th>
			<th><input type="text" class="form-control form-control-sm" placeholder="Search Weightage" /></th>
			<th><input type="text" class="form-control form-control-sm" placeholder="Search From" /></th>
			<th><input type="text" class="form-control form-control-sm" placeholder="Search To" /></th>
			<th><input type="text" class="form-control form-control-sm" placeholder="Search Active" /></th>
			<th></th>
		</tr>
	</thead>
	<tbody>
		@foreach (var item in Model)
		{
			<tr>
				<td>@Html.DisplayFor(_ => item.Name)</td>
				<td>@Html.DisplayFor(_ => item.PercentageWeightage)</td>
				<td>@Html.DisplayFor(_ => item.FromPeriod)</td>
				<td>@Html.DisplayFor(_ => item.ToPeriod)</td>
				<td>@item.IsActive</td>
				<td class="text-nowrap" style="white-space: nowrap;">
					<a asp-action="Details" asp-route-id="@item.Id" class="text-info me-2" title="View">
						<i class="bi bi-eye"></i>
					</a>
					<a asp-action="Edit" asp-route-id="@item.Id" class="text-warning me-2" title="Edit">
						<i class="bi bi-pencil"></i>
					</a>
					<a asp-action="Delete" asp-route-id="@item.Id" class="text-danger" title="Delete">
						<i class="bi bi-trash"></i>
					</a>
				</td>
			</tr>
		}
	</tbody>
</table>
