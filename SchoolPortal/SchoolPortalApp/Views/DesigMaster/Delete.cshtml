@model DesigMasterViewModel

@{
	ViewData["Title"] = "Delete Designation";
}

<div class="card">
	<div class="card-header bg-danger text-white">
		<h4>@ViewData["Title"]</h4>
	</div>
	<div class="card-body">
		<h5 class="text-danger">Are you sure you want to delete this?</h5>
		
		<div class="alert alert-warning">
			<i class="fas fa-exclamation-triangle"></i> This action cannot be undone. This will permanently delete the designation.
		</div>

		<dl class="row">
			<dt class="col-sm-3">@Html.DisplayNameFor(model => model.Code)</dt>
			<dd class="col-sm-9">@Html.DisplayFor(model => model.Code)</dd>

			<dt class="col-sm-3">@Html.DisplayNameFor(model => model.Name)</dt>
			<dd class="col-sm-9">@Html.DisplayFor(model => model.Name)</dd>

			<dt class="col-sm-3">School</dt>
			<dd class="col-sm-9">@ViewBag.SchoolName</dd>

			<dt class="col-sm-3">@Html.DisplayNameFor(model => model.IsActive)</dt>
			<dd class="col-sm-9">
				@if (Model.IsActive)
				{
					<span class="badge bg-success">Active</span>
				}
				else
				{
					<span class="badge bg-secondary">Inactive</span>
				}
			</dd>
		</dl>
	</div>
	<div class="card-footer">
		<form asp-action="Delete" method="post">
			<input type="hidden" asp-for="Id" />
			<button type="submit" class="btn btn-danger">
				<i class="fas fa-trash"></i> Delete
			</button>
			<a asp-action="Index" class="btn btn-secondary">
				<i class="fas fa-arrow-left"></i> Back to List
			</a>
		</form>
	</div>
</div>