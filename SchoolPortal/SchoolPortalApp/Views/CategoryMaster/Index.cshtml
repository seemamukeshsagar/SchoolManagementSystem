@model IEnumerable<SchoolPortalApp.Models.CategoryMasterListItemViewModel>
@{
	ViewData["Title"] = "Categories";
}
<h2>Categories</h2>
@if (SchoolPortal.Services.Common.AuthorizedManager.HasPrivilege("Create CategoryMaster"))
{
	<p>
		<a class="btn btn-primary" asp-controller="CategoryMaster" asp-action="Create">Create New</a>
	</p>
}
<table class="table table-striped">
	<thead>
		<tr>
			<th>Category Name</th>
			<th>Is Active</th>
			<th></th>
		</tr>
	</thead>
	<tbody>
	@foreach (var item in Model)
	{
		<tr>
			<td>@item.Name</td>
			<td>@item.IsActive</td>
			<td>
				<a asp-action="Details" asp-route-id="@item.Id" class="btn btn-info" title="View Details">
					<i class="bi bi-eye"></i>
				</a> |
				<a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning" title="Edit">
					<i class="bi bi-pencil"></i>
				</a> |
				<a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger" title="Delete">
					<i class="bi bi-trash"></i>
				</a>
			</td>
		</tr>
	}
	</tbody>
</table>
