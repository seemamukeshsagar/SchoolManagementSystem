@model SchoolPortal.Entities.Models.TeacherSubjectDetails
@{
	ViewData["Title"] = "Delete Teacher Subject Details";
}
<h2>Delete Teacher Subject Details</h2>
<h3>Are you sure you want to delete this?</h3>
<div>
	<dl class="row">
		<dt class="col-sm-2">Id</dt>
		<dd class="col-sm-10">@Model.Id</dd>
		<dt class="col-sm-2">TeacherId</dt>
		<dd class="col-sm-10">@Model.TeacherId</dd>
		<dt class="col-sm-2">ClassId</dt>
		<dd class="col-sm-10">@Model.ClassId</dd>
		<dt class="col-sm-2">SubjectId</dt>
		<dd class="col-sm-10">@Model.SubjectId</dd>
	</dl>
</div>
<form asp-action="Delete" method="post">
	@Html.AntiForgeryToken()
	<input type="hidden" asp-for="Id" />
	<button type="submit" class="btn btn-danger">Delete</button>
	<a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>
