@model SchoolPortalApp.Models.ClassViewModel
@{
    ViewData["Title"] = "Create Class";
}
<h2>Create Class</h2>
<form asp-action="Create" method="post">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="mb-3">
        <label asp-for="Name" class="form-label"></label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <div class="form-check">
            <input asp-for="ExamAssessment" class="form-check-input" />
            <label asp-for="ExamAssessment" class="form-check-label"></label>
        </div>
        <span asp-validation-for="ExamAssessment" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <div class="form-check">
            <input asp-for="IsGradePointApplicable" class="form-check-input" />
            <label asp-for="IsGradePointApplicable" class="form-check-label"></label>
        </div>
    </div>
    <div class="mb-3">
        <div class="form-check">
            <input asp-for="IsActive" class="form-check-input" />
            <label asp-for="IsActive" class="form-check-label"></label>
        </div>
    </div>
    <button type="submit" class="btn btn-primary">Create</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
