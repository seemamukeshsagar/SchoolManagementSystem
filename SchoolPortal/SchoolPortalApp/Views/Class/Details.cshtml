@model Schoolortal.Entities.Models.ClassMaster
@{
    ViewData["Title"] = "Class Details";
}
<h2>Class Details</h2>
<div class="mb-3">
    <strong>Name:</strong> @Model.Name
</div>
<div class="mb-3">
    <strong>Exam Assessment:</strong> @Model.ExamAssessment
</div>
<div class="mb-3">
    <strong>Is Grade Point Applicable:</strong> @Model.IsGradePointApplicable
</div>
<div class="mb-3">
    <strong>Active:</strong> @Model.IsActive
</div>
<p>
    <a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model.Id">Edit</a>
    <a class="btn btn-secondary" asp-action="Index">Back</a>
</p>
