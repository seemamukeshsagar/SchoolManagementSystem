@model IEnumerable<SchoolPortalApp.Models.Attendance.AttendanceListItemViewModel>

@{
    ViewData["Title"] = "Attendance Records";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1 class="m-0">@ViewData["Title"]</h1>
            </div>
            <div class="col-sm-6">
                <ol class="breadcrumb float-sm-right">
                    <li class="breadcrumb-item"><a href="/">Home</a></li>
                    <li class="breadcrumb-item active">@ViewData["Title"]</li>
                </ol>
            </div>
        </div>
    </div>
</div>

<section class="content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-12">
                <div class="card">
                    <div class="card-header">
                        <div class="card-tools">
                            <a href="@Url.Action("Create")" class="btn btn-primary">
                                <i class="fas fa-plus"></i> Add New
                            </a>
                        </div>
                    </div>
                    <div class="card-body">
                        @if (TempData["ErrorMessage"] != null)
                        {
                            <div class="alert alert-danger alert-dismissible">
                                <button type="button" class="close" data-dismiss="alert" aria-hidden="true">×</button>
                                <h5><i class="icon fas fa-ban"></i> Error!</h5>
                                @TempData["ErrorMessage"]
                            </div>
                        }
                        
                        <table id="attendanceTable" class="table table-bordered table-striped">
                            <thead>
                                <tr>
                                    <th>@Html.DisplayNameFor(model => model.EmployeeName)</th>
                                    <th>@Html.DisplayNameFor(model => model.AttendanceDate)</th>
                                    <th>@Html.DisplayNameFor(model => model.Status)</th>
                                    <th>@Html.DisplayNameFor(model => model.AttendanceMarked)</th>
                                    <th>@Html.DisplayNameFor(model => model.LeaveType)</th>
                                    <th>@Html.DisplayNameFor(model => model.IsHalfDay)</th>
                                    <th>@Html.DisplayNameFor(model => model.AttendanceTime)</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model)
                                {
                                    <tr>
                                        <td>@Html.DisplayFor(modelItem => item.EmployeeName)</td>
                                        <td>@item.AttendanceDate.ToString("dd/MM/yyyy")</td>
                                        <td>
                                            @if (item.Status == "ACT")
                                            {
                                                <span class="badge bg-success">Active</span>
                                            }
                                            else if (item.Status == "INA")
                                            {
                                                <span class="badge bg-danger">Inactive</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary">@item.Status</span>
                                            }
                                        </td>
                                        <td>
                                            @if (item.AttendanceMarked)
                                            {
                                                <span class="badge bg-success">Present</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-danger">Absent</span>
                                            }
                                        </td>
                                        <td>@Html.DisplayFor(modelItem => item.LeaveType)</td>
                                        <td>
                                            @if (item.IsHalfDay.HasValue && item.IsHalfDay.Value)
                                            {
                                                <span class="badge bg-warning">Yes</span>
                                            }
                                            else if (item.IsHalfDay.HasValue)
                                            {
                                                <span class="badge bg-info">No</span>
                                            }
                                            else
                                            {
                                                <span>-</span>
                                            }
                                        </td>
                                        <td>@Html.DisplayFor(modelItem => item.AttendanceTime)</td>
                                        <td>
                                            <div class="btn-group">
                                                <a href="@Url.Action("Details", new { id = item.Id })" class="btn btn-sm btn-info" title="View">
                                                    <i class="fas fa-eye"></i>
                                                </a>
                                                <a href="@Url.Action("Edit", new { id = item.Id })" class="btn btn-sm btn-primary" title="Edit">
                                                    <i class="fas fa-edit"></i>
                                                </a>
                                                <a href="@Url.Action("Delete", new { id = item.Id })" class="btn btn-sm btn-danger" title="Delete">
                                                    <i class="fas fa-trash"></i>
                                                </a>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script>
        $(function () {
            $("#attendanceTable").DataTable({
                "responsive": true,
                "lengthChange": false,
                "autoWidth": false,
                "buttons": ["copy", "csv", "excel", "pdf", "print", "colvis"]
            }).buttons().container().appendTo('#attendanceTable_wrapper .col-md-6:eq(0)');
        });
    </script>
}
