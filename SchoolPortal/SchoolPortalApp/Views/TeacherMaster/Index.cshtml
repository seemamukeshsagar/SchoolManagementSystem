@model IEnumerable<SchoolPortalApp.Models.TeacherListItemViewModel>
@{
    ViewData["Title"] = "Teachers";
}
<h2>Teachers</h2>
<p>
    <a class="btn btn-primary" asp-controller="TeacherMaster" asp-action="Create">Create New</a>
</p>
<table class="table table-striped">
    <thead>
        <tr>
            <th>Name</th>
            <th>Email</th>
            <th>Phone</th>
            <th>Is Active</th>
            <th>School</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.Name</td>
            <td>@item.Email</td>
            <td>@item.Phone</td>
            <td>@item.IsActive</td>
            <td>@item.SchoolName</td>
            <td>
                <a asp-action="Details" asp-route-id="@item.Id">Details</a> |
                <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
            </td>
        </tr>
    }
    </tbody>
</table>
