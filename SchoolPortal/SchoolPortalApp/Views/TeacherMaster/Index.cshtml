@model IEnumerable<SchoolPortalApp.Models.TeacherListItemViewModel>
@{
	ViewData["Title"] = "Teachers";
}
<h2>Teachers</h2>
<p>
	<a class="btn btn-primary" asp-controller="TeacherMaster" asp-action="Create">Create New</a>
</p>
<table class="table table-striped">
	<thead>
		<tr>
			<th>First Name</th>
			<th>Last Name</th>
			<th>DOB</th>
			<th>DOJ</th>
			<th>Gender</th>
			<th>Marital Status</th>
			<th>Image</th>
			<th>Mobile Phone</th>
			<th>Is Active</th>
			<th></th>
		</tr>
	</thead>
	<tbody>
	@foreach (var item in Model)
	{
		<tr>
			<td>@item.FirstName</td>
			<td>@item.LastName</td>
			<td>@item.DOB.ToString("yyyy-MM-dd")</td>
			<td>@(item.DOJ.HasValue ? item.DOJ.Value.ToString("yyyy-MM-dd") : "")</td>
			<td>@item.GenderName</td>
			<td>@item.MaritalStatusName</td>
			<td>
				@if (!string.IsNullOrWhiteSpace(item.Image))
				{
					<img src="@item.Image" alt="Teacher" style="height:40px;width:auto;object-fit:cover;border-radius:4px;" />
				}
			</td>
			<td>@item.MobilePhone</td>
			<td>@item.IsActive</td>
			<td>
				<a asp-action="Details" asp-route-id="@item.Id">Details</a> |
				<a asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
				<a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
			</td>
		</tr>
	}
	</tbody>
</table>
