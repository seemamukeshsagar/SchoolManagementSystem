@model IEnumerable<SchoolPortalApp.Models.TeacherListItemViewModel>
@{
	ViewData["Title"] = "Teachers";
}
<h2>Teachers</h2>
<p>
	<a class="btn btn-primary" asp-controller="TeacherMaster" asp-action="Create">Create New</a>
	<a class="btn btn-success" asp-controller="TeacherMaster" asp-action="Import">Import from Excel</a>
</p>
<table class="table table-striped">
	<thead>
		<tr>
			<th>First Name</th>
			<th>Last Name</th>
			<th>DOB</th>
			<th>DOJ</th>
			<th>Gender</th>
			<th>Marital Status</th>
			<th>Image</th>
			<th>Mobile Phone</th>
			<th>Is Active</th>
			<th></th>
		</tr>
	</thead>
	<tbody>
	@foreach (var item in Model)
	{
		<tr>
			<td>@item.FirstName</td>
			<td>@item.LastName</td>
			<td>@item.DOB.ToString("yyyy-MM-dd")</td>
			<td>@(item.DOJ.HasValue ? item.DOJ.Value.ToString("yyyy-MM-dd") : "")</td>
			<td>@item.GenderName</td>
			<td>@item.MaritalStatusName</td>
			<td>
				@if (!string.IsNullOrWhiteSpace(item.Image))
				{
					<img src="@item.Image" alt="Teacher" style="height:40px;width:auto;object-fit:cover;border-radius:4px;" />
				}
			</td>
			<td>@item.MobilePhone</td>
			<td>@item.IsActive</td>
			<td>
					<div class="btn-group btn-group-sm">
						<a asp-action="Details" asp-route-id="@item.Id" class="btn btn-info" title="View Details">
							<i class="bi bi-eye"></i>
						</a>
						<a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning" title="Edit">
							<i class="bi bi-pencil"></i>
						</a>
						<a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger" title="Delete">
							<i class="bi bi-trash"></i>
						</a>
					</div>
			</td>
		</tr>
	}
	</tbody>
</table>