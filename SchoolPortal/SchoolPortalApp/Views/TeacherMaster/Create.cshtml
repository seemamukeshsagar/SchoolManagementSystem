@model SchoolPortalApp.Models.TeacherAggregateViewModel
@{ 
	ViewData["Title"] = "Create Teacher";
}
<h2>Create Teacher</h2>

<form asp-action="Create" method="post" enctype="multipart/form-data">
	<ul class="nav nav-tabs" role="tablist">
		<li class="nav-item"><a class="nav-link active" data-bs-toggle="tab" href="#tab-master" role="tab">Teacher Master</a></li>
		<li class="nav-item"><a class="nav-link" data-bs-toggle="tab" href="#tab-docs" role="tab">Documents</a></li>
		<li class="nav-item"><a class="nav-link" data-bs-toggle="tab" href="#tab-quals" role="tab">Qualifications</a></li>
	</ul>
	<div class="tab-content border p-3 border-top-0">
		<div class="tab-pane fade show active" id="tab-master" role="tabpanel">
			<input type="hidden" asp-for="Master.SchoolId" />
			<div class="form-group">
				<label asp-for="Master.FirstName"></label>
				<input asp-for="Master.FirstName" class="form-control" />
				<span asp-validation-for="Master.FirstName" class="text-danger"></span>
			</div>
			<div class="form-group">
				<label asp-for="Master.LastName"></label>
				<input asp-for="Master.LastName" class="form-control" />
			</div>
			<div class="form-group">
				<label asp-for="Master.Salutation"></label>
				<input asp-for="Master.Salutation" class="form-control" />
			</div>
			<div class="form-group">
				<label asp-for="Master.DOB"></label>
				<input asp-for="Master.DOB" type="date" asp-format="{0:yyyy-MM-dd}" class="form-control" />
				<span asp-validation-for="Master.DOB" class="text-danger"></span>
			</div>
			<div class="form-group">
				<label asp-for="Master.DOJ"></label>
				<input asp-for="Master.DOJ" type="date" asp-format="{0:yyyy-MM-dd}" class="form-control" />
			</div>
			<div class="form-group">
				<label asp-for="Master.DateOfLeaving"></label>
				<input asp-for="Master.DateOfLeaving" type="date" asp-format="{0:yyyy-MM-dd}" class="form-control" />
			</div>
			<div class="form-group">
				<label asp-for="Master.Address"></label>
				<input asp-for="Master.Address" class="form-control" />
			</div>
			<div class="form-group">
				<label asp-for="Master.ZipCode"></label>
				<input asp-for="Master.ZipCode" class="form-control" />
			</div>
			<div class="form-group">
				<label asp-for="Master.CountryId"></label>
				<select asp-for="Master.CountryId" class="form-control" asp-items="Model.Countries">
					<option value="">-- Select Country --</option>
				</select>
				<span asp-validation-for="Master.CountryId" class="text-danger"></span>
			</div>
			<div class="form-group">
				<label asp-for="Master.StateId"></label>
				<select asp-for="Master.StateId" class="form-control" asp-items="Model.States" disabled>
					<option value="">-- Select State --</option>
				</select>
				<span asp-validation-for="Master.StateId" class="text-danger"></span>
			</div>
			<div class="form-group">
				<label asp-for="Master.CityId"></label>
				<select asp-for="Master.CityId" class="form-control" asp-items="Model.Cities" disabled>
					<option value="">-- Select City --</option>
				</select>
				<span asp-validation-for="Master.CityId" class="text-danger"></span>
			</div>
			<div class="form-group">
				<label asp-for="Master.Gender"></label>
				<select asp-for="Master.Gender" class="form-control" asp-items="Model.Genders">
					<option value="">-- Select Gender --</option>
				</select>
				<span asp-validation-for="Master.Gender" class="text-danger"></span>
			</div>
			<div class="form-group">
				<label asp-for="Master.MaritalStatusId"></label>
				<select asp-for="Master.MaritalStatusId" class="form-control" asp-items="Model.MaritalStatuses">
					<option value="">-- Select Marital Status --</option>
				</select>
				<span asp-validation-for="Master.MaritalStatusId" class="text-danger"></span>
			</div>
			<div class="form-group">
				<label asp-for="Master.Email"></label>
				<input asp-for="Master.Email" class="form-control" />
			</div>
			<div class="form-group">
				<label asp-for="Master.Phone"></label>
				<input asp-for="Master.Phone" class="form-control" />
			</div>
			<div class="form-group">
				<label asp-for="Master.MobilePhone"></label>
				<input asp-for="Master.MobilePhone" class="form-control" />
			</div>
			<div class="form-group">
				<label asp-for="Master.Image"></label>
				<input asp-for="Master.Image" class="form-control" />
			</div>
			<div class="form-group">
				<label asp-for="Master.YearsOfExperience"></label>
				<input asp-for="Master.YearsOfExperience" class="form-control" />
			</div>
			<div class="form-group">
				<label asp-for="Master.PreviousSchool"></label>
				<input asp-for="Master.PreviousSchool" class="form-control" />
			</div>
			<div class="form-group form-check">
				<input class="form-check-input" asp-for="Master.IsActive" />
				<label class="form-check-label" asp-for="Master.IsActive"></label>
			</div>
			<div class="form-group form-check">
				<input class="form-check-input" asp-for="Master.IsDeleted" />
				<label class="form-check-label" asp-for="Master.IsDeleted"></label>
			</div>
		</div>

		<div class="tab-pane fade" id="tab-docs" role="tabpanel">
			<div class="mb-2">
				<button type="button" class="btn btn-sm btn-outline-primary" id="btnAddDoc">Add Document</button>
			</div>
			<table class="table table-bordered" id="tblDocs">
				<thead>
					<tr>
						<th>Name</th>
						<th>Description</th>
						<th>File</th>
						<th>Active</th>
						<th></th>
					</tr>
				</thead>
				<tbody></tbody>
			</table>
		</div>

		<div class="tab-pane fade" id="tab-quals" role="tabpanel">
			<div class="mb-2">
				<button type="button" class="btn btn-sm btn-outline-primary" id="btnAddQual">Add Qualification</button>
			</div>
			<table class="table table-bordered" id="tblQuals">
				<thead>
					<tr>
						<th>Qualification</th>
						<th>Active</th>
						<th></th>
					</tr>
				</thead>
				<tbody></tbody>
			</table>
		</div>
	</div>

	<div class="mt-3">
		<button type="submit" class="btn btn-primary">Save</button>
		<a class="btn btn-secondary" asp-action="Index">Cancel</a>
	</div>
</form>

@section Scripts{
	<script>
		(function () {
			const countrySel = document.getElementById('Master_CountryId');
			const stateSel = document.getElementById('Master_StateId');
			const citySel = document.getElementById('Master_CityId');

			function clearSelect(sel, placeholder) {
				sel.innerHTML = '';
				const opt = document.createElement('option');
				opt.value = '';
				opt.textContent = placeholder;
				sel.appendChild(opt);
			}

			function setDisabled(sel, disabled) {
				if (!sel) return;
				sel.disabled = !!disabled;
			}

			(function init() {
				const hasCountry = !!(countrySel && countrySel.value);
				const hasState = !!(stateSel && stateSel.value);
				setDisabled(stateSel, !hasCountry);
				setDisabled(citySel, !hasState);
			})();

			countrySel && countrySel.addEventListener('change', function () {
				const cid = this.value;
				clearSelect(stateSel, '-- Select State --');
				clearSelect(citySel, '-- Select City --');
				setDisabled(stateSel, !cid);
				setDisabled(citySel, true);
				if (!cid) return;
				fetch(`/TeacherMaster/GetStatesByCountry/${cid}`)
					.then(r => r.ok ? r.json() : Promise.reject(r))
					.then(items => {
						items.forEach(x => {
							const opt = document.createElement('option');
							opt.value = x.value; opt.textContent = x.text;
							stateSel.appendChild(opt);
						});
						setDisabled(stateSel, false);
					})
					.catch(() => { setDisabled(stateSel, true); });
			});

			stateSel && stateSel.addEventListener('change', function () {
				const sid = this.value;
				clearSelect(citySel, '-- Select City --');
				setDisabled(citySel, !sid);
				if (!sid) return;
				fetch(`/TeacherMaster/GetCitiesByState/${sid}`)
					.then(r => r.ok ? r.json() : Promise.reject(r))
					.then(items => {
						items.forEach(x => {
							const opt = document.createElement('option');
							opt.value = x.value; opt.textContent = x.text;
							citySel.appendChild(opt);
						});
						setDisabled(citySel, false);
					})
					.catch(() => { setDisabled(citySel, true); });
			});

			// Dynamic rows for documents
			const tblDocsBody = document.querySelector('#tblDocs tbody');
			const btnAddDoc = document.getElementById('btnAddDoc');
			let docIndex = 0;
			btnAddDoc && btnAddDoc.addEventListener('click', function(){
				const tr = document.createElement('tr');
				tr.innerHTML = `
					<td><input name="Documents[${docIndex}].Name" class="form-control" /></td>
					<td><input name="Documents[${docIndex}].Description" class="form-control" /></td>
					<td><input type="file" name="DocumentFiles[${docIndex}]" class="form-control" /></td>
					<td class="text-center"><input type="checkbox" name="Documents[${docIndex}].IsActive" /></td>
					<td class="text-center"><button type="button" class="btn btn-sm btn-outline-danger btn-remove">Remove</button></td>`;
				tblDocsBody.appendChild(tr);
				docIndex++;
			});
			tblDocsBody && tblDocsBody.addEventListener('click', function(e){
				if(e.target && e.target.classList.contains('btn-remove')){
					e.target.closest('tr').remove();
				}
			});

			// Dynamic rows for qualifications
			const tblQualsBody = document.querySelector('#tblQuals tbody');
			const btnAddQual = document.getElementById('btnAddQual');
			let qualIndex = 0;
			function buildQualSelect(name){
				const sel = document.createElement('select');
				sel.name = name;
				sel.className = 'form-select';
				const emptyOpt = document.createElement('option');
				emptyOpt.value = '';
				emptyOpt.textContent = '-- Select Qualification --';
				sel.appendChild(emptyOpt);
				const items = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.QualificationItems.Select(x => new { value = x.Value, text = x.Text })));
				items.forEach(x=>{
					const opt = document.createElement('option');
					opt.value = x.value; opt.textContent = x.text;
					sel.appendChild(opt);
				});
				return sel.outerHTML;
			}
			btnAddQual && btnAddQual.addEventListener('click', function(){
				const tr = document.createElement('tr');
				tr.innerHTML = `
					<td>${buildQualSelect('Qualifications[' + qualIndex + '].QualificationId')}</td>
					<td class="text-center"><input type="checkbox" name="Qualifications[${qualIndex}].IsActive" /></td>
					<td class="text-center"><button type="button" class="btn btn-sm btn-outline-danger btn-remove">Remove</button></td>`;
				tblQualsBody.appendChild(tr);
				qualIndex++;
			});
			tblQualsBody && tblQualsBody.addEventListener('click', function(e){
				if(e.target && e.target.classList.contains('btn-remove')){
					e.target.closest('tr').remove();
				}
			});
		})();
	</script>
}
	<partial name="_ValidationScriptsPartial" />