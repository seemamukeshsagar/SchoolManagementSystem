@model SchoolPortalApp.Models.TeacherDetailsViewModel
@{ 
	ViewData["Title"] = "Teacher Details";
}
<h2>Teacher Details</h2>
<div>
	<dl class="row">
		<dt class="col-sm-3">Id</dt>
		<dd class="col-sm-9">@Model.Master.Id</dd>
		<dt class="col-sm-3">First Name</dt>
		<dd class="col-sm-9">@Model.Master.FirstName</dd>
		<dt class="col-sm-3">Last Name</dt>
		<dd class="col-sm-9">@Model.Master.LastName</dd>
		<dt class="col-sm-3">Salutation</dt>
		<dd class="col-sm-9">@Model.Master.Salutation</dd>
		<dt class="col-sm-3">DOB</dt>
		<dd class="col-sm-9">@Model.Master.DOB.ToString("yyyy-MM-dd")</dd>
		<dt class="col-sm-3">DOJ</dt>
		<dd class="col-sm-9">@(Model.Master.DOJ?.ToString("yyyy-MM-dd"))</dd>
		<dt class="col-sm-3">Date Of Leaving</dt>
		<dd class="col-sm-9">@(Model.Master.DateOfLeaving?.ToString("yyyy-MM-dd"))</dd>
		<dt class="col-sm-3">Address</dt>
		<dd class="col-sm-9">@Model.Master.Address</dd>
		<dt class="col-sm-3">Zip Code</dt>
		<dd class="col-sm-9">@Model.Master.ZipCode</dd>
		<dt class="col-sm-3">Email</dt>
		<dd class="col-sm-9">@Model.Master.Email</dd>
		<dt class="col-sm-3">Phone</dt>
		<dd class="col-sm-9">@Model.Master.Phone</dd>
		<dt class="col-sm-3">Mobile Phone</dt>
		<dd class="col-sm-9">@Model.Master.MobilePhone</dd>
		<dt class="col-sm-3">Years Of Experience</dt>
		<dd class="col-sm-9">@Model.Master.YearsOfExperience</dd>
		<dt class="col-sm-3">Previous School</dt>
		<dd class="col-sm-9">@Model.Master.PreviousSchool</dd>
		<dt class="col-sm-3">Is Active</dt>
		<dd class="col-sm-9">@Model.Master.IsActive</dd>
		<dt class="col-sm-3">Is Deleted</dt>
		<dd class="col-sm-9">@Model.Master.IsDeleted</dd>
	</dl>
</div>

<h4>Documents</h4>
<table class="table table-bordered">
	<thead>
		<tr>
			<th>Name</th>
			<th>Description</th>
			<th>File</th>
			<th>Active</th>
		</tr>
	</thead>
	<tbody>
	@foreach (var d in Model.Documents)
	{
		var isImg = !string.IsNullOrWhiteSpace(d.FileName) && (d.FileName.EndsWith(".png", System.StringComparison.OrdinalIgnoreCase) || d.FileName.EndsWith(".jpg", System.StringComparison.OrdinalIgnoreCase) || d.FileName.EndsWith(".jpeg", System.StringComparison.OrdinalIgnoreCase) || d.FileName.EndsWith(".gif", System.StringComparison.OrdinalIgnoreCase) || d.FileName.EndsWith(".webp", System.StringComparison.OrdinalIgnoreCase));
		<tr>
			<td>@d.Name</td>
			<td>@d.Description</td>
			<td>
				@if (!string.IsNullOrWhiteSpace(d.FileName))
				{
					if (isImg)
					{
						<a href="@d.FileName" target="_blank"><img src="@d.FileName" alt="@d.Name" style="max-width:120px; max-height:120px;" /></a>
					}
					else
					{
						<a href="@d.FileName" target="_blank">Download</a>
					}
				}
			</td>
			<td>@d.IsActive</td>
		</tr>
	}
	</tbody>
</table>

<h4>Qualifications</h4>
<table class="table table-bordered">
	<thead>
		<tr>
			<th>Qualification Id</th>
			<th>Active</th>
		</tr>
	</thead>
	<tbody>
	@foreach (var q in Model.Qualifications)
	{
		<tr>
			<td>@q.QualificationId</td>
			<td>@q.IsActive</td>
		</tr>
	}
	</tbody>
</table>

<p>
	<a class="btn btn-secondary" asp-action="Index">Back to List</a>
	<a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model.Master.Id">Edit</a>
</p>
