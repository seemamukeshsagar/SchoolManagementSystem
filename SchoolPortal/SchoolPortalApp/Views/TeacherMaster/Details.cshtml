@model SchoolPortal.Entities.Models.TeacherMaster
@{
    ViewData["Title"] = "Teacher Details";
}
<h2>Teacher Details</h2>
<div>
    <dl class="row">
        <dt class="col-sm-3">Id</dt>
        <dd class="col-sm-9">@Model.Id</dd>
        <dt class="col-sm-3">First Name</dt>
        <dd class="col-sm-9">@Model.FirstName</dd>
        <dt class="col-sm-3">Last Name</dt>
        <dd class="col-sm-9">@Model.LastName</dd>
        <dt class="col-sm-3">Salutation</dt>
        <dd class="col-sm-9">@Model.Salutation</dd>
        <dt class="col-sm-3">DOB</dt>
        <dd class="col-sm-9">@Model.DOB.ToString("yyyy-MM-dd")</dd>
        <dt class="col-sm-3">DOJ</dt>
        <dd class="col-sm-9">@(Model.DOJ?.ToString("yyyy-MM-dd"))</dd>
        <dt class="col-sm-3">Date Of Leaving</dt>
        <dd class="col-sm-9">@(Model.DateOfLeaving?.ToString("yyyy-MM-dd"))</dd>
        <dt class="col-sm-3">Address</dt>
        <dd class="col-sm-9">@Model.Address</dd>
        <dt class="col-sm-3">Zip Code</dt>
        <dd class="col-sm-9">@Model.ZipCode</dd>
        <dt class="col-sm-3">City Id</dt>
        <dd class="col-sm-9">@Model.CityId</dd>
        <dt class="col-sm-3">State Id</dt>
        <dd class="col-sm-9">@Model.StateId</dd>
        <dt class="col-sm-3">Country Id</dt>
        <dd class="col-sm-9">@Model.CountryId</dd>
        <dt class="col-sm-3">Gender</dt>
        <dd class="col-sm-9">@Model.Gender</dd>
        <dt class="col-sm-3">Marital Status Id</dt>
        <dd class="col-sm-9">@Model.MaritalStatusId</dd>
        <dt class="col-sm-3">Email</dt>
        <dd class="col-sm-9">@Model.Email</dd>
        <dt class="col-sm-3">Phone</dt>
        <dd class="col-sm-9">@Model.Phone</dd>
        <dt class="col-sm-3">Mobile Phone</dt>
        <dd class="col-sm-9">@Model.MobilePhone</dd>
        <dt class="col-sm-3">Image</dt>
        <dd class="col-sm-9">@Model.Image</dd>
        <dt class="col-sm-3">Years Of Experience</dt>
        <dd class="col-sm-9">@Model.YearsOfExperience</dd>
        <dt class="col-sm-3">Previous School</dt>
        <dd class="col-sm-9">@Model.PreviousSchool</dd>
        <dt class="col-sm-3">Company Id</dt>
        <dd class="col-sm-9">@Model.CompanyId</dd>
        <dt class="col-sm-3">School Id</dt>
        <dd class="col-sm-9">@Model.SchoolId</dd>
        <dt class="col-sm-3">Is Active</dt>
        <dd class="col-sm-9">@Model.IsActive</dd>
        <dt class="col-sm-3">Is Deleted</dt>
        <dd class="col-sm-9">@Model.IsDeleted</dd>
    </dl>
</div>
<p>
    <a class="btn btn-secondary" asp-action="Index">Back to List</a>
    <a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model.Id">Edit</a>
</p>
