@model IEnumerable<SchoolPortalApp.ViewModels.PermissionViewModel>
@{
    ViewData["Title"] = "Permissions Management";
    Layout = "_Layout";
}

<div class="container-fluid">
    <div class="d-sm-flex align-items-center justify-content-between mb-4">
        <h1 class="h3 mb-0 text-gray-800">Permissions Management</h1>
        <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#addPermissionModal">
            <i class="bi bi-plus-lg me-1"></i> Add Permission
        </button>
    </div>

    <!-- Permissions Overview -->
    <div class="row mb-4">
        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card border-left-primary shadow h-100 py-2">
                <div class="card-body
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-primary text-uppercase mb-1">
                                Total Permissions
                            </div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800">@Model.Count()</div>
                        </div>
                        <div class="col-auto">
                            <i class="bi bi-shield-lock fs-1 text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card border-left-success shadow h-100 py-2">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-success text-uppercase mb-1">
                                System Permissions
                            </div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800">@Model.Count(p => p.IsSystemPermission)</div>
                        </div>
                        <div class="col-auto">
                            <i class="bi bi-shield-check fs-1 text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card border-left-info shadow h-100 py-2">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-info text-uppercase mb-1">
                                Custom Permissions
                            </div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800">@Model.Count(p => !p.IsSystemPermission)</div>
                        </div>
                        <div class="col-auto">
                            <i class="bi bi-shield-plus fs-1 text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card border-left-warning shadow h-100 py-2">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-warning text-uppercase mb-1">
                                Permission Groups
                            </div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800">@Model.Select(p => p.Group).Distinct().Count()</div>
                        </div>
                        <div class="col-auto">
                            <i class="bi bi-collection fs-1 text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Permissions Table -->
    <div class="card shadow mb-4">
        <div class="card-header py-3 d-flex justify-content-between align-items-center">
            <h6 class="m-0 font-weight-bold text-primary">All Permissions</h6>
            <div class="dropdown">
                <button class="btn btn-sm btn-outline-secondary dropdown-toggle" type="button" id="exportDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                    <i class="bi bi-download me-1"></i> Export
                </button>
                <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="exportDropdown">
                    <li><a class="dropdown-item" href="#"><i class="bi bi-filetype-csv me-2"></i>CSV</a></li>
                    <li><a class="dropdown-item" href="#"><i class="bi bi-filetype-xlsx me-2"></i>Excel</a></li>
                    <li><a class="dropdown-item" href="#"><i class="bi bi-filetype-pdf me-2"></i>PDF</a></li>
                </ul>
            </div>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-bordered table-hover" id="permissionsTable" width="100%" cellspacing="0">
                    <thead class="table-light">
                        <tr>
                            <th>Name</th>
                            <th>Group</th>
                            <th>Description</th>
                            <th>Type</th>
                            <th>Roles</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var permission in Model)
                        {
                            <tr>
                                <td>
                                    <div class="d-flex align-items-center">
                                        @if (permission.IsSystemPermission)
                                        {
                                            <i class="bi bi-shield-lock text-primary me-2" data-bs-toggle="tooltip" title="System Permission"></i>
                                        }
                                        else
                                        {
                                            <i class="bi bi-shield-plus text-success me-2" data-bs-toggle="tooltip" title="Custom Permission"></i>
                                        }
                                        <span>@permission.Name</span>
                                    </div>
                                </td>
                                <td>@permission.Group</td>
                                <td>@permission.Description</td>
                                <td>
                                    @if (permission.IsSystemPermission)
                                    {
                                        <span class="badge bg-primary">System</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success">Custom</span>
                                    }
                                </td>
                                <td>
                                    <div class="d-flex flex-wrap gap-1">
                                        @foreach (var role in permission.Roles.Take(3))
                                        {
                                            <span class="badge bg-secondary">@role</span>
                                        }
                                        @if (permission.Roles.Count > 3)
                                        {
                                            <span class="badge bg-light text-dark" data-bs-toggle="tooltip" title="@string.Join(", ", permission.Roles.Skip(3))">+@(permission.Roles.Count - 3) more</span>
                                        }
                                    </div>
                                </td>
                                <td>
                                    <div class="btn-group btn-group-sm" role="group">
                                        <button type="button" class="btn btn-outline-primary" data-bs-toggle="modal" data-bs-target="#editPermissionModal-@permission.Id">
                                            <i class="bi bi-pencil"></i>
                                        </button>
                                        @if (!permission.IsSystemPermission)
                                        {
                                            <button type="button" class="btn btn-outline-danger" data-bs-toggle="modal" data-bs-target="#deletePermissionModal-@permission.Id">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        }
                                    </div>
                                </td>
                            </tr>

                            <!-- Edit Permission Modal -->
                            <div class="modal fade" id="editPermissionModal-@permission.Id" tabindex="-1" aria-labelledby="editPermissionModalLabel-@permission.Id" aria-hidden="true">
                                <div class="modal-dialog">
                                    <div class="modal-content">
                                        <div class="modal-header">
                                            <h5 class="modal-title" id="editPermissionModalLabel-@permission.Id">Edit Permission</h5>
                                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                        </div>
                                        <form>
                                            <div class="modal-body">
                                                <div class="mb-3">
                                                    <label for="permissionName-@permission.Id" class="form-label">Name</label>
                                                    <input type="text" class="form-control" id="permissionName-@permission.Id" value="@permission.Name" @(permission.IsSystemPermission ? "disabled" : "")>
                                                    <div class="form-text">Format: [Entity].[Action] (e.g., Users.Edit)</div>
                                                </div>
                                                <div class="mb-3">
                                                    <label for="permissionGroup-@permission.Id" class="form-label">Group</label>
                                                    <input type="text" class="form-control" id="permissionGroup-@permission.Id" value="@permission.Group" list="permissionGroups" @(permission.IsSystemPermission ? "disabled" : "")>
                                                </div>
                                                <div class="mb-3">
                                                    <label for="permissionDescription-@permission.Id" class="form-label">Description</label>
                                                    <textarea class="form-control" id="permissionDescription-@permission.Id" rows="3">@permission.Description</textarea>
                                                </div>
                                                @if (!permission.IsSystemPermission)
                                                {
                                                    <div class="alert alert-warning">
                                                        <i class="bi bi-exclamation-triangle-fill me-2"></i>
                                                        Changing permission names may affect your application's functionality.
                                                    </div>
                                                }
                                            </div>
                                            <div class="modal-footer">
                                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                                                <button type="submit" class="btn btn-primary">Save Changes</button>
                                            </div>
                                        </form>
                                    </div>
                                </div>
                            </div>

                            <!-- Delete Permission Modal -->
                            @if (!permission.IsSystemPermission)
                            {
                                <div class="modal fade" id="deletePermissionModal-@permission.Id" tabindex="-1" aria-labelledby="deletePermissionModalLabel-@permission.Id" aria-hidden="true">
                                    <div class="modal-dialog">
                                        <div class="modal-content">
                                            <div class="modal-header bg-danger text-white">
                                                <h5 class="modal-title" id="deletePermissionModalLabel-@permission.Id">Delete Permission</h5>
                                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                            </div>
                                            <div class="modal-body">
                                                <p>Are you sure you want to delete the permission <strong>@permission.Name</strong>?</p>
                                                @if (permission.Roles.Any())
                                                {
                                                    <div class="alert alert-warning">
                                                        <i class="bi bi-exclamation-triangle-fill me-2"></i>
                                                        This permission is assigned to @permission.Roles.Count role(s). These roles will lose this permission.
                                                    </div>
                                                }
                                            </div>
                                            <div class="modal-footer">
                                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                                                <button type="button" class="btn btn-danger">Delete Permission</button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Permission Groups -->
    <div class="card shadow mb-4">
        <div class="card-header py-3">
            <h6 class="m-0 font-weight-bold text-primary">Permission Groups</h6>
        </div>
        <div class="card-body">
            <div class="row">
                @foreach (var group in Model.GroupBy(p => p.Group).OrderBy(g => g.Key))
                {
                    <div class="col-md-6 col-lg-4 mb-4">
                        <div class="card h-100">
                            <div class="card-header d-flex justify-content-between align-items-center">
                                <h6 class="m-0 font-weight-bold">@group.Key</h6>
                                <span class="badge bg-primary">@group.Count() permissions</span>
                            </div>
                            <div class="card-body">
                                <ul class="list-group list-group-flush">
                                    @foreach (var permission in group.OrderBy(p => p.Name))
                                    {
                                        <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                                            <div>
                                                <div class="fw-bold">@permission.Name</div>
                                                <small class="text-muted">@permission.Description</small>
                                            </div>
                                            <span class="badge bg-secondary">@permission.Roles.Count</span>
                                        </li>
                                    }
                                </ul>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<!-- Add Permission Modal -->
<div class="modal fade" id="addPermissionModal" tabindex="-1" aria-labelledby="addPermissionModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="addPermissionModalLabel">Add New Permission</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="addPermissionForm">
                <div class="modal-body">
                    <div class="mb-3">
                        <label for="newPermissionName" class="form-label">Permission Name</label>
                        <div class="input-group">
                            <input type="text" class="form-control" id="newPermissionEntity" placeholder="Entity" required>
                            <span class="input-group-text">.</span>
                            <input type="text" class="form-control" id="newPermissionAction" placeholder="Action" required>
                        </div>
                        <div class="form-text">Format: [Entity].[Action] (e.g., Users.Edit)</div>
                    </div>
                    <div class="mb-3">
                        <label for="newPermissionGroup" class="form-label">Group</label>
                        <input type="text" class="form-control" id="newPermissionGroup" list="permissionGroups" required>
                        <datalist id="permissionGroups">
                            @foreach (var group in Model.Select(p => p.Group).Distinct())
                            {
                                <option value="@group">@group</option>
                            }
                        </datalist>
                    </div>
                    <div class="mb-3">
                        <label for="newPermissionDescription" class="form-label">Description</label>
                        <textarea class="form-control" id="newPermissionDescription" rows="3" required></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Create Permission</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Datalist for permission groups -->
<datalist id="permissionGroups">
    @foreach (var group in Model.Select(p => p.Group).Distinct())
    {
        <option value="@group">@group</option>
    }
</datalist>

@section Scripts {
    <script>
        // Initialize DataTable
        $(document).ready(function() {
            $('#permissionsTable').DataTable({
                responsive: true,
                order: [[1, 'asc'], [0, 'asc']], // Sort by group then by name
                pageLength: 25,
                dom: '<"d-flex justify-content-between align-items-center mb-3"f<"d-flex align-items-center"><"d-flex align-items-center"l>>rt<"d-flex justify-content-between align-items-center"ip>',
                language: {
                    search: "",
                    searchPlaceholder: "Search permissions...",
                    lengthMenu: "Show _MENU_ entries",
                    info: "Showing _START_ to _END_ of _TOTAL_ entries",
                    paginate: {
                        previous: "<i class='bi bi-chevron-left'></i>",
                        next: "<i class='bi bi-chevron-right'></i>"
                    }
                },
                columnDefs: [
                    { orderable: false, targets: [5] } // Disable sorting on Actions column
                ],
                initComplete: function() {
                    $('.dataTables_filter input').addClass('form-control');
                    $('.dataTables_length select').addClass('form-select');
                }
            });

            // Initialize tooltips
            var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
            var tooltipList = tooltipTriggerList.map(function (tooltipTriggerEl) {
                return new bootstrap.Tooltip(tooltipTriggerEl);
            });

            // Handle add permission form submission
            document.getElementById('addPermissionForm').addEventListener('submit', function(e) {
                e.preventDefault();
                
                // Combine entity and action
                const entity = document.getElementById('newPermissionEntity').value.trim();
                const action = document.getElementById('newPermissionAction').value.trim();
                const permissionName = `${entity}.${action}`;
                
                // Validate permission name format
                if (!/^[a-zA-Z]+\.[a-zA-Z]+$/.test(permissionName)) {
                    alert('Please enter a valid permission name in the format: Entity.Action');
                    return;
                }
                
                // Here you would typically make an AJAX call to save the permission
                console.log('Adding new permission:', {
                    name: permissionName,
                    group: document.getElementById('newPermissionGroup').value,
                    description: document.getElementById('newPermissionDescription').value
                });
                
                // Close the modal
                const modal = bootstrap.Modal.getInstance(document.getElementById('addPermissionModal'));
                modal.hide();
                
                // Show success message
                alert('Permission created successfully!');
                
                // Reset the form
                this.reset();
            });
            
            // Auto-generate permission name
            const entityInput = document.getElementById('newPermissionEntity');
            const actionInput = document.getElementById('newPermissionAction');
            
            if (entityInput && actionInput) {
                [entityInput, actionInput].forEach(input => {
                    input.addEventListener('input', function() {
                        // You could add auto-formatting or validation here
                    });
                });
            }
        });
    </script>
}
