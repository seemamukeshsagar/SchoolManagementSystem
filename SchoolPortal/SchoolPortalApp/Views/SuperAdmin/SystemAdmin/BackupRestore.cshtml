@{
    ViewData["Title"] = "Backup & Restore";
    Layout = "_Layout";
}

<div class="container-fluid">
    <div class="d-sm-flex align-items-center justify-content-between mb-4">
        <h1 class="h3 mb-0 text-gray-800">Backup & Restore</h1>
    </div>

    <div class="row">
        <!-- Backup Section -->
        <div class="col-xl-6 col-lg-6">
            <div class="card shadow mb-4">
                <div class="card-header py-3">
                    <h6 class="m-0 font-weight-bold text-primary">Create Backup</h6>
                </div>
                <div class="card-body">
                    <form>
                        <div class="form-group">
                            <label>Backup Type</label>
                            <select class="form-control">
                                <option>Full Database</option>
                                <option>Schema Only</option>
                                <option>Data Only</option>
                            </select>
                        </div>
                        <div class="form-group mt-3">
                            <label>Backup Name</label>
                            <input type="text" class="form-control" placeholder="Enter backup name" value="Backup_@DateTime.Now.ToString("yyyyMMdd_HHmmss")">
                        </div>
                        <div class="form-check mt-3">
                            <input class="form-check-input" type="checkbox" id="includeMedia" checked>
                            <label class="form-check-label" for="includeMedia">
                                Include Media Files
                            </label>
                        </div>
                        <button type="submit" class="btn btn-primary mt-3">
                            <i class="fas fa-database me-2"></i>Create Backup
                        </button>
                    </form>
                </div>
            </div>
        </div>

        <!-- Restore Section -->
        <div class="col-xl-6 col-lg-6">
            <div class="card shadow mb-4">
                <div class="card-header py-3">
                    <h6 class="m-0 font-weight-bold text-primary">Restore Backup</h6>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-bordered" id="backupTable" width="100%" cellspacing="0">
                            <thead>
                                <tr>
                                    <th>Name</th>
                                    <th>Date</th>
                                    <th>Size</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td>Backup_20231221_120000.bak</td>
                                    <td>2 hours ago</td>
                                    <td>45.6 MB</td>
                                    <td>
                                        <button class="btn btn-sm btn-primary">Restore</button>
                                        <button class="btn btn-sm btn-danger">Delete</button>
                                    </td>
                                </tr>
                                <tr>
                                    <td>Backup_20231220_000000.bak</td>
                                    <td>1 day ago</td>
                                    <td>45.1 MB</td>
                                    <td>
                                        <button class="btn btn-sm btn-primary">Restore</button>
                                        <button class="btn btn-sm btn-danger">Delete</button>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Backup Settings -->
    <div class="card shadow mb-4">
        <div class="card-header py-3">
            <h6 class="m-0 font-weight-bold text-primary">Backup Settings</h6>
        </div>
        <div class="card-body">
            <form>
                <div class="form-group">
                    <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" id="autoBackup" checked>
                        <label class="form-check-label" for="autoBackup">Enable Automatic Backups</label>
                    </div>
                </div>
                <div class="row mt-3">
                    <div class="col-md-4">
                        <div class="form-group">
                            <label>Backup Frequency</label>
                            <select class="form-control" id="backupFrequency">
                                <option value="daily">Daily</option>
                                <option value="weekly" selected>Weekly</option>
                                <option value="monthly">Monthly</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-group">
                            <label>Backup Time</label>
                            <input type="time" class="form-control" id="backupTime" value="02:00">
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-group">
                            <label>Keep Backups For (days)</label>
                            <input type="number" class="form-control" id="retentionDays" value="30" min="1">
                        </div>
                    </div>
                </div>
                <div class="form-group mt-3">
                    <label>Backup Storage Location</label>
                    <div class="input-group">
                        <input type="text" class="form-control" id="backupLocation" value="C:\Backups\SchoolPortal" readonly>
                        <button class="btn btn-outline-secondary" type="button">Change</button>
                    </div>
                </div>
                <button type="submit" class="btn btn-primary mt-3">
                    <i class="fas fa-save me-2"></i>Save Settings
                </button>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            $('#backupTable').DataTable({
                "pageLength": 5,
                "order": [[1, "desc"]]
            });
        });
    </script>
}