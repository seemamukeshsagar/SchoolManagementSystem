@{
    ViewData["Title"] = "Alerts";
    Layout = "_LayoutSuperAdmin";
}

<div class="container-fluid">
    <div class="d-sm-flex align-items-center justify-content-between mb-4">
        <h1 class="h3 mb-0 text-gray-800">Alerts</h1>
    </div>

    <div class="card shadow mb-4">
        <div class="card-header py-3 d-flex justify-content-between align-items-center">
            <h6 class="m-0 font-weight-bold text-primary">System Alerts</h6>
            <div>
                <button class="btn btn-sm btn-primary">Mark All as Read</button>
            </div>
        </div>
        <div class="card-body">
            <div class="alert alert-warning" role="alert">
                <div class="d-flex justify-content-between">
                    <div>
                        <i class="fas fa-exclamation-triangle me-2"></i>
                        <strong>Warning:</strong> System backup is 2 days overdue.
                    </div>
                    <small class="text-muted">2 hours ago</small>
                </div>
            </div>
            <div class="alert alert-info" role="alert">
                <div class="d-flex justify-content-between">
                    <div>
                        <i class="fas fa-info-circle me-2"></i>
                        <strong>Info:</strong> New user registration: johndoe@example.com
                    </div>
                    <small class="text-muted">5 hours ago</small>
                </div>
            </div>
        </div>
    </div>
</div>