@model IEnumerable<SchoolPortalApp.Models.CleanerListItemViewModel>
@{
    ViewData["Title"] = "Cleaners";
}
<h2>Cleaners</h2>
<p>
    <a class="btn btn-primary" asp-controller="CleanerMaster" asp-action="Create">Create New</a>
</p>
<table class="table table-striped">
    <thead>
        <tr>
            <th>Name</th>
            <th>Father Name</th>
            <th>Is Active</th>
            <th>School</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model)
{
    <tr>
        <td>@item.Name</td>
        <td>@item.FatherName</td>
        <td>@item.IsActive</td>
        <td>@item.SchoolName</td>
        <td>
            <a asp-action="Details" asp-route-id="@item.Id">Details</a> |
            <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
            <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
        </td>
    </tr>
}
    </tbody>
</table>
