@model SchoolPortal.Entities.Models.CleanerMaster
@{
    ViewData["Title"] = "Cleaner Details";
}
<h2>Cleaner Details</h2>
<div>
    <dl class="row">
        <dt class="col-sm-3">Name</dt>
        <dd class="col-sm-9">@Model.Name</dd>
        <dt class="col-sm-3">Father Name</dt>
        <dd class="col-sm-9">@Model.FatherName</dd>
        <dt class="col-sm-3">Description</dt>
        <dd class="col-sm-9">@Model.Description</dd>
        <dt class="col-sm-3">Image</dt>
        <dd class="col-sm-9">
            @if (!string.IsNullOrWhiteSpace(Model.Image))
            {
                <img src="@Model.Image" alt="Cleaner Image" class="img-thumbnail" style="max-height:150px;" />
            }
            else
            {
                @Model.Image
            }
        </dd>
        <dt class="col-sm-3">Active</dt>
        <dd class="col-sm-9">@Model.IsActive</dd>
    </dl>
</div>
<p>
    <a class="btn btn-secondary" asp-action="Index">Back to List</a>
    <a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model.Id">Edit</a>
</p>
