@using Microsoft.AspNetCore.Mvc.Rendering
@model SchoolPortalApp.Models.TimeTableViewModel

<div class="row">
    <div class="col-md-4">
        <div class="form-group">
            <label asp-for="ClassId" class="control-label">Class</label>
            <select asp-for="ClassId" asp-items="Model.Classes" class="form-control" id="ClassId" required>
                <option value="">-- Select Class --</option>
            </select>
            <span asp-validation-for="ClassId" class="text-danger"></span>
        </div>
    </div>
    <div class="col-md-4">
        <div class="form-group">
            <label asp-for="SectionId" class="control-label">Section</label>
            <select asp-for="SectionId" class="form-control" id="SectionId" required>
                <option value="">-- Select Section --</option>
                @if (Model.Sections != null)
                {
                    foreach (var sections in Model.Sections)
                    {
                        <option value="@sections.Value">@sections.Text</option>
                    }
                }
            </select>
            <span asp-validation-for="SectionId" class="text-danger"></span>
        </div>
    </div>
    <div class="col-md-4">
        <div class="form-group">
            <label asp-for="AcademicYearId" class="control-label">Academic Year</label>
            <select asp-for="AcademicYearId" class="form-control" id="AcademicYearId" required>
                <option value="">-- Select Academic Year --</option>
                @if (Model.AcademicYears != null)
                {
                    foreach (var year in Model.AcademicYears)
                    {
                        <option value="@year.Value">@year.Text</option>
                    }
                }
            </select>
            <span asp-validation-for="AcademicYearId" class="text-danger"></span>
        </div>
    </div>
</div>

<div class="row mt-3">
    <div class="col-12">
        <div class="form-group">
            <button type="submit" class="btn btn-primary">Generate TimeTable</button>
            <a asp-action="Index" class="btn btn-secondary">Back to List</a>
        </div>
    </div>
</div>