@model IEnumerable<SchoolPortalApp.Models.DeptDesigDetailsListItemViewModel>

@{
	ViewData["Title"] = "Department Designation Details";
}

<div class="card">
	<div class="card-header d-flex justify-content-between align-items-center">
		<h4>Department Designation Details</h4>
		<a asp-action="Create" class="btn btn-primary">Create New</a>
	</div>
	<div class="card-body">
		@if (TempData["ErrorMessage"] != null)
		{
			<div class="alert alert-danger">@TempData["ErrorMessage"]</div>
		}
		<div class="table-responsive">
			<table class="table table-striped table-hover">
				<thead class="table-dark">
					<tr>
						<th>Department</th>
						<th>Designation</th>
						<th>Company</th>
						<th>School</th>
						<th>Status</th>
						<th>Actions</th>
					</tr>
				</thead>
				<tbody>
					@foreach (var item in Model)
					{
						<tr>
							<td>@item.DepartmentName</td>
							<td>@item.DesignationName</td>
							<td>@item.CompanyName</td>
							<td>@item.SchoolName</td>
							<td>
								@if (item.IsActive)
								{
									<span class="badge bg-success">Active</span>
								}
								else
								{
									<span class="badge bg-danger">Inactive</span>
								}
							</td>
							<td>
								<div class="btn-group btn-group-sm">
									<a asp-action="Details" asp-route-id="@item.Id" class="btn btn-info" title="View Details">
										<i class="bi bi-eye"></i>
									</a>
									<a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning" title="Edit">
										<i class="bi bi-pencil"></i>
									</a>
									<a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger" title="Delete">
										<i class="bi bi-trash"></i>
									</a>
								</div>
							</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
	</div>
</div>