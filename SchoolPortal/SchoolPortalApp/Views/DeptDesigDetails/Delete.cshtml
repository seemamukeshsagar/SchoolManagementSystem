@model SchoolPortal.Entities.Models.DeptDesigDetails

@{
	ViewData["Title"] = "Delete Department Designation";
}

<div class="card">
	<div class="card-header bg-danger text-white">
		<h4>Delete Department Designation</h4>
	</div>
	<div class="card-body">
		<h5 class="text-danger">Are you sure you want to delete this?</h5>
		
		<dl class="row">
			<dt class="col-sm-3">Department</dt>
			<dd class="col-sm-9">@ViewData["DepartmentName"]</dd>

			<dt class="col-sm-3">Designation</dt>
			<dd class="col-sm-9">@ViewData["DesignationName"]</dd>

			<dt class="col-sm-3">Company</dt>
			<dd class="col-sm-9">@ViewData["CompanyName"]</dd>

			<dt class="col-sm-3">School</dt>
			<dd class="col-sm-9">@ViewData["SchoolName"]</dd>

			<dt class="col-sm-3">Status</dt>
			<dd class="col-sm-9">
				@if (Model.IsActive)
				{
					<span class="badge bg-success">Active</span>
				}
				else
				{
					<span class="badge bg-danger">Inactive</span>
				}
			</dd>
		</dl>

		<form asp-action="Delete" method="post">
			<input type="hidden" asp-for="Id" />
			<button type="submit" class="btn btn-danger">Delete</button>
			<a asp-action="Index" class="btn btn-secondary">Back to List</a>
		</form>
	</div>
</div>