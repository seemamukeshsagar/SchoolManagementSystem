@model SchoolPortalApp.Models.VisitorDetailsViewModel
@{
    ViewData["Title"] = "Visitor Details";
}
<h2>Visitor Details</h2>
<dl class="row">
    <dt class="col-sm-3">Vehicle Number</dt><dd class="col-sm-9">@Model.VehicleNumber</dd>
    <dt class="col-sm-3">Vehicle Name</dt><dd class="col-sm-9">@Model.VehicleName</dd>
    <dt class="col-sm-3">Date Of Entry</dt><dd class="col-sm-9">@Model.DateOfEntry.ToString("yyyy-MM-dd")</dd>
    <dt class="col-sm-3">Arrival Time</dt><dd class="col-sm-9">@Model.ArrivalTime</dd>
    <dt class="col-sm-3">Exit Time</dt><dd class="col-sm-9">@Model.ExitTime</dd>
    <dt class="col-sm-3">Purpose</dt><dd class="col-sm-9">@Model.Purpose</dd>
    <dt class="col-sm-3">Contact Person</dt><dd class="col-sm-9">@Model.ContactPerson</dd>
    <dt class="col-sm-3">Address 1</dt><dd class="col-sm-9">@Model.Address1</dd>
    <dt class="col-sm-3">Address 2</dt><dd class="col-sm-9">@Model.Address2</dd>
    <dt class="col-sm-3">Country</dt><dd class="col-sm-9">@Model.CountryName</dd>
    <dt class="col-sm-3">State</dt><dd class="col-sm-9">@Model.StateName</dd>
    <dt class="col-sm-3">City</dt><dd class="col-sm-9">@Model.CityName</dd>
    <dt class="col-sm-3">Zip Code</dt><dd class="col-sm-9">@Model.ZipCode</dd>
    <dt class="col-sm-3">Company</dt><dd class="col-sm-9">@Model.CompanyName</dd>
    <dt class="col-sm-3">School</dt><dd class="col-sm-9">@Model.SchoolName</dd>
    <dt class="col-sm-3">Active</dt><dd class="col-sm-9">@(Model.IsActive ? "Yes" : "No")</dd>
</dl>
<div>
    <a class="btn btn-secondary" asp-action="Index">Back</a>
    <a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model.Id">Edit</a>
</div>