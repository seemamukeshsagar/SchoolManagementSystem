@using SchoolPortalApp.Models.Attendance
@model StudentAttendanceDetailsViewModel

@{
    ViewData["Title"] = "Attendance Details";
}

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h4 class="mb-0">Attendance Details</h4>
        <div>
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">
                <i class="fas fa-edit"></i> Edit
            </a>
            <a asp-action="Index" class="btn btn-secondary">
                <i class="fas fa-arrow-left"></i> Back to List
            </a>
        </div>
    </div>
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">Student Name</dt>
            <dd class="col-sm-9">@Model.StudentName</dd>

            <dt class="col-sm-3">Class</dt>
            <dd class="col-sm-9">@Model.ClassName</dd>

            <dt class="col-sm-3">Section</dt>
            <dd class="col-sm-9">@Model.SectionName</dd>

            <dt class="col-sm-3">Attendance Date</dt>
            <dd class="col-sm-9">@Model.AttendenceDate.ToString("dd-MMM-yyyy")</dd>

            <dt class="col-sm-3">Status</dt>
            <dd class="col-sm-9">
                @if (Model.AttendenceStatus)
                {
                    <span class="badge bg-success">Present</span>
                }
                else
                {
                    <span class="badge bg-danger">Absent</span>
                }
            </dd>

            @if (!string.IsNullOrEmpty(Model.AttendenceTime))
            {
                <dt class="col-sm-3">Time</dt>
                <dd class="col-sm-9">@Model.AttendenceTime</dd>
            }

            @if (Model.AttendanceReasonId != Guid.Empty)
            {
                <dt class="col-sm-3">Reason</dt>
                <dd class="col-sm-9">@Model.AttendanceReason</dd>
            }

            <dt class="col-sm-3">Status</dt>
            <dd class="col-sm-9">
                <span class="badge @(Model.Status == "ACT" ? "bg-success" : "bg-warning")">
                    @Model.Status
                </span>
            </dd>

            @if (!string.IsNullOrEmpty(Model.StatusMessage))
            {
                <dt class="col-sm-3">Status Message</dt>
                <dd class="col-sm-9">@Model.StatusMessage</dd>
            }
        </dl>
    </div>
</div>