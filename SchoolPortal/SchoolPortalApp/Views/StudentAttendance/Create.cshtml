@using SchoolPortalApp.Models.Attendance
@model StudentAttendanceViewModel

@{
    ViewData["Title"] = "Create Attendance Record";
}

<div class="card">
    <div class="card-header">
        <h4 class="mb-0">@ViewData["Title"]</h4>
    </div>
    <div class="card-body">
        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            
            <div class="row mb-3">
                <div class="col-md-6">
                    <div class="form-group">
                        <label asp-for="StudentGUID" class="form-label">Student <span class="text-danger">*</span></label>
                        <select asp-for="StudentGUID" asp-items="Model.Students" class="form-select" required>
                            <option value="">-- Select Student --</option>
                        </select>
                        <span asp-validation-for="StudentGUID" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label asp-for="ClassId" class="form-label">Class <span class="text-danger">*</span></label>
                        <select asp-for="ClassId" asp-items="Model.Classes" class="form-select" required>
                            <option value="">-- Select Class --</option>
                        </select>
                        <span asp-validation-for="ClassId" class="text-danger"></span>
                    </div>
                </div>
            </div>

            <div class="row mb-3">
                <div class="col-md-6">
                    <div class="form-group">
                        <label asp-for="SectionId" class="form-label">Section <span class="text-danger">*</span></label>
                        <select asp-for="SectionId" asp-items="Model.Sections" class="form-select" required>
                            <option value="">-- Select Section --</option>
                        </select>
                        <span asp-validation-for="SectionId" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label asp-for="AttendenceDate" class="form-label">Date <span class="text-danger">*</span></label>
                        <input asp-for="AttendenceDate" class="form-control" type="date" required />
                        <span asp-validation-for="AttendenceDate" class="text-danger"></span>
                    </div>
                </div>
            </div>

            <div class="row mb-3">
                <div class="col-md-6">
                    <div class="form-group">
                        <label asp-for="AttendenceStatus" class="form-label">Status</label>
                        <div class="form-check form-switch mt-2">
                            <input class="form-check-input" type="checkbox" asp-for="AttendenceStatus" />
                            <label class="form-check-label" asp-for="AttendenceStatus">Mark as Present</label>
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label asp-for="AttendenceTime" class="form-label">Time</label>
                        <input asp-for="AttendenceTime" class="form-control" type="time" />
                        <span asp-validation-for="AttendenceTime" class="text-danger"></span>
                    </div>
                </div>
            </div>

            <div class="row mb-3">
                <div class="col-12">
                    <div class="form-group">
                        <label asp-for="AttendanceReasonId" class="form-label">Reason (if absent)</label>
                        <select asp-for="AttendanceReasonId" asp-items="Model.AttendanceReasons" class="form-select">
                            <option value="">-- Select Reason --</option>
                        </select>
                        <span asp-validation-for="AttendanceReasonId" class="text-danger"></span>
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-12">
                    <div class="form-group">
                        <button type="submit" class="btn btn-primary">
                            <i class="fas fa-save"></i> Save
                        </button>
                        <a asp-action="Index" class="btn btn-secondary">
                            <i class="fas fa-arrow-left"></i> Back to List
                        </a>
                    </div>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    
    <script>
        $(document).ready(function() {
            // Handle class change to filter sections
            $('#ClassId').change(function() {
                var classId = $(this).val();
                if (classId) {
                    // You may need to implement an API endpoint to get sections by class
                    // For now, we'll just enable/disable the section dropdown
                    $('#SectionId').prop('disabled', !classId);
                } else {
                    $('#SectionId').prop('disabled', true).val('');
                }
            });
            
            // Set the current time if not set
            if (!$('#AttendenceTime').val()) {
                var now = new Date();
                var timeString = now.getHours().toString().padStart(2, '0') + ':' + 
                                now.getMinutes().toString().padStart(2, '0');
                $('#AttendenceTime').val(timeString);
            }
        });
    </script>
}