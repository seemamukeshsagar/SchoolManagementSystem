@model SchoolPortal.Entities.Models.DeptMaster

@{
    ViewData["Title"] = "Delete Department";
}

<div class="card">
    <div class="card-header bg-danger text-white">
        <h4 class="mb-0">Delete Department</h4>
    </div>
    <div class="card-body">
        <h5 class="text-danger">Are you sure you want to delete this department?</h5>
        <hr />
        
        @if (ViewData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger">@ViewData["ErrorMessage"]</div>
        }

        <dl class="row">
            <dt class="col-sm-3">Department Code</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.DeptCode)</dd>

            <dt class="col-sm-3">Department Name</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.DeptName)</dd>

            <dt class="col-sm-3">Status</dt>
            <dd class="col-sm-9">
                @if (Model.IsActive)
                {
                    <span class="badge bg-success">Active</span>
                }
                else
                {
                    <span class="badge bg-danger">Inactive</span>
                }
            </dd>
        </dl>

        <form asp-action="Delete" method="post">
            <input type="hidden" asp-for="Id" />
            <button type="submit" class="btn btn-danger">Delete</button>
            <a asp-action="Index" class="btn btn-secondary">Back to List</a>
        </form>
    </div>
</div>