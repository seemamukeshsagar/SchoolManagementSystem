@{
    ViewBag.Title = "Payment Failed";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card border-danger">
                <div class="card-header bg-danger text-white">
                    <h4 class="mb-0">Payment Failed</h4>
                </div>
                <div class="card-body text-center">
                    <div class="mb-4">
                        <i class="fas fa-times-circle fa-5x text-danger mb-3"></i>
                        <h3>Payment Unsuccessful</h3>
                        <p class="lead">We couldn't process your payment.</p>
                    </div>
                    
                    <div class="alert alert-danger" role="alert">
                        <h4 class="alert-heading">Error Details</h4>
                        <p>@(ViewBag.ErrorMessage ?? "An error occurred while processing your payment. Please try again.")</p>
                    </div>
                    
                    <div class="mt-4">
                        <a href="@Url.Action("Payment", "Payment")" class="btn btn-primary">
                            <i class="fas fa-credit-card me-2"></i>Try Again
                        </a>
                        <a href="@Url.Action("Index", "Home")" class="btn btn-outline-secondary ms-2">
                            <i class="fas fa-home me-2"></i>Return to Home
                        </a>
                    </div>
                    
                    <div class="mt-4">
                        <p class="text-muted small">
                            Need help? <a href="@Url.Action("Contact", "Home")">Contact support</a> if the problem persists.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>