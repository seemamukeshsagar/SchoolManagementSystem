@model SchoolPortalApp.Models.EmpTypeDetailsViewModel
@{ 
	ViewData["Title"] = "Employee Type Details";
}
<h2>Employee Type Details</h2>
<div class="mb-3">
	<strong>Type Name:</strong> @Model.TypeName
</div>
<div class="mb-3">
	<strong>Description:</strong> @Model.Description
</div>
<div class="mb-3">
	<strong>Company:</strong> @Model.CompanyName
</div>
<div class="mb-3">
	<strong>School:</strong> @Model.SchoolName
</div>
<div class="mb-3">
	<strong>Active:</strong> @Model.IsActive
</div>

<p>
	<a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model.Id">Edit</a>
	<a class="btn btn-secondary" asp-action="Index">Back</a>
</p>

