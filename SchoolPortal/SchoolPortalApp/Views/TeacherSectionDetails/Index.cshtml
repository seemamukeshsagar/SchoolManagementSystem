@model IEnumerable<SchoolPortalApp.Models.TeacherSectionDetailsListItemViewModel>
@{
    ViewData["Title"] = "Teacher Section Details";
}
<h2>Teacher Section Details</h2>
<p>
    <a asp-action="Create" class="btn btn-primary">Create New</a>
</p>
<table class="table table-striped">
    <thead>
        <tr>
            <th>Teacher</th>
            <th>Class</th>
            <th>Section</th>
            <th>Subject</th>
            <th>Class Teacher</th>
            <th>Active</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.TeacherName</td>
            <td>@item.ClassName</td>
            <td>@item.SectionName</td>
            <td>@item.SubjectName</td>
            <td>@(item.IsClassTeacher ? "Yes" : "No")</td>
            <td>@(item.IsActive ? "Yes" : "No")</td>
            <td>
                <div class="btn-group btn-group-sm">
                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-info" title="View Details">
                        <i class="bi bi-eye"></i>
                    </a>
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning" title="Edit">
                        <i class="bi bi-pencil"></i>
                    </a>
                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger" title="Delete">
                        <i class="bi bi-trash"></i>
                    </a>
                </div>
            </td>
        </tr>
    }
    </tbody>
</table>