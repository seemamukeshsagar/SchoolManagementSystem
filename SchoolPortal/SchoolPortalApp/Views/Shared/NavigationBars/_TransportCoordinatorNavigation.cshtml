@using SchoolPortalApp.Helpers

<nav class="nav-sidebar" id="sidebar">
    <div class="sidebar-header">
        <h3>Transport Coordinator</h3>
    </div>

    <div class="accordion" id="sidebarAccordion">
        <ul class="nav nav-pills flex-column mb-2">
            <li class="nav-item">
                <a href="@Url.Action("Index", "Home")"
                   class="nav-link @(ViewHelper.IsActive(ViewContext, "Home") ? "active" : "")"
                   data-tooltip="Home">
                    <i class="bi bi-house-door"></i>
                    <span>Home</span>
                </a>
            </li>
        </ul>

        <!-- DASHBOARD -->
        <div class="accordion-item">
            <h2 class="accordion-header" id="heading-dashboard">
                <button class="accordion-button collapsed" type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#collapse-dashboard"
                        aria-expanded="true"
                        aria-controls="collapse-dashboard"
                        data-tooltip="Dashboard">
                    <i class="bi bi-speedometer2 me-2"></i>
                    <span>My Dashboard</span>
                </button>
            </h2>
            <div id="collapse-dashboard" class="accordion-collapse collapse @(ViewHelper.IsActive(ViewContext, "Student", "Dashboard") || 
                                                                  ViewHelper.IsActive(ViewContext, "Student", "Timetable") ||
                                                                  ViewHelper.IsActive(ViewContext, "Student", "Attendance") ? "show" : "")"
                 aria-labelledby="heading-dashboard" data-bs-parent="#sidebarAccordion">
                <div class="accordion-body p-0">
                    <ul class="nav flex-column ms-3 mb-2">
                        <li class="nav-item"><a href="@Url.Action("Dashboard", "Student")" 
                              class="nav-link @(ViewHelper.IsActive(ViewContext, "Student", "Dashboard") ? "active" : "")">Overview</a></li>
                        <li class="nav-item"><a href="@Url.Action("Timetable", "Student")" 
                              class="nav-link @(ViewHelper.IsActive(ViewContext, "Student", "Timetable") ? "active" : "")">My Timetable</a></li>
                        <li class="nav-item"><a href="@Url.Action("Attendance", "Student")" 
                              class="nav-link @(ViewHelper.IsActive(ViewContext, "Student", "Attendance") ? "active" : "")">My Attendance</a></li>
                    </ul>
                </div>
            </div>
        </div>

        <!-- ACADEMICS -->
        <div class="accordion-item">
            <h2 class="accordion-header" id="heading-academics">
                <button class="accordion-button collapsed" type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#collapse-academics"
                        aria-expanded="false"
                        aria-controls="collapse-academics"
                        data-tooltip="Academics">
                    <i class="bi bi-mortarboard me-2"></i>
                    <span>Academics</span>
                </button>
            </h2>
            <div id="collapse-academics" class="accordion-collapse collapse @(ViewHelper.IsActive(ViewContext, "Student", "Subjects") || 
                                                                   ViewHelper.IsActive(ViewContext, "Student", "Assignments") ||
                                                                   ViewHelper.IsActive(ViewContext, "Student", "Grades") ? "show" : "")"
                 aria-labelledby="heading-academics" data-bs-parent="#sidebarAccordion">
                <div class="accordion-body p-0">
                    <ul class="nav flex-column ms-3 mb-2">
                        <li class="nav-item"><a href="@Url.Action("Subjects", "Student")" 
                              class="nav-link @(ViewHelper.IsActive(ViewContext, "Student", "Subjects") ? "active" : "")">My Subjects</a></li>
                        <li class="nav-item"><a href="@Url.Action("Assignments", "Student")" 
                              class="nav-link @(ViewHelper.IsActive(ViewContext, "Student", "Assignments") ? "active" : "")">Assignments</a></li>
                        <li class="nav-item"><a href="@Url.Action("Grades", "Student")" 
                              class="nav-link @(ViewHelper.IsActive(ViewContext, "Student", "Grades") ? "active" : "")">Grades</a></li>
                    </ul>
                </div>
            </div>
        </div>

        <!-- EXAMINATIONS -->
        <div class="accordion-item">
            <h2 class="accordion-header" id="heading-examinations">
                <button class="accordion-button collapsed" type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#collapse-examinations"
                        aria-expanded="false"
                        aria-controls="collapse-examinations"
                        data-tooltip="Examinations">
                    <i class="bi bi-journal-text me-2"></i>
                    <span>Examinations</span>
                </button>
            </h2>
            <div id="collapse-examinations" class="accordion-collapse collapse @(ViewHelper.IsActive(ViewContext, "Student", "ExamSchedule") || 
                                                                     ViewHelper.IsActive(ViewContext, "Student", "ExamResults") ? "show" : "")"
                 aria-labelledby="heading-examinations" data-bs-parent="#sidebarAccordion">
                <div class="accordion-body p-0">
                    <ul class="nav flex-column ms-3 mb-2">
                        <li class="nav-item"><a href="@Url.Action("ExamSchedule", "Student")" 
                              class="nav-link @(ViewHelper.IsActive(ViewContext, "Student", "ExamSchedule") ? "active" : "")">Exam Schedule</a></li>
                        <li class="nav-item"><a href="@Url.Action("ExamResults", "Student")" 
                              class="nav-link @(ViewHelper.IsActive(ViewContext, "Student", "ExamResults") ? "active" : "")">Exam Results</a></li>
                    </ul>
                </div>
            </div>
        </div>

        <!-- LIBRARY -->
        <div class="accordion-item">
            <h2 class="accordion-header" id="heading-library">
                <button class="accordion-button collapsed" type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#collapse-library"
                        aria-expanded="false"
                        aria-controls="collapse-library"
                        data-tooltip="Library">
                    <i class="bi bi-book me-2"></i>
                    <span>Library</span>
                </button>
            </h2>
            <div id="collapse-library" class="accordion-collapse collapse @(ViewHelper.IsActive(ViewContext, "Student", "LibraryBooks") || 
                                                                 ViewHelper.IsActive(ViewContext, "Student", "BorrowedBooks") ? "show" : "")"
                 aria-labelledby="heading-library" data-bs-parent="#sidebarAccordion">
                <div class="accordion-body p-0">
                    <ul class="nav flex-column ms-3 mb-2">
                        <li class="nav-item"><a href="@Url.Action("LibraryBooks", "Student")" 
                              class="nav-link @(ViewHelper.IsActive(ViewContext, "Student", "LibraryBooks") ? "active" : "")">Browse Books</a></li>
                        <li class="nav-item"><a href="@Url.Action("BorrowedBooks", "Student")" 
                              class="nav-link @(ViewHelper.IsActive(ViewContext, "Student", "BorrowedBooks") ? "active" : "")">My Borrowed Books</a></li>
                    </ul>
                </div>
            </div>
        </div>

        <!-- SETTINGS -->
        <div class="accordion-item">
            <h2 class="accordion-header" id="heading-settings">
                <button class="accordion-button collapsed" type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#collapse-settings"
                        aria-expanded="false"
                        aria-controls="collapse-settings"
                        data-tooltip="Settings">
                    <i class="bi bi-gear me-2"></i>
                    <span>Settings</span>
                </button>
            </h2>
            <div id="collapse-settings" class="accordion-collapse collapse @(ViewHelper.IsActive(ViewContext, "Account", "Profile") || 
                                                                  ViewHelper.IsActive(ViewContext, "Account", "ChangePassword") ? "show" : "")"
                 aria-labelledby="heading-settings" data-bs-parent="#sidebarAccordion">
                <div class="accordion-body p-0">
                    <ul class="nav flex-column ms-3 mb-2">
                        <li class="nav-item"><a href="@Url.Action("Profile", "Account")" 
                              class="nav-link @(ViewHelper.IsActive(ViewContext, "Account", "Profile") ? "active" : "")">My Profile</a></li>
                        <li class="nav-item"><a href="@Url.Action("ChangePassword", "Account")" 
                              class="nav-link @(ViewHelper.IsActive(ViewContext, "Account", "ChangePassword") ? "active" : "")">Change Password</a></li>
                        <li class="nav-item"><a href="@Url.Action("Logout", "Account")" class="nav-link">Logout</a></li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</nav>