@using SchoolPortalApp.Helpers
@{
    Layout = "_BaseNavigationBar";
}

<ul class="nav nav-pills flex-column mb-2">
    <li class="nav-item">
        <a href="@Url.Action("Index", "Home")" 
           class="nav-link @(ViewHelper.IsActive(ViewContext, "Home") ? "active" : "")" 
           data-tooltip="Home">
            <i class="bi bi-house-door"></i>
            <span>Home</span>
        </a>
    </li>
</ul>

<!-- DASHBOARD -->
<div class="accordion-item">
    <h2 class="accordion-header" id="heading-dashboard">
        <button class="accordion-button collapsed" type="button"
                data-bs-toggle="collapse"
                data-bs-target="#collapse-dashboard"
                aria-expanded="true"
                aria-controls="collapse-dashboard"
                data-tooltip="Dashboard">
            <i class="bi bi-speedometer2 me-2"></i>
            <span>Dashboard</span>
        </button>
    </h2>
    <div id="collapse-dashboard" class="accordion-collapse collapse @(ViewHelper.IsActive(ViewContext, "SuperAdmin", "Dashboard") || 
                                                                  ViewHelper.IsActive(ViewContext, "SuperAdmin", "SystemHealth") ||
                                                                  ViewHelper.IsActive(ViewContext, "SuperAdmin", "QuickActions") ||
                                                                  ViewHelper.IsActive(ViewContext, "SuperAdmin", "Alerts") ? "show" : "")" 
         aria-labelledby="heading-dashboard" data-bs-parent="#sidebarAccordion">
        <div class="accordion-body p-0">
            <ul class="nav flex-column ms-1 mb-2">
                <li><a href="@Url.Action("Dashboard", "SuperAdmin")" 
                      class="nav-link @(ViewHelper.IsActive(ViewContext, "SuperAdmin", "Dashboard") ? "active" : "")">System Overview</a></li>
                <li><a href="@Url.Action("SystemHealth", "SuperAdmin")" 
                      class="nav-link @(ViewHelper.IsActive(ViewContext, "SuperAdmin", "SystemHealth") ? "active" : "")">System Health</a></li>
                <li><a href="@Url.Action("QuickActions", "SuperAdmin")" 
                      class="nav-link @(ViewHelper.IsActive(ViewContext, "SuperAdmin", "QuickActions") ? "active" : "")">Quick Actions</a></li>
                <li><a href="@Url.Action("Alerts", "SuperAdmin")" 
                      class="nav-link @(ViewHelper.IsActive(ViewContext, "SuperAdmin", "Alerts") ? "active" : "")">Critical Alerts</a></li>
            </ul>
        </div>
    </div>
</div>

<!-- SYSTEM ADMINISTRATION -->
<div class="accordion-item">
    <h2 class="accordion-header" id="heading-system">
        <button class="accordion-button collapsed" type="button"
                data-bs-toggle="collapse"
                data-bs-target="#collapse-system"
                aria-expanded="false"
                aria-controls="collapse-system"
                data-tooltip="System Administration">
            <i class="bi bi-server me-2"></i>
            <span>System Administration</span>
        </button>
    </h2>
    <div id="collapse-system" class="accordion-collapse collapse @(ViewHelper.IsActive(ViewContext, "SuperAdmin", "SystemSettings") || 
                                                               ViewHelper.IsActive(ViewContext, "SuperAdmin", "Database") ||
                                                               ViewHelper.IsActive(ViewContext, "SuperAdmin", "BackupRestore") ? "show" : "")" 
         aria-labelledby="heading-system" data-bs-parent="#sidebarAccordion">
        <div class="accordion-body p-0">
            <ul class="nav flex-column ms-1 mb-2">
                <li><a href="@Url.Action("SystemSettings", "SuperAdmin")" 
                      class="nav-link @(ViewHelper.IsActive(ViewContext, "SuperAdmin", "SystemSettings") ? "active" : "")">System Settings</a></li>
                <li><a href="@Url.Action("Database", "SuperAdmin")" 
                      class="nav-link @(ViewHelper.IsActive(ViewContext, "SuperAdmin", "Database") ? "active" : "")">Database Management</a></li>
                <li><a href="@Url.Action("BackupRestore", "SuperAdmin")" 
                      class="nav-link @(ViewHelper.IsActive(ViewContext, "SuperAdmin", "BackupRestore") ? "active" : "")">Backup & Restore</a></li>
            </ul>
        </div>
    </div>
</div>

<!-- USER MANAGEMENT -->
<div class="accordion-item">
    <h2 class="accordion-header" id="heading-users">
        <button class="accordion-button collapsed" type="button"
                data-bs-toggle="collapse"
                data-bs-target="#collapse-users"
                aria-expanded="false"
                aria-controls="collapse-users"
                data-tooltip="User Management">
            <i class="bi bi-people me-2"></i>
            <span>User Management</span>
        </button>
    </h2>
    <div id="collapse-users" class="accordion-collapse collapse @(ViewHelper.IsActive(ViewContext, "SuperAdmin", "Users") || 
                                                              ViewHelper.IsActive(ViewContext, "SuperAdmin", "Roles") ||
                                                              ViewHelper.IsActive(ViewContext, "SuperAdmin", "Permissions") ? "show" : "")" 
         aria-labelledby="heading-users" data-bs-parent="#sidebarAccordion">
        <div class="accordion-body p-0">
            <ul class="nav flex-column ms-1 mb-2">
                <li><a href="@Url.Action("Index", "UserDetails")" 
                      class="nav-link @(ViewHelper.IsActive(ViewContext, "UserDetails", "Index") ? "active" : "")">All Users</a></li>
                <li><a href="@Url.Action("Roles", "SuperAdmin")" 
                      class="nav-link @(ViewHelper.IsActive(ViewContext, "SuperAdmin", "Roles") ? "active" : "")">Roles</a></li>
                <li><a href="@Url.Action("Permissions", "SuperAdmin")" 
                      class="nav-link @(ViewHelper.IsActive(ViewContext, "SuperAdmin", "Permissions") ? "active" : "")">Permissions</a></li>
            </ul>
        </div>
    </div>
</div>

<!-- SECURITY -->
<div class="accordion-item">
    <h2 class="accordion-header" id="heading-security">
        <button class="accordion-button collapsed" type="button"
                data-bs-toggle="collapse"
                data-bs-target="#collapse-security"
                aria-expanded="false"
                aria-controls="collapse-security"
                data-tooltip="Security">
            <i class="bi bi-shield-lock me-2"></i>
            <span>Security</span>
        </button>
    </h2>
    <div id="collapse-security" class="accordion-collapse collapse @(ViewHelper.IsActive(ViewContext, "SuperAdmin", "AuditLogs") || 
                                                                 ViewHelper.IsActive(ViewContext, "SuperAdmin", "SecuritySettings") ? "show" : "")" 
         aria-labelledby="heading-security" data-bs-parent="#sidebarAccordion">
        <div class="accordion-body p-0">
            <ul class="nav flex-column ms-1 mb-2">
                <li><a href="@Url.Action("AuditLogs", "SuperAdmin")" 
                      class="nav-link @(ViewHelper.IsActive(ViewContext, "SuperAdmin", "AuditLogs") ? "active" : "")">Audit Logs</a></li>
                <li><a href="@Url.Action("SecuritySettings", "SuperAdmin")" 
                      class="nav-link @(ViewHelper.IsActive(ViewContext, "SuperAdmin", "SecuritySettings") ? "active" : "")">Security Settings</a></li>
            </ul>
        </div>
    </div>
</div>

<!-- SETTINGS -->
<div class="accordion-item">
    <h2 class="accordion-header" id="heading-settings">
        <button class="accordion-button collapsed" type="button"
                data-bs-toggle="collapse"
                data-bs-target="#collapse-settings"
                aria-expanded="false"
                aria-controls="collapse-settings"
                data-tooltip="Settings">
            <i class="bi bi-gear me-2"></i>
            <span>Settings</span>
        </button>
    </h2>
    <div id="collapse-settings" class="accordion-collapse collapse @(ViewHelper.IsActive(ViewContext, "Account", "Profile") || 
                                                                  ViewHelper.IsActive(ViewContext, "Account", "ChangePassword") ? "show" : "")" 
         aria-labelledby="heading-settings" data-bs-parent="#sidebarAccordion">
        <div class="accordion-body p-0">
            <ul class="nav flex-column ms-1 mb-2">
                <li><a href="@Url.Action("Profile", "Account")" 
                      class="nav-link @(ViewHelper.IsActive(ViewContext, "Account", "Profile") ? "active" : "")">My Profile</a></li>
                <li><a href="@Url.Action("ChangePassword", "Account")" 
                      class="nav-link @(ViewHelper.IsActive(ViewContext, "Account", "ChangePassword") ? "active" : "")">Change Password</a></li>
                <li><a href="@Url.Action("Logout", "Account")" class="nav-link">Logout</a></li>
            </ul>
        </div>
    </div>
</div>