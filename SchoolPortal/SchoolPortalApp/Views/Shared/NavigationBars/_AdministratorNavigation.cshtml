@using SchoolPortalApp.Helpers
@{
    Layout = "_BaseNavigationBar";
}

<ul class="nav nav-pills flex-column mb-2">
    <li class="nav-item">
        <a href="@Url.Action("Index", "Home")" 
           class="nav-link @(ViewHelper.IsActive(ViewContext, "Home") ? "active" : "")" 
           data-tooltip="Home">
            <i class="bi bi-house-door"></i>
            <span>Home</span>
        </a>
    </li>
</ul>

<!-- ADMINISTRATION -->
<div class="accordion-item">
    <h2 class="accordion-header" id="heading-admin">
        <button class="accordion-button collapsed" type="button"
                data-bs-toggle="collapse"
                data-bs-target="#collapse-admin"
                aria-expanded="true"
                aria-controls="collapse-admin"
                data-tooltip="Administration">
            <i class="bi bi-gear me-2"></i>
            <span>Administration</span>
        </button>
    </h2>
    <div id="collapse-admin" class="accordion-collapse collapse @(ViewHelper.IsActive(ViewContext, "Company") || 
                                                              ViewHelper.IsActive(ViewContext, "School") ||
                                                              ViewHelper.IsActive(ViewContext, "UserDetails") ||
                                                              ViewHelper.IsActive(ViewContext, "RoleMaster") ||
                                                              ViewHelper.IsActive(ViewContext, "DeptMaster") ||
                                                              ViewHelper.IsActive(ViewContext, "DesigMaster") ||
                                                              ViewHelper.IsActive(ViewContext, "Emp") ||
                                                              ViewHelper.IsActive(ViewContext, "EmpTypeMaster") ||
                                                              ViewHelper.IsActive(ViewContext, "Privileges") ||
                                                              ViewHelper.IsActive(ViewContext, "RolePrivileges") ||
                                                              ViewHelper.IsActive(ViewContext, "SystemParameters") ||
                                                              ViewHelper.IsActive(ViewContext, "TaskSchedules") ||
                                                              ViewHelper.IsActive(ViewContext, "HolidayMaster") ? "show" : "")" 
         aria-labelledby="heading-admin" data-bs-parent="#sidebarAccordion">
        <div class="accordion-body p-0">
            <ul class="nav flex-column ms-1 mb-2">
                <!-- General -->
                <li class="nav-item text-uppercase small px-3 pt-2" style="background-color: wheat;">General</li>
                <li><a href="@Url.Action("Index", "Company")" 
                      class="nav-link @(ViewHelper.IsActive(ViewContext, "Company") ? "active" : "")">Companies</a></li>
                <li><a href="@Url.Action("Index", "School")" 
                      class="nav-link @(ViewHelper.IsActive(ViewContext, "School") ? "active" : "")">School</a></li>
                <li><a href="@Url.Action("Index", "UserDetails")" 
                      class="nav-link @(ViewHelper.IsActive(ViewContext, "UserDetails") ? "active" : "")">Users</a></li>
                <li><a href="@Url.Action("Index", "RoleMaster")" 
                      class="nav-link @(ViewHelper.IsActive(ViewContext, "RoleMaster") ? "active" : "")">Roles</a></li>
                <li><a href="@Url.Action("Index", "DeptMaster")" 
                      class="nav-link @(ViewHelper.IsActive(ViewContext, "DeptMaster") ? "active" : "")">Departments</a></li>
                <li><a href="@Url.Action("Index", "DesigMaster")" 
                      class="nav-link @(ViewHelper.IsActive(ViewContext, "DesigMaster") ? "active" : "")">Designations</a></li>
                <li><a href="@Url.Action("Index", "Emp")" 
                      class="nav-link @(ViewHelper.IsActive(ViewContext, "Emp") ? "active" : "")">Employees</a></li>
                <li><a href="@Url.Action("Index", "EmpTypeMaster")" 
                      class="nav-link @(ViewHelper.IsActive(ViewContext, "EmpTypeMaster") ? "active" : "")">Employee Type Master</a></li>
                <li><a href="@Url.Action("Index", "Privileges")" 
                      class="nav-link @(ViewHelper.IsActive(ViewContext, "Privileges") ? "active" : "")">Privileges</a></li>
                <li><a href="@Url.Action("Index", "RolePrivileges")" 
                      class="nav-link @(ViewHelper.IsActive(ViewContext, "RolePrivileges") ? "active" : "")">Role Privileges</a></li>
                <li><a href="@Url.Action("Index", "SystemParameters")" 
                      class="nav-link @(ViewHelper.IsActive(ViewContext, "SystemParameters") ? "active" : "")">System Parameters</a></li>
                <li><a href="@Url.Action("Index", "TaskSchedules")" 
                      class="nav-link @(ViewHelper.IsActive(ViewContext, "TaskSchedules") ? "active" : "")">Schedules</a></li>
                <li><a href="@Url.Action("Index", "HolidayMaster")" 
                      class="nav-link @(ViewHelper.IsActive(ViewContext, "HolidayMaster") ? "active" : "")">Holiday</a></li>

                <!-- Masters -->
                <li class="nav-item text-uppercase small px-3 pt-2" style="background-color: wheat;">Masters</li>
                <li><a href="@Url.Action("Index", "CategoryMaster")" 
                      class="nav-link @(ViewHelper.IsActive(ViewContext, "CategoryMaster") ? "active" : "")">Category Master</a></li>
                <li><a href="@Url.Action("Index", "CasteMaster")" 
                      class="nav-link @(ViewHelper.IsActive(ViewContext, "CasteMaster") ? "active" : "")">Caste Master</a></li>
                <li><a href="@Url.Action("Index", "ReligionMaster")" 
                      class="nav-link @(ViewHelper.IsActive(ViewContext, "ReligionMaster") ? "active" : "")">Religion Master</a></li>
                <li><a href="@Url.Action("Index", "BloodGroup")" 
                      class="nav-link @(ViewHelper.IsActive(ViewContext, "BloodGroup") ? "active" : "")">Blood Group</a></li>
                <li><a href="@Url.Action("Index", "CountryMaster")" 
                      class="nav-link @(ViewHelper.IsActive(ViewContext, "CountryMaster") ? "active" : "")">Country Master</a></li>
                <li><a href="@Url.Action("Index", "StateMaster")" 
                      class="nav-link @(ViewHelper.IsActive(ViewContext, "StateMaster") ? "active" : "")">State Master</a></li>
                <li><a href="@Url.Action("Index", "CityMaster")" 
                      class="nav-link @(ViewHelper.IsActive(ViewContext, "CityMaster") ? "active" : "")">City Master</a></li>
                <li><a href="@Url.Action("Index", "LanguageMaster")" 
                      class="nav-link @(ViewHelper.IsActive(ViewContext, "LanguageMaster") ? "active" : "")">Language Master</a></li>
            </ul>
        </div>
    </div>
</div>

<!-- ACADEMICS -->
<div class="accordion-item">
    <h2 class="accordion-header" id="heading-academics">
        <button class="accordion-button collapsed" type="button"
                data-bs-toggle="collapse"
                data-bs-target="#collapse-academics"
                aria-expanded="false"
                aria-controls="collapse-academics"
                data-tooltip="Academics">
            <i class="bi bi-book me-2"></i>
            <span>Academics</span>
        </button>
    </h2>
    <div id="collapse-academics" class="accordion-collapse collapse @(ViewHelper.IsActive(ViewContext, "ClassMaster") || 
                                                                   ViewHelper.IsActive(ViewContext, "SectionMaster") ||
                                                                   ViewHelper.IsActive(ViewContext, "SubjectMaster") ||
                                                                   ViewHelper.IsActive(ViewContext, "AcademicYear") ? "show" : "")" 
         aria-labelledby="heading-academics" data-bs-parent="#sidebarAccordion">
        <div class="accordion-body p-0">
            <ul class="nav flex-column ms-1 mb-2">
                <li><a href="@Url.Action("Index", "ClassMaster")" 
                      class="nav-link @(ViewHelper.IsActive(ViewContext, "ClassMaster") ? "active" : "")">Classes</a></li>
                <li><a href="@Url.Action("Index", "SectionMaster")" 
                      class="nav-link @(ViewHelper.IsActive(ViewContext, "SectionMaster") ? "active" : "")">Sections</a></li>
                <li><a href="@Url.Action("Index", "SubjectMaster")" 
                      class="nav-link @(ViewHelper.IsActive(ViewContext, "SubjectMaster") ? "active" : "")">Subjects</a></li>
                <li><a href="@Url.Action("Index", "AcademicYear")" 
                      class="nav-link @(ViewHelper.IsActive(ViewContext, "AcademicYear") ? "active" : "")">Academic Years</a></li>
            </ul>
        </div>
    </div>
</div>

<!-- SETTINGS -->
<div class="accordion-item">
    <h2 class="accordion-header" id="heading-settings">
        <button class="accordion-button collapsed" type="button"
                data-bs-toggle="collapse"
                data-bs-target="#collapse-settings"
                aria-expanded="false"
                aria-controls="collapse-settings"
                data-tooltip="Settings">
            <i class="bi bi-gear me-2"></i>
            <span>Settings</span>
        </button>
    </h2>
    <div id="collapse-settings" class="accordion-collapse collapse @(ViewHelper.IsActive(ViewContext, "Account", "Profile") || 
                                                                  ViewHelper.IsActive(ViewContext, "Account", "ChangePassword") ? "show" : "")" 
         aria-labelledby="heading-settings" data-bs-parent="#sidebarAccordion">
        <div class="accordion-body p-0">
            <ul class="nav flex-column ms-1 mb-2">
                <li><a href="@Url.Action("Profile", "Account")" 
                      class="nav-link @(ViewHelper.IsActive(ViewContext, "Account", "Profile") ? "active" : "")">My Profile</a></li>
                <li><a href="@Url.Action("ChangePassword", "Account")" 
                      class="nav-link @(ViewHelper.IsActive(ViewContext, "Account", "ChangePassword") ? "active" : "")">Change Password</a></li>
                <li><a href="@Url.Action("Logout", "Account")" class="nav-link">Logout</a></li>
            </ul>
        </div>
    </div>
</div>