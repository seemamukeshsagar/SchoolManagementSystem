@using SchoolPortalApp.Helpers
@{
    Layout = "_BaseNavigationBar";
}

<ul class="nav nav-pills flex-column mb-2">
    <li class="nav-item">
        <a href="@Url.Action("Index", "Home")" 
           class="nav-link @(ViewHelper.IsActive(ViewContext, "Home") ? "active" : "")" 
           data-tooltip="Home">
            <i class="bi bi-house-door"></i>
            <span>Home</span>
        </a>
    </li>
</ul>

<!-- DASHBOARD -->
<div class="accordion-item">
    <h2 class="accordion-header" id="heading-dashboard">
        <button class="accordion-button collapsed" type="button"
                data-bs-toggle="collapse"
                data-bs-target="#collapse-dashboard"
                aria-expanded="true"
                aria-controls="collapse-dashboard"
                data-tooltip="Dashboard">
            <i class="bi bi-speedometer2 me-2"></i>
            <span>Dashboard</span>
        </button>
    </h2>
    <div id="collapse-dashboard" class="accordion-collapse collapse @(ViewHelper.IsActive(ViewContext, "Teacher", "Dashboard") || 
                                                                  ViewHelper.IsActive(ViewContext, "Teacher", "Schedule") ||
                                                                  ViewHelper.IsActive(ViewContext, "Teacher", "Classes") ? "show" : "")" 
         aria-labelledby="heading-dashboard" data-bs-parent="#sidebarAccordion">
        <div class="accordion-body p-0">
            <ul class="nav flex-column ms-1 mb-2">
                <li><a href="@Url.Action("Dashboard", "Teacher")" 
                      class="nav-link @(ViewHelper.IsActive(ViewContext, "Teacher", "Dashboard") ? "active" : "")">Overview</a></li>
                <li><a href="@Url.Action("Schedule", "Teacher")" 
                      class="nav-link @(ViewHelper.IsActive(ViewContext, "Teacher", "Schedule") ? "active" : "")">My Schedule</a></li>
                <li><a href="@Url.Action("Classes", "Teacher")" 
                      class="nav-link @(ViewHelper.IsActive(ViewContext, "Teacher", "Classes") ? "active" : "")">My Classes</a></li>
            </ul>
        </div>
    </div>
</div>

<!-- ATTENDANCE -->
<div class="accordion-item">
    <h2 class="accordion-header" id="heading-attendance">
        <button class="accordion-button collapsed" type="button"
                data-bs-toggle="collapse"
                data-bs-target="#collapse-attendance"
                aria-expanded="false"
                aria-controls="collapse-attendance"
                data-tooltip="Attendance">
            <i class="bi bi-calendar-check me-2"></i>
            <span>Attendance</span>
        </button>
    </h2>
    <div id="collapse-attendance" class="accordion-collapse collapse @(ViewHelper.IsActive(ViewContext, "Attendance", "StudentAttendance") || 
                                                                   ViewHelper.IsActive(ViewContext, "Attendance", "ClassAttendance") ||
                                                                   ViewHelper.IsActive(ViewContext, "Attendance", "MyAttendance") ? "show" : "")" 
         aria-labelledby="heading-attendance" data-bs-parent="#sidebarAccordion">
        <div class="accordion-body p-0">
            <ul class="nav flex-column ms-1 mb-2">
                <li><a href="@Url.Action("StudentAttendance", "Attendance")" 
                      class="nav-link @(ViewHelper.IsActive(ViewContext, "Attendance", "StudentAttendance") ? "active" : "")">Mark Attendance</a></li>
                <li><a href="@Url.Action("ClassAttendance", "Attendance")" 
                      class="nav-link @(ViewHelper.IsActive(ViewContext, "Attendance", "ClassAttendance") ? "active" : "")">Class Attendance</a></li>
                <li><a href="@Url.Action("MyAttendance", "Attendance")" 
                      class="nav-link @(ViewHelper.IsActive(ViewContext, "Attendance", "MyAttendance") ? "active" : "")">My Attendance</a></li>
            </ul>
        </div>
    </div>
</div>

<!-- GRADES -->
<div class="accordion-item">
    <h2 class="accordion-header" id="heading-grades">
        <button class="accordion-button collapsed" type="button"
                data-bs-toggle="collapse"
                data-bs-target="#collapse-grades"
                aria-expanded="false"
                aria-controls="collapse-grades"
                data-tooltip="Grades">
            <i class="bi bi-journal-text me-2"></i>
            <span>Grades</span>
        </button>
    </h2>
    <div id="collapse-grades" class="accordion-collapse collapse @(ViewHelper.IsActive(ViewContext, "Grade", "EnterGrades") || 
                                                               ViewHelper.IsActive(ViewContext, "Grade", "ViewGrades") ||
                                                               ViewHelper.IsActive(ViewContext, "Grade", "Gradebook") ? "show" : "")" 
         aria-labelledby="heading-grades" data-bs-parent="#sidebarAccordion">
        <div class="accordion-body p-0">
            <ul class="nav flex-column ms-1 mb-2">
                <li><a href="@Url.Action("EnterGrades", "Grade")" 
                      class="nav-link @(ViewHelper.IsActive(ViewContext, "Grade", "EnterGrades") ? "active" : "")">Enter Grades</a></li>
                <li><a href="@Url.Action("ViewGrades", "Grade")" 
                      class="nav-link @(ViewHelper.IsActive(ViewContext, "Grade", "ViewGrades") ? "active" : "")">View Grades</a></li>
                <li><a href="@Url.Action("Gradebook", "Grade")" 
                      class="nav-link @(ViewHelper.IsActive(ViewContext, "Grade", "Gradebook") ? "active" : "")">Gradebook</a></li>
            </ul>
        </div>
    </div>
</div>

<!-- ASSIGNMENTS -->
<div class="accordion-item">
    <h2 class="accordion-header" id="heading-assignments">
        <button class="accordion-button collapsed" type="button"
                data-bs-toggle="collapse"
                data-bs-target="#collapse-assignments"
                aria-expanded="false"
                aria-controls="collapse-assignments"
                data-tooltip="Assignments">
            <i class="bi bi-journal-plus me-2"></i>
            <span>Assignments</span>
        </button>
    </h2>
    <div id="collapse-assignments" class="accordion-collapse collapse @(ViewHelper.IsActive(ViewContext, "Assignment", "Create") || 
                                                                    ViewHelper.IsActive(ViewContext, "Assignment", "ViewAll") ||
                                                                    ViewHelper.IsActive(ViewContext, "Assignment", "Grade") ? "show" : "")" 
         aria-labelledby="heading-assignments" data-bs-parent="#sidebarAccordion">
        <div class="accordion-body p-0">
            <ul class="nav flex-column ms-1 mb-2">
                <li><a href="@Url.Action("Create", "Assignment")" 
                      class="nav-link @(ViewHelper.IsActive(ViewContext, "Assignment", "Create") ? "active" : "")">Create Assignment</a></li>
                <li><a href="@Url.Action("ViewAll", "Assignment")" 
                      class="nav-link @(ViewHelper.IsActive(ViewContext, "Assignment", "ViewAll") ? "active" : "")">View Assignments</a></li>
                <li><a href="@Url.Action("Grade", "Assignment")" 
                      class="nav-link @(ViewHelper.IsActive(ViewContext, "Assignment", "Grade") ? "active" : "")">Grade Assignments</a></li>
            </ul>
        </div>
    </div>
</div>

<!-- SETTINGS -->
<div class="accordion-item">
    <h2 class="accordion-header" id="heading-settings">
        <button class="accordion-button collapsed" type="button"
                data-bs-toggle="collapse"
                data-bs-target="#collapse-settings"
                aria-expanded="false"
                aria-controls="collapse-settings"
                data-tooltip="Settings">
            <i class="bi bi-gear me-2"></i>
            <span>Settings</span>
        </button>
    </h2>
    <div id="collapse-settings" class="accordion-collapse collapse @(ViewHelper.IsActive(ViewContext, "Account", "Profile") || 
                                                                  ViewHelper.IsActive(ViewContext, "Account", "ChangePassword") ? "show" : "")" 
         aria-labelledby="heading-settings" data-bs-parent="#sidebarAccordion">
        <div class="accordion-body p-0">
            <ul class="nav flex-column ms-1 mb-2">
                <li><a href="@Url.Action("Profile", "Account")" 
                      class="nav-link @(ViewHelper.IsActive(ViewContext, "Account", "Profile") ? "active" : "")">My Profile</a></li>
                <li><a href="@Url.Action("ChangePassword", "Account")" 
                      class="nav-link @(ViewHelper.IsActive(ViewContext, "Account", "ChangePassword") ? "active" : "")">Change Password</a></li>
                <li><a href="@Url.Action("Logout", "Account")" class="nav-link">Logout</a></li>
            </ul>
        </div>
    </div>
</div>