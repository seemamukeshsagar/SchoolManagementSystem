                      class="nav-link @(ViewHelper.IsActive(ViewContext, "Accounts", "EmployeeSalaries") ? "active" : "")">Employee Salaries</a></li>
                <li><a href="@Url.Action("ProcessPayroll", "Accounts")" 
                      class="nav-link @(ViewHelper.IsActive(ViewContext, "Accounts", "ProcessPayroll") ? "active" : "")">Process Payroll</a></li>
                <li><a href="@Url.Action("Payslips", "Accounts")" 
                      class="nav-link @(ViewHelper.IsActive(ViewContext, "Accounts", "Payslips") ? "active" : "")">Payslips</a></li>
