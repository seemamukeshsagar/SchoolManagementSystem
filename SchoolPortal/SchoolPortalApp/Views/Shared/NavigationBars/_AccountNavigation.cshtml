                data-bs-target="#collapse-profile"
                aria-expanded="false"
                aria-controls="collapse-profile"
                data-tooltip="My Profile">
            <i class="bi bi-person-circle me-2"></i>
            <span>My Profile</span>
        </button>
    </h2>
    <div id="collapse-profile" class="accordion-collapse collapse @(ViewHelper.IsActive(ViewContext, "Account", "Profile") || 
                                                                  ViewHelper.IsActive(ViewContext, "Account", "EditProfile") ||
                                                                  ViewHelper.IsActive(ViewContext, "Account", "ChangePassword") ||
                                                                  ViewHelper.IsActive(ViewContext, "Account", "NotificationSettings") ? "show" : "")" 
         aria-labelledby="heading-profile" data-bs-parent="#sidebarAccordion">
        <div class="accordion-body p-0">
            <ul class="nav flex-column ms-1 mb-2">
                <li><a href="@Url.Action("Profile", "Account")" 
                      class="nav-link @(ViewHelper.IsActive(ViewContext, "Account", "Profile") ? "active" : "")">View Profile</a></li>
                <li><a href="@Url.Action("EditProfile", "Account")" 
                      class="nav-link @(ViewHelper.IsActive(ViewContext, "Account", "EditProfile") ? "active" : "")">Edit Profile</a></li>
                <li><a href="@Url.Action("ChangePassword", "Account")" 
                      class="nav-link @(ViewHelper.IsActive(ViewContext, "Account", "ChangePassword") ? "active" : "")">Change Password</a></li>
                <li><a href="@Url.Action("NotificationSettings", "Account")" 
                      class="nav-link @(ViewHelper.IsActive(ViewContext, "Account", "NotificationSettings") ? "active" : "")">Notification Settings</a></li>
                <li><a href="@Url.Action("Logout", "Account")" class="nav-link">Logout</a></li>
            </ul>
        </div>
    </div>
</div>