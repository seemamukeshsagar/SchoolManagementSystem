@using SchoolPortalApp.Helpers
@{
    Layout = "_BaseNavigationBar";
}

<ul class="nav nav-pills flex-column mb-2">
    <li class="nav-item">
        <a href="@Url.Action("Index", "Home")" 
           class="nav-link @(ViewHelper.IsActive(ViewContext, "Home") ? "active" : "")" 
           data-tooltip="Home">
            <i class="bi bi-house-door"></i>
            <span>Home</span>
        </a>
    </li>
</ul>

<!-- DASHBOARD -->
<div class="accordion-item">
    <h2 class="accordion-header" id="heading-dashboard">
        <button class="accordion-button collapsed" type="button"
                data-bs-toggle="collapse"
                data-bs-target="#collapse-dashboard"
                aria-expanded="true"
                aria-controls="collapse-dashboard"
                data-tooltip="Dashboard">
            <i class="bi bi-speedometer2 me-2"></i>
            <span>Dashboard</span>
        </button>
    </h2>
    <div id="collapse-dashboard" class="accordion-collapse collapse @(ViewHelper.IsActive(ViewContext, "Accounts", "Dashboard") ? "show" : "")" 
         aria-labelledby="heading-dashboard" data-bs-parent="#sidebarAccordion">
        <div class="accordion-body p-0">
            <ul class="nav flex-column ms-1 mb-2">
                <li><a href="@Url.Action("Dashboard", "Accounts")" 
                      class="nav-link @(ViewHelper.IsActive(ViewContext, "Accounts", "Dashboard") ? "active" : "")">Overview</a></li>
                <li><a href="@Url.Action("RecentTransactions", "Accounts")" 
                      class="nav-link @(ViewHelper.IsActive(ViewContext, "Accounts", "RecentTransactions") ? "active" : "")">Recent Transactions</a></li>
                <li><a href="@Url.Action("FinancialSummary", "Accounts")" 
                      class="nav-link @(ViewHelper.IsActive(ViewContext, "Accounts", "FinancialSummary") ? "active" : "")">Financial Summary</a></li>
            </ul>
        </div>
    </div>
</div>

<!-- FEE MANAGEMENT -->
<div class="accordion-item">
    <h2 class="accordion-header" id="heading-fee-management">
        <button class="accordion-button collapsed" type="button"
                data-bs-toggle="collapse"
                data-bs-target="#collapse-fee-management"
                aria-expanded="false"
                aria-controls="collapse-fee-management"
                data-tooltip="Fee Management">
            <i class="bi bi-cash-coin me-2"></i>
            <span>Fee Management</span>
        </button>
    </h2>
    <div id="collapse-fee-management" class="accordion-collapse collapse @(ViewHelper.IsActive(ViewContext, "Accounts", "FeeStructure") || 
                                                                         ViewHelper.IsActive(ViewContext, "Accounts", "FeeCategories") ||
                                                                         ViewHelper.IsActive(ViewContext, "Accounts", "FeeDiscounts") ||
                                                                         ViewHelper.IsActive(ViewContext, "Accounts", "FeeConcessions") ? "show" : "")" 
         aria-labelledby="heading-fee-management" data-bs-parent="#sidebarAccordion">
        <div class="accordion-body p-0">
            <ul class="nav flex-column ms-1 mb-2">
                <li><a href="@Url.Action("FeeStructure", "Accounts")" 
                      class="nav-link @(ViewHelper.IsActive(ViewContext, "Accounts", "FeeStructure") ? "active" : "")">Fee Structure</a></li>
                <li><a href="@Url.Action("FeeCategories", "Accounts")" 
                      class="nav-link @(ViewHelper.IsActive(ViewContext, "Accounts", "FeeCategories") ? "active" : "")">Fee Categories</a></li>
                <li><a href="@Url.Action("FeeDiscounts", "Accounts")" 
                      class="nav-link @(ViewHelper.IsActive(ViewContext, "Accounts", "FeeDiscounts") ? "active" : "")">Fee Discounts</a></li>
                <li><a href="@Url.Action("FeeConcessions", "Accounts")" 
                      class="nav-link @(ViewHelper.IsActive(ViewContext, "Accounts", "FeeConcessions") ? "active" : "")">Fee Concessions</a></li>
            </ul>
        </div>
    </div>
</div>

<!-- PAYMENT PROCESSING -->
<div class="accordion-item">
    <h2 class="accordion-header" id="heading-payment">
        <button class="accordion-button collapsed" type="button"
                data-bs-toggle="collapse"
                data-bs-target="#collapse-payment"
                aria-expanded="false"
                aria-controls="collapse-payment"
                data-tooltip="Payment Processing">
            <i class="bi bi-credit-card me-2"></i>
            <span>Payment Processing</span>
        </button>
    </h2>
    <div id="collapse-payment" class="accordion-collapse collapse @(ViewHelper.IsActive(ViewContext, "Accounts", "ReceivePayment") || 
                                                                  ViewHelper.IsActive(ViewContext, "Accounts", "PaymentHistory") ||
                                                                  ViewHelper.IsActive(ViewContext, "Accounts", "OnlinePayments") ? "show" : "")" 
         aria-labelledby="heading-payment" data-bs-parent="#sidebarAccordion">
        <div class="accordion-body p-0">
            <ul class="nav flex-column ms-1 mb-2">
                <li><a href="@Url.Action("ReceivePayment", "Accounts")" 
                      class="nav-link @(ViewHelper.IsActive(ViewContext, "Accounts", "ReceivePayment") ? "active" : "")">Receive Payment</a></li>
                <li><a href="@Url.Action("PaymentHistory", "Accounts")" 
                      class="nav-link @(ViewHelper.IsActive(ViewContext, "Accounts", "PaymentHistory") ? "active" : "")">Payment History</a></li>
                <li><a href="@Url.Action("OnlinePayments", "Accounts")" 
                      class="nav-link @(ViewHelper.IsActive(ViewContext, "Accounts", "OnlinePayments") ? "active" : "")">Online Payments</a></li>
            </ul>
        </div>
    </div>
</div>

