                <li><a href="@Url.Action("JournalEntries", "Accounts")" 
                      class="nav-link @(ViewHelper.IsActive(ViewContext, "Accounts", "JournalEntries") ? "active" : "")">Journal Entries</a></li>
                <li><a href="@Url.Action("Ledger", "Accounts")" 
