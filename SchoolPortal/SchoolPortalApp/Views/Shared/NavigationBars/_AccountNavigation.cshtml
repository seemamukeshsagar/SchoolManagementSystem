                data-tooltip="Financial Reports">
            <i class="bi bi-file-earmark-text me-2"></i>
            <span>Financial Reports</span>
        </button>
    </h2>
    <div id="collapse-reports" class="accordion-collapse collapse @(ViewHelper.IsActive(ViewContext, "Accounts", "IncomeStatement") || 
