                data-tooltip="Expense Management">
            <i class="bi bi-wallet2 me-2"></i>
            <span>Expense Management</span>
        </button>
    </h2>
    <div id="collapse-expenses" class="accordion-collapse collapse @(ViewHelper.IsActive(ViewContext, "Accounts", "ExpenseCategories") || 
                                                                  ViewHelper.IsActive(ViewContext, "Accounts", "RecordExpense") ||
                                                                  ViewHelper.IsActive(ViewContext, "Accounts", "ExpenseReports") ? "show" : "")" 
         aria-labelledby="heading-expenses" data-bs-parent="#sidebarAccordion">
        <div class="accordion-body p-0">
            <ul class="nav flex-column ms-1 mb-2">
                <li><a href="@Url.Action("ExpenseCategories", "Accounts")" 
                      class="nav-link @(ViewHelper.IsActive(ViewContext, "Accounts", "ExpenseCategories") ? "active" : "")">Expense Categories</a></li>
                <li><a href="@Url.Action("RecordExpense", "Accounts")" 
                      class="nav-link @(ViewHelper.IsActive(ViewContext, "Accounts", "RecordExpense") ? "active" : "")">Record Expense</a></li>
                <li><a href="@Url.Action("ExpenseReports", "Accounts")" 
                      class="nav-link @(ViewHelper.IsActive(ViewContext, "Accounts", "ExpenseReports") ? "active" : "")">Expense Reports</a></li>
            </ul>
        </div>
    </div>
</div>

<!-- FINANCIAL REPORTS -->
