                                                                  ViewHelper.IsActive(ViewContext, "Accounts", "CashFlow") ? "show" : "")" 
         aria-labelledby="heading-reports" data-bs-parent="#sidebarAccordion">
        <div class="accordion-body p-0">
            <ul class="nav flex-column ms-1 mb-2">
                <li><a href="@Url.Action("IncomeStatement", "Accounts")" 
                      class="nav-link @(ViewHelper.IsActive(ViewContext, "Accounts", "IncomeStatement") ? "active" : "")">Income Statement</a></li>
                <li><a href="@Url.Action("BalanceSheet", "Accounts")" 
                      class="nav-link @(ViewHelper.IsActive(ViewContext, "Accounts", "BalanceSheet") ? "active" : "")">Balance Sheet</a></li>
                <li><a href="@Url.Action("CashFlow", "Accounts")" 
                      class="nav-link @(ViewHelper.IsActive(ViewContext, "Accounts", "CashFlow") ? "active" : "")">Cash Flow</a></li>
            </ul>
        </div>
