@using Microsoft.AspNetCore.Http;
@inject IHttpContextAccessor Accessor;

<link rel="stylesheet" href="~/css/navigationbar.css" />
<!-- <script src="~/js/navigationbar.js"> </script> -->

@{
    // Get current controller and action
    var controller = ViewContext.RouteData.Values["Controller"]?.ToString();
    var action = ViewContext.RouteData.Values["Action"]?.ToString();

    // Get user's privileges from session
    var lstPrivileges = Context.Session.GetString("Privileges")?.Split(',').ToList() ?? new List<string>();

    // Helper function to check active menu item
    bool IsActive(string controllerName, string actionName = null)
    {
        return string.Equals(controller, controllerName, StringComparison.OrdinalIgnoreCase) &&
               (actionName == null || string.Equals(action, actionName, StringComparison.OrdinalIgnoreCase));
    }
}

<div class="d-flex flex-column">
    <div class="accordion" id="sidebarAccordion">

        <ul class="nav nav-pills flex-column mb-2">
            @if (lstPrivileges.Contains("View Home"))
            {
                <li class="nav-item">
                    <a href="@Url.Action("Index", "Home")" class="nav-link @(IsActive("Home") ? "active" : "")">
                        <i class="bi bi-house-door me-2"></i>
                        <span>Dashboard</span>
                    </a>
                </li>
            }
        </ul>

        <!-- ADMINISTRATION -->
        <div class="accordion-item">
            <h2 class="accordion-header" id="heading-admin">
                <button class="accordion-button collapsed" type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#collapse-admin"
                        aria-expanded="false"
                        aria-controls="collapse-admin"
                        data-tooltip="Administration">
                    <i class="bi bi-gear me-2"></i>
                    <span>Administration</span>
                </button>
            </h2>
            <div id="collapse-admin"
                 class="accordion-collapse collapse @(new[] { "UserMaster", "RoleMaster", "DesigMaster", "Emp", "EmpTypeMaster", "Privileges", "RolePrivileges", "SystemParameters", "TaskSchedules", "HolidayMaster" }.Any(c => IsActive(c)) ? "show" : "")"
                 aria-labelledby="heading-admin"
                 data-bs-parent="#sidebarAccordion">
                <div class="accordion-body p-0">
                    <ul class="nav flex-column ms-1 mb-2">
                        <!-- General -->
                        <li class="nav-item text-uppercase small px-3 pt-2" style="background-color: wheat;">
                            General
                        </li>
                        @if (lstPrivileges.Contains("Manage Users"))
                        {
                            <li><a href="@Url.Action("Index", "UserMaster")" class="nav-link @(IsActive("UserMaster") ? "active" : "")">Users</a></li>
                        }
                        @if (lstPrivileges.Contains("Manage Roles"))
                        {
                            <li><a href="@Url.Action("Index", "RoleMaster")" class="nav-link @(IsActive("RoleMaster") ? "active" : "")">Roles</a></li>
                        }
                        @if (lstPrivileges.Contains("Manage Designations"))
                        {
                            <li><a href="@Url.Action("Index", "DesigMaster")" class="nav-link @(IsActive("DesigMaster") ? "active" : "")">Designations</a></li>
                        }
                        @if (lstPrivileges.Contains("Manage Employees"))
                        {
                            <li><a href="@Url.Action("Index", "Emp")" class="nav-link @(IsActive("Emp") ? "active" : "")">Employees</a></li>
                        }
                        @if (lstPrivileges.Contains("Manage Employee Type Master"))
                        {
                            <li><a href="@Url.Action("Index", "EmpTypeMaster")" class="nav-link @(IsActive("EmpTypeMaster") ? "active" : "")">Employee Type Master</a></li>
                        }
                        @if (lstPrivileges.Contains("Manage Privileges"))
                        {
                            <li><a href="@Url.Action("Index", "Privileges")" class="nav-link @(IsActive("Privileges") ? "active" : "")">Privileges</a></li>
                        }
                        @if (lstPrivileges.Contains("Manage Role Privileges"))
                        {
                            <li><a href="@Url.Action("Index", "RolePrivileges")" class="nav-link @(IsActive("RolePrivileges") ? "active" : "")">Role Privileges</a></li>
                        }
                        @if (lstPrivileges.Contains("Manage System Parameters"))
                        {
                            <li><a href="@Url.Action("Index", "SystemParameters")" class="nav-link @(IsActive("SystemParameters") ? "active" : "")">System Parameters</a></li>
                        }
                        @if (lstPrivileges.Contains("Manage Schedules"))
                        {
                            <li><a href="@Url.Action("Index", "TaskSchedules")" class="nav-link @(IsActive("TaskSchedules") ? "active" : "")">Schedules</a></li>
                        }
                        @if (lstPrivileges.Contains("Manage Holiday"))
                        {
                            <li><a href="@Url.Action("Index", "HolidayMaster")" class="nav-link @(IsActive("HolidayMaster") ? "active" : "")">Holiday</a></li>
                        }

                        <!-- Masters -->
                        <li class="nav-item text-uppercase small px-3 pt-2" style="background-color: wheat;">
                            Masters
                        </li>
                        <li><a href="@Url.Action("Index", "CategoryMaster")" class="nav-link @(IsActive("CategoryMaster") ? "active" : "")">Categories</a></li>
                        <li><a href="@Url.Action("Index", "Class", new { area = "" })" class="nav-link @(IsActive("Class") ? "active" : "")">Classes</a></li>
                        <li><a href="@Url.Action("Index", "Section")" class="nav-link @(IsActive("Section") ? "active" : "")">Sections</a></li>
                        <li><a href="@Url.Action("Index", "ClassRoom")" class="nav-link @(IsActive("ClassRoom") ? "active" : "")">Class Rooms</a></li>
                        <li><a href="@Url.Action("Index", "Subject")" class="nav-link @(IsActive("Subject") ? "active" : "")">Subjects</a></li>
                        <li><a href="@Url.Action("Index", "TeacherSectionDetails")" class="nav-link @(IsActive("TeacherSectionDetails") ? "active" : "")">Class-Teacher</a></li>
                        <li><a href="@Url.Action("Index", "ProfessionMaster")" class="nav-link @(IsActive("ProfessionMaster") ? "active" : "")">Professions</a></li>
                        <li><a href="@Url.Action("Index", "QualificationMaster")" class="nav-link @(IsActive("QualificationMaster") ? "active" : "")">Qualifications</a></li>
                    </ul>
                </div>
            </div>
        </div>

        <!-- ACADEMICS -->
        <div class="accordion-item">
            <h2 class="accordion-header" id="heading-academics">
                <button class="accordion-button collapsed" type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#collapse-academics"
                        aria-expanded="false"
                        aria-controls="collapse-academics"
                        data-tooltip="Academics">
                    <i class="bi bi-book me-2"></i>
                    <span>Academics</span>
                </button>
            </h2>
            <div id="collapse-academics"
                 class="accordion-collapse collapse @(new[] { "Student", "Attendance", "Exam", "Timetable", "Homework", "Library" }.Any(c => IsActive(c)) ? "show" : "")"
                 aria-labelledby="heading-academics"
                 data-bs-parent="#sidebarAccordion">
                <div class="accordion-body p-0">
                    <ul class="nav flex-column ms-1 mb-2">
                        <li class="nav-item text-uppercase small px-3 pt-2" style="background-color: wheat;">
                            Students
                        </li>
                        <li><a href="@Url.Action("Index", "Student")" class="nav-link @(IsActive("Student") ? "active" : "")">Students</a></li>
                        <li><a href="@Url.Action("Index", "Attendance")" class="nav-link @(IsActive("Attendance") ? "active" : "")">Attendance</a></li>
                        
                        <li class="nav-item text-uppercase small px-3 pt-2" style="background-color: wheat;">
                            Academics
                        </li>
                        <li><a href="@Url.Action("Index", "Exam")" class="nav-link @(IsActive("Exam") ? "active" : "")">Exams</a></li>
                        <li><a href="@Url.Action("Index", "Timetable")" class="nav-link @(IsActive("Timetable") ? "active" : "")">Timetable</a></li>
                        <li><a href="@Url.Action("Index", "Homework")" class="nav-link @(IsActive("Homework") ? "active" : "")">Homework</a></li>
                        <li><a href="@Url.Action("Index", "Library")" class="nav-link @(IsActive("Library") ? "active" : "")">Library</a></li>
                    </ul>
                </div>
            </div>
        </div>

        <!-- FINANCE -->
        <div class="accordion-item">
            <h2 class="accordion-header" id="heading-finance">
                <button class="accordion-button collapsed" type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#collapse-finance"
                        aria-expanded="false"
                        aria-controls="collapse-finance"
                        data-tooltip="Finance">
                    <i class="bi bi-cash-coin me-2"></i>
                    <span>Finance</span>
                </button>
            </h2>
            <div id="collapse-finance"
                 class="accordion-collapse collapse @(new[] { "Fee", "Expense", "Invoice" }.Any(c => IsActive(c)) ? "show" : "")"
                 aria-labelledby="heading-finance"
                 data-bs-parent="#sidebarAccordion">
                <div class="accordion-body p-0">
                    <ul class="nav flex-column ms-1 mb-2">
                        <li><a href="@Url.Action("Index", "Fee")" class="nav-link @(IsActive("Fee") ? "active" : "")">Fees</a></li>
                        <li><a href="@Url.Action("Index", "Expense")" class="nav-link @(IsActive("Expense") ? "active" : "")">Expenses</a></li>
                        <li><a href="@Url.Action("Index", "Invoice")" class="nav-link @(IsActive("Invoice") ? "active" : "")">Invoices</a></li>
                    </ul>
                </div>
            </div>
        </div>

        <!-- OPERATIONS -->
        <div class="accordion-item">
            <h2 class="accordion-header" id="heading-operations">
                <button class="accordion-button collapsed" type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#collapse-operations"
                        aria-expanded="false"
                        aria-controls="collapse-operations"
                        data-tooltip="Operations">
                    <i class="bi bi-gear-wide-connected me-2"></i>
                    <span>Operations</span>
                </button>
            </h2>
            <div id="collapse-operations"
                 class="accordion-collapse collapse @(new[] { "Inventory", "Transport", "Hostel" }.Any(c => IsActive(c)) ? "show" : "")"
                 aria-labelledby="heading-operations"
                 data-bs-parent="#sidebarAccordion">
                <div class="accordion-body p-0">
                    <ul class="nav flex-column ms-1 mb-2">
                        <li><a href="@Url.Action("Index", "Inventory")" class="nav-link @(IsActive("Inventory") ? "active" : "")">Inventory</a></li>
                        <li><a href="@Url.Action("Index", "Transport")" class="nav-link @(IsActive("Transport") ? "active" : "")">Transport</a></li>
                        <li><a href="@Url.Action("Index", "Hostel")" class="nav-link @(IsActive("Hostel") ? "active" : "")">Hostel</a></li>
                    </ul>
                </div>
            </div>
        </div>

        <!-- REPORTS -->
        <div class="accordion-item">
            <h2 class="accordion-header" id="heading-reports">
                <button class="accordion-button collapsed" type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#collapse-reports"
                        aria-expanded="false"
                        aria-controls="collapse-reports"
                        data-tooltip="Reports">
                    <i class="bi bi-file-earmark-bar-graph me-2"></i>
                    <span>Reports</span>
                </button>
            </h2>
            <div id="collapse-reports"
                 class="accordion-collapse collapse @(IsActive("Report") ? "show" : "")"
                 aria-labelledby="heading-reports"
                 data-bs-parent="#sidebarAccordion">
                <div class="accordion-body p-0">
                    <ul class="nav flex-column ms-1 mb-2">
                        <li><a href="@Url.Action("Student", "Report")" class="nav-link @(IsActive("Report", "Student") ? "active" : "")">Student Reports</a></li>
                        <li><a href="@Url.Action("Attendance", "Report")" class="nav-link @(IsActive("Report", "Attendance") ? "active" : "")">Attendance Reports</a></li>
                        <li><a href="@Url.Action("Exam", "Report")" class="nav-link @(IsActive("Report", "Exam") ? "active" : "")">Exam Reports</a></li>
                        <li><a href="@Url.Action("Fee", "Report")" class="nav-link @(IsActive("Report", "Fee") ? "active" : "")">Fee Reports</a></li>
                    </ul>
                </div>
            </div>
        </div>

        <!-- SETTINGS -->
        <div class="accordion-item">
            <h2 class="accordion-header" id="heading-settings">
                <button class="accordion-button collapsed" type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#collapse-settings"
                        aria-expanded="false"
                        aria-controls="collapse-settings"
                        data-tooltip="Settings">
                    <i class="bi bi-gear me-2"></i>
                    <span>Settings</span>
                </button>
            </h2>
            <div id="collapse-settings"
                 class="accordion-collapse collapse @(IsActive("Settings") ? "show" : "")"
                 aria-labelledby="heading-settings"
                 data-bs-parent="#sidebarAccordion">
                <div class="accordion-body p-0">
                    <ul class="nav flex-column ms-1 mb-2">
                        <li><a href="@Url.Action("Profile", "Account")" class="nav-link @(IsActive("Account", "Profile") ? "active" : "")">My Profile</a></li>
                        <li><a href="@Url.Action("ChangePassword", "Account")" class="nav-link @(IsActive("Account", "ChangePassword") ? "active" : "")">Change Password</a></li>
                        <li><a href="@Url.Action("Logout", "Account")" class="nav-link">Logout</a></li>
                    </ul>
                </div>
            </div>
        </div>

    </div>
</div>

<!-- Bootstrap Icons -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
